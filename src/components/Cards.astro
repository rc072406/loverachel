---
---

<div class="cards-viewport">
  <div class="cards-container">
    <div class="card card-1">
      <div class="card-content">
        <div class="barcode-top">
          <div class="barcode-lines"></div>
          <div class="barcode-id">LR_ID_7729-06</div>
        </div>
        
        <div class="submission-copy">
          <p>
            Submissions for the magazine and front page are always welcomed. 
            We would love to hear your story and learn more about you. 
            The magazine scouts for editorials and stories that will define 
            the intersection of style and technical discipline.
          </p>

          <p>
            For submissions, please ensure files are optimized. If you do 
            not hear back within two cycles, we have decided to pass, 
            but you are always encouraged to resubmit.
          </p>

          <p class="brand-statement">
            love, Rachel is an indie fashion magazine that features girls 
            who change the game in STEM.
          </p>
        </div>

        <div class="vertical-status">Where are you?</div>
        
        <div class="pink-tag">
          <span class="tag-id">467-7513</span>
          <span class="tag-sub">ACTIVE_SCRIPTS</span>
        </div>

        <div class="database-content">
          <div class="barcode-divider"></div>
          <div class="name-grid">
            {Array.from({ length: 40 }).map(() => (
              <span>This could be you, </span>
            ))}
            <span class="highlight">Your Name Here, </span>
          </div>
        </div>

        <div class="stamp-stack">
          <div class="stamp"><div class="stamp-inner"><div class="strawberry-pixel"></div><div class="stamp-price">3¢</div></div></div>
        </div>
      </div>
    </div>

    <div class="card card-photo-reveal">
      <div class="photo-container">
        <div class="filler-bg"></div>
        <div class="belly-band">
          <div class="band-content">
            <div class="band-left">
              <p>love, Rachel</p>
              <p>Issue 01</p>
              <p>Technical Spec</p>
            </div>
            <div class="band-right">
              <p>NYC_UNIT_604</p>
              <p>EDITION OF 25</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".cards-viewport",
      start: "top top",
      end: "+=3000",
      scrub: 1,
      pin: true,
    }
  });

  tl.to(".card-photo-reveal", {
    xPercent: 110,
    rotate: 2,
    duration: 1.5,
    ease: "power2.inOut"
  })
  .to(".card-1", {
    scale: 1.02,
    duration: 1
  }, 0);

  gsap.to(".vertical-status", {
    opacity: 0.4,
    repeat: -1,
    yoyo: true,
    duration: 0.8,
    ease: "power1.inOut"
  });
</script>

<style>
  .cards-viewport {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    overflow: hidden;
  }

  .cards-container {
    position: relative;
    width: 500px;
    height: 700px;
    perspective: 2000px;
  }

  .card {
    position: absolute;
    inset: 0;
    background: #fdfdfd;
    box-shadow: 20px 20px 60px rgba(0,0,0,0.5);
    display: flex;
    border-radius: 2px;
  }

  .card-content {
    flex-grow: 1;
    padding: 40px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .submission-copy {
    font-family: var(--fira, monospace);
    font-size: 11px;
    line-height: 1.5;
    color: #333;
    max-width: 85%;
    margin-top: 20px;
    text-transform: uppercase;
  }

  .submission-copy p {
    margin-bottom: 15px;
  }

  .brand-statement {
    color: #000;
    font-weight: 900;
    border-left: 2px solid var(--accent, #ff0033);
    padding-left: 10px;
  }

  .barcode-top {
    margin-bottom: 10px;
  }

  .barcode-lines {
    width: 140px;
    height: 25px;
    background: repeating-linear-gradient(90deg, #000 0px, #000 1px, transparent 1px, transparent 3px, #000 3px, #000 6px, transparent 6px, transparent 7px, #000 7px, #000 8px);
    background-size: 25px 100%;
  }

  .barcode-id {
    font-family: var(--fira, monospace);
    font-size: 8px;
    letter-spacing: 3px;
    margin-top: 5px;
  }

  .vertical-status {
    position: absolute;
    bottom: 40px;
    right: -60px;
    transform: rotate(-90deg);
    font-family: var(--fira, monospace);
    font-weight: 900;
    color: var(--accent, #ff0033);
    font-size: 3rem;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: -2px;
    opacity: 0.8;
  }

  .pink-tag {
    position: absolute;
    top: 40px;
    right: 30px;
    width: 80px;
    height: 60px;
    background: #ff85a1;
    padding: 10px;
    transform: rotate(5deg);
    font-family: var(--fira, monospace);
    font-size: 8px;
    box-shadow: 2px 2px 0px rgba(0,0,0,0.1);
    z-index: 10;
  }

  .tag-id { display: block; font-weight: 900; font-size: 12px; }

  .database-content {
    margin-top: auto;
    width: 60%;
  }

  .barcode-divider {
    width: 100%;
    height: 8px;
    background: repeating-linear-gradient(90deg, #000 0px, #000 1px, transparent 1px, transparent 2px, #000 2px, #000 3px, transparent 3px, transparent 8px);
    margin-bottom: 10px;
  }

  .name-grid {
    font-family: var(--fira, monospace);
    font-size: 8px;
    column-count: 2;
    text-transform: uppercase;
    line-height: 1.2;
    color: #666;
  }

  .highlight { color: #000; font-weight: 900; background: #ffff00; }

  .stamp-stack {
    position: absolute;
    bottom: 30px;
    right: 30px;
  }

  .stamp {
    width: 45px;
    height: 55px;
    background: #fff;
    padding: 3px;
    filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.2));
    mask-image: radial-gradient(circle at 4px 4px, transparent 3.5px, black 3.5px);
    mask-size: 8px 8px;
  }

  .stamp-inner {
    border: 1px solid #eee;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .strawberry-pixel {
    width: 15px;
    height: 18px;
    background: var(--accent, #ff0033);
    border-radius: 50% 50% 40% 40%;
  }

  .stamp-price {
    position: absolute;
    top: 2px;
    right: 2px;
    font-size: 9px;
    font-family: serif;
    font-weight: bold;
  }

  .photo-container {
    flex-grow: 1;
    position: relative;
    background: #000;
    overflow: hidden;
  }

  .filler-bg {
    width: 100%;
    height: 100%;
    background-color: #111;
    background-image: radial-gradient(circle at center, #222 0%, #000 100%);
  }

  .belly-band {
    position: absolute;
    top: 55%;
    left: 0;
    width: 100%;
    height: 140px;
    background: rgba(160, 160, 160, 0.9);
    backdrop-filter: blur(8px);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    padding: 0 25px;
    color: #111;
    z-index: 30;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .band-content {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--fira, monospace);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .band-left p, .band-right p {
    margin: 2px 0;
  }

  .card-photo-reveal {
    z-index: 50;
  }
</style>
