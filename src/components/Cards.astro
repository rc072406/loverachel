<div class="cards-viewport">
  <div class="cards-container">
    <div class="card card-info">
      <div class="card-content">
        <div class="barcode-top">
          <div class="barcode-lines"></div>
          <div class="barcode-id">LR_ID_7729-06</div>
        </div>
        
        <div class="submission-copy">
          <p>
            Submissions for the magazine and front page are always welcomed. 
            We would love to hear your story and learn more about you. 
            The magazine scouts for editorials and stories that will define 
            the intersection of style and technical discipline.
          </p>

          <p>
            For submissions, please ensure files are optimized. If you do 
            not hear back within two cycles, we have decided to pass, 
            but you are always encouraged to resubmit.
          </p>

          <p class="brand-statement">
            love, Rachel is an indie fashion magazine that features girls 
            who change the game in STEM.
          </p>
        </div>

        <div class="database-content">
          <div class="barcode-divider"></div>
          <div class="name-grid">
            {Array.from({ length: 30 }).map(() => (
              <span>This could be you, </span>
            ))}
            <span class="highlight">Your Name Here, </span>
          </div>
        </div>

        <div class="stamp-stack">
          <div class="stamp"><div class="stamp-inner"><div class="strawberry-pixel"></div><div class="stamp-price">3¢</div></div></div>
        </div>
      </div>
    </div>

    <div class="card card-photo card-photo-middle">
      <div class="photo-frame">
        <div class="photo-container">
          <div class="filler-bg alt-bg"></div>
          <div class="belly-band">
            <div class="band-content">
              <div class="band-left">
                <p>Bella Newman</p>
                <p>SS25 Show Package</p>
              </div>
              <div class="band-right">
                <p>GN01-15SS2025</p>
                <p>EDITION OF 25</p>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-status">Where are you?</div>
      </div>
    </div>

    <div class="card card-photo card-photo-top">
      <div class="photo-frame">
        <div class="photo-container">
          <div class="filler-bg"></div>
          <div class="belly-band">
            <div class="band-content">
              <div class="band-left">
                <p>love, Rachel</p>
                <p>Issue 01</p>
                <p>Technical Spec</p>
              </div>
              <div class="band-right">
                <p>NYC_UNIT_604</p>
                <p>EDITION OF 25</p>
              </div>
            </div>
          </div>
        </div>
        <div class="vertical-status">Where are you?</div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".cards-viewport",
      start: "top top",
      end: "+=4000",
      scrub: 1,
      pin: true,
    }
  });

  // Top photo slides out right
  tl.to(".card-photo-top", {
    xPercent: 115,
    rotate: 4,
    duration: 1.5,
    ease: "power2.inOut"
  })
  // Middle photo slides out left
  .to(".card-photo-middle", {
    xPercent: -115,
    rotate: -4,
    duration: 1.5,
    ease: "power2.inOut"
  }, "-=1")
  // Reveal scaling for the info card
  .to(".card-info", {
    scale: 1.08,
    duration: 1
  }, "-=0.5");

  
  gsap.to(".vertical-status", {
    color: "#000",
    duration: 2.5,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut"
  });
</script>

<style>
  .cards-viewport {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    overflow: hidden;
  }

  .cards-container {
    position: relative;
    width: 500px;
    height: 700px;
    perspective: 2000px;
  }

  .card {
    position: absolute;
    inset: 0;
    background: #fdfdfd;
    box-shadow: 20px 20px 60px rgba(0,0,0,0.5);
    border-radius: 2px;
  }

  /* --- PHOTO CARDS --- */
  .card-photo {
    padding: 25px;
  }

  .card-photo-top { z-index: 60; }
  .card-photo-middle { z-index: 55; }
  .card-info { z-index: 50; }

  .photo-frame {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .photo-container {
    flex-grow: 1;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  .filler-bg {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #1a1a1a 0%, #000 100%);
  }

  .alt-bg {
    background: radial-gradient(circle at center, #222 0%, #080808 100%);
  }

  .vertical-status {
    position: absolute;
    top: 50%;
    right: -20px;
    transform: translateY(-50%) rotate(90deg);
    font-family: var(--fira, monospace);
    font-weight: 300;
    font-size: 0.7rem;
    letter-spacing: 7px;
    text-transform: uppercase;
    color: var(--accent, #ff0033);
    white-space: nowrap;
    z-index: 70;
  }

  .belly-band {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 140px;
    background: rgba(200, 200, 200, 0.85);
    backdrop-filter: blur(12px);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    padding: 0 25px;
    color: #000;
    z-index: 30;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .band-content {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--fira, monospace);
    font-size: 9px;
    text-transform: uppercase;
  }

  /* --- INFO CARD --- */
  .card-content {
    padding: 40px;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .submission-copy {
    font-family: var(--fira, monospace);
    font-size: 11px;
    line-height: 1.6;
    color: #333;
    max-width: 90%;
    margin-top: 30px;
    text-transform: uppercase;
  }

  .submission-copy p { margin-bottom: 20px; }

  .brand-statement {
    color: #000;
    font-weight: 900;
    border-left: 3px solid var(--accent, #ff0033);
    padding-left: 15px;
  }

  .barcode-top { margin-bottom: 15px; }

  .barcode-lines {
    width: 140px;
    height: 25px;
    background: repeating-linear-gradient(90deg, #000 0px, #000 1px, transparent 1px, transparent 3px, #000 3px, #000 6px, transparent 6px, transparent 7px, #000 7px, #000 8px);
    background-size: 25px 100%;
  }

  .barcode-id {
    font-family: var(--fira, monospace);
    font-size: 8px;
    letter-spacing: 3px;
  }

  .database-content {
    margin-top: auto;
    width: 60%;
    padding-bottom: 20px;
  }

  .barcode-divider {
    width: 100%;
    height: 8px;
    background: repeating-linear-gradient(90deg, #000 0px, #000 1px, transparent 1px, transparent 2px, #000 2px, #000 3px, transparent 3px, transparent 8px);
    margin-bottom: 10px;
  }

  .name-grid {
    font-family: var(--fira, monospace);
    font-size: 8px;
    column-count: 2;
    text-transform: uppercase;
    color: #888;
  }

  .highlight { color: #000; font-weight: 900; background: #ffff00; }

  .stamp-stack {
    position: absolute;
    bottom: 40px;
    right: 40px;
  }

  .stamp {
    width: 45px;
    height: 55px;
    background: #fff;
    padding: 3px;
    mask-image: radial-gradient(circle at 4px 4px, transparent 3.5px, black 3.5px);
    mask-size: 8px 8px;
    filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.1));
  }

  .stamp-inner {
    border: 1px solid #eee;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .strawberry-pixel {
    width: 15px;
    height: 18px;
    background: var(--accent, #ff0033);
    border-radius: 50% 50% 40% 40%;
  }

  .stamp-price {
    position: absolute;
    top: 5px;
    right: 5px;
    font-size: 8px;
    font-weight: bold;
    font-family: serif;
  }
</style>
