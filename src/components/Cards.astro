<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".cards-viewport",
      start: "top top",
      end: "+=4000",
      scrub: 1,
      pin: true,
    }
  });

  tl.to(".card-photo-top", {
    xPercent: 120,
    rotate: 8,
    duration: 1.5,
    ease: "power2.inOut"
  })
  .to(".card-photo-middle", {
    xPercent: -120,
    rotate: -8,
    duration: 1.5,
    ease: "power2.inOut"
  }, "-=1")
  .to(".card-info", {
    scale: 1.05,
    duration: 1
  }, "-=0.5");

  gsap.to(".vertical-status", {
    opacity: 0.3,
    duration: 1.5,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut"
  });
</script>

