  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".cards-viewport",
      start: "top top",
      end: "+=4000",
      scrub: 1,
      pin: true,
    }
  });

  tl.to(".card-photo-top", {
    xPercent: 120,
    rotate: 8,
    duration: 1.5,
    ease: "power2.inOut"
  })
