---
// src/components/BrokenScreen.astro
const { 
  phrases = ["FASHION, ART AND STEM.", "REALITY BREACH.", "CONNECTING...", "STAY CALM."], 
  waitTime = 3000,
  label = "FRACTURE_OS // CORE_DUMP_01"
} = Astro.props;
---

<div class="screen-container">
  <shatter-max data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport" id="viewport">
        
        <div class="glass-crack-system">
            <svg id="glass-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="shard-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="rgba(255,255,255,0.8)" />
                        <stop offset="100%" stop-color="rgba(255,255,255,0)" />
                    </linearGradient>
                </defs>
                <path class="crack-line" d="M0,500 L500,500 L450,550 L1000,550 M500,500 L550,0 M500,500 L400,1000" fill="none" stroke="white" stroke-width="0.5" />
                <g id="massive-shard-group"></g>
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-data">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </shatter-max>
</div>

<script>
  import { gsap } from "gsap";

  class ShatterMax extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3500");
      const viewport = this.querySelector('#viewport');
      const shardGroup = this.querySelector('#massive-shard-group');
      const crackPath = this.querySelector('.crack-line');
      
      let index = 0;

      const createMassiveShards = () => {
        shardGroup.innerHTML = '';
        const fragment = document.createDocumentFragment();
        
        // 500+ shards for "Way way way way way^1000" more pieces ;P
        for (let i = 0; i < 550; i++) {
          const shard = document.createElementNS("http://www.w3.org/2000/svg", "path");
          const isNeedle = Math.random() > 0.4;
          
          // Geometry: Surgical daggers and micro-dust
          const length = isNeedle ? Math.random() * 400 + 50 : Math.random() * 8;
          const width = isNeedle ? Math.random() * 2 + 0.1 : Math.random() * 2;
          
          shard.setAttribute("d", `M0,0 L${width},${length} L-${width},${length * 0.9} Z`);
          shard.setAttribute("fill", isNeedle ? "url(#shard-grad)" : "white");
          shard.setAttribute("class", "glass-shard");
          
          // Position them at the central impact point (500, 500)
          gsap.set(shard, { x: 500, y: 500, opacity: 0, scale: 0, z: 0 });
          fragment.appendChild(shard);
        }
        shardGroup.appendChild(fragment);
      };

      const runSequence = () => {
        const word = phrases[index];
        const display = this.querySelector('.display-text');
        display.innerHTML = word.split('').map(c => `<span class="char">${c}</span>`).join('');
        const chars = this.querySelectorAll('.char');
        
        createMassiveShards();
        const shards = this.querySelectorAll('.glass-shard');
        const tl = gsap.timeline();

        
        tl.set(crackPath, { opacity: 0.6 });
        tl.set(display, { opacity: 0 });

      
        tl.to(viewport, { duration: 4.0 }); // Long pause to trick the user

        tl.to(display, { opacity: 1, duration: 0.1 });
        tl.fromTo(chars, 
          { opacity: 0, x: 5 }, 
          { 
            opacity: 1, x: 0, stagger: 0.01, duration: 0.05,
            onUpdate: function() {
              this.targets().forEach(t => {
                if(Math.random() > 0.98) {
                    t.style.transform = `skewX(${Math.random() * 50 - 25}deg) translateX(${Math.random() * 15}px)`;
                    t.style.color = "#ff0033";
                    t.style.letterSpacing = "10px";
                } else {
                    t.style.transform = "none";
                    t.style.color = "white";
                    t.style.letterSpacing = "normal";
                }
              });
            }
          }
        );

        
        tl.add(() => {
          // Violent elastic camera shake
          gsap.fromTo(viewport, { x: -15 }, { x: 0, duration: 0.04, repeat: 8, ease: "power4.out" });

          shards.forEach((shard) => {
            const angle = Math.random() * Math.PI * 2;
            const force = 2000 + Math.random() * 3000;
            
            gsap.to(shard, {
              opacity: 1,
              x: 500 + Math.cos(angle) * force,
              y: 500 + Math.sin(angle) * force,
              z: 4000, // Explode forward past user's eyes
              scale: 15,
              rotationZ: "random(-720, 720)",
              duration: 0.5,
              ease: "expo.out"
            });
          });

          // Disintegrate text
          gsap.to(chars, {
            opacity: 0,
            scale: 4,
            z: 1000,
            x: "random(-300, 300)",
            y: "random(-300, 300)",
            rotation: "random(-45, 45)",
            duration: 0.3,
            stagger: { amount: 0.1 }
          });

          gsap.to(crackPath, { opacity: 0, duration: 0.05 });
        }, "+=1.2");

        // 4. RESET
        tl.to(viewport, { 
            opacity: 0, duration: 1.0, delay: 1.5,
            onComplete: () => {
                gsap.set(viewport, { opacity: 1 });
                index = (index + 1) % phrases.length;
                runSequence();
            }
        });
      };

      runSequence();
    }
  }

  customElements.define('shatter-max', ShatterMax);
</script>

<style>
  .screen-container { background: #000; width: 100%; height: 100vh; overflow: hidden; }
  
  .viewport {
    position: relative; width: 100%; height: 100%;
    display: flex; justify-content: center; align-items: center;
    perspective: 2000px; transform-style: preserve-3d;
    background: #000;
  }

  .glass-crack-system {
    position: absolute; inset: 0; z-index: 100;
    pointer-events: none; transform-style: preserve-3d;
  }

  svg { width: 100%; height: 100%; overflow: visible; }

  .display-text {
    /* Hardcoded high-end modern monospace */
    font-family: 'Fira Code', 'IBM Plex Mono', monospace;
    font-size: clamp(2rem, 12vw, 8rem);
    font-weight: 300; 
    color: white;
    text-transform: uppercase;
    transform-style: preserve-3d;
  }

  .char { display: inline-block; will-change: transform; }

  .meta-data {
    position: absolute; top: 40px; left: 40px;
    font-family: 'Fira Code', monospace; font-size: 10px;
    color: #1a1a1a; letter-spacing: 0.8em;
  }

  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle, transparent 40%, black 150%);
    z-index: 50; pointer-events: none;
  }
</style>
