---
// src/components/BrokenScreen.astro
---

<div class="shatter-container">
  <div class="text-layer main-text">FASHION, ART AND STEM</div>
  
  <div class="shard-wrapper" id="shard-wrapper">
    {Array.from({ length: 15 }).map((_, i) => (
      <div class={`shard shard-${i}`}>
        <div class="shard-content">FASHION, ART AND STEM</div>
      </div>
    ))}
  </div>

  <div class="flash-overlay"></div>
</div>

<script>
  import { gsap } from 'gsap';

  const shards = document.querySelectorAll('.shard');
  const flash = document.querySelector('.flash-overlay');
  const mainText = document.querySelector('.main-text');

  function shatterSequence() {
    const tl = gsap.timeline({ 
      repeat: -1, 
      repeatDelay: 3,
      defaults: { ease: "expo.out" } 
    });

    // 1. Initial State
    tl.set(shards, { opacity: 0, scale: 1, x: 0, y: 0, rotationX: 0, rotationY: 0 });
    tl.set(mainText, { opacity: 1, filter: 'blur(0px)' });

   
    tl.to(mainText, { 
      letterSpacing: "2vw", 
      duration: 1.5, 
      ease: "power4.inOut" 
    });

    // 3. The Impact (Hyper-realistic Flash)
    tl.to(flash, { 
      opacity: 1, 
      duration: 0.04, 
      onStart: () => {
        gsap.set(mainText, { opacity: 0 });
      }
    })
    .to(flash, { opacity: 0, duration: 0.2 });

    // 4. The Chaotic Shatter (Physics-defying movement)
    shards.forEach((shard) => {
      const randomX = (Math.random() - 0.5) * 600;
      const randomY = (Math.random() - 0.5) * 600;
      const randomZ = Math.random() * 500;
      const rotX = (Math.random() - 0.5) * 360;
      const rotY = (Math.random() - 0.5) * 360;

      tl.to(shard, {
        opacity: 1,
        x: randomX,
        y: randomY,
        z: randomZ,
        rotationX: rotX,
        rotationY: rotY,
        scale: 0.5 + Math.random(),
        duration: 1.2,
      }, 0.04); // Stagger start right after flash
    });

    // 5. Shard Vibration (Chaotic Energy)
    tl.to('.shard-content', {
      x: "random(-5, 5)",
      y: "random(-5, 5)",
      duration: 0.05,
      repeat: 10,
      yoyo: true,
      ease: "none"
    }, 0.1);

    // 6. Slow Dissolve
    tl.to(shards, { 
      opacity: 0, 
      filter: 'blur(20px)', 
      scale: 1.5,
      duration: 1.5,
      stagger: 0.03
    }, "+=0.5");
  }

  // Run on load
  window.addEventListener('load', shatterSequence);
</script>

<style>
  .shatter-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #050505; /* Deep luxury black */
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    perspective: 1200px;
    font-family: 'Inter', sans-serif;
  }

  .text-layer {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2rem, 8vw, 12rem);
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .shard-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-style: preserve-3d;
  }

  .shard {
    position: absolute;
    opacity: 0;
    will-change: transform;
    /* Glass-like refraction effect */
    filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
  }

  .shard-content {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2rem, 8vw, 12rem);
    text-transform: uppercase;
    white-space: nowrap;
    /* Chromatic Aberration */
    text-shadow: 
      -2px -1px 0px rgba(255, 0, 80, 0.7), 
      2px 1px 0px rgba(0, 255, 255, 0.7);
  }

  /* Sharp, Jagged Clip Paths for Shards */
  .shard-0 { clip-path: polygon(10% 10%, 45% 15%, 40% 45%, 5% 35%); }
  .shard-1 { clip-path: polygon(50% 5%, 90% 10%, 85% 40%, 55% 45%); }
  .shard-2 { clip-path: polygon(15% 55%, 45% 50%, 40% 90%, 10% 85%); }
  .shard-3 { clip-path: polygon(55% 55%, 95% 50%, 90% 95%, 60% 85%); }
  .shard-4 { clip-path: polygon(30% 30%, 70% 30%, 70% 70%, 30% 70%); }
  .shard-5 { clip-path: polygon(0% 0%, 20% 0%, 10% 20%); }
  .shard-6 { clip-path: polygon(80% 0%, 100% 0%, 90% 20%); }
  .shard-7 { clip-path: polygon(0% 100%, 20% 100%, 10% 80%); }
  .shard-8 { clip-path: polygon(80% 100%, 100% 100%, 90% 80%); }
  
  /* Adding more randomized shards */
  .shard:nth-child(n+9) {
    clip-path: polygon(40% 10%, 60% 10%, 50% 90%);
    opacity: 0.5;
  }

  .flash-overlay {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    z-index: 100;
    pointer-events: none;
  }

  .shatter-container::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 2px, 3px 100%;
    pointer-events: none;
    z-index: 5;
  }
</style>
