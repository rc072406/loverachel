---
// src/components/BrokenScreen.astro
const { 
  phrases = ["SYSTEM FAILURE.", "REALITY BREACH.", "CONNECTING...", "STAY CALM."], 
  waitTime = 2000,
  label = "HARDWARE_CRITICAL // SECTOR_0" 
} = Astro.props;
---

<div class="screen-container">
  <type-writer-prank data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport" id="viewport">
        
        <svg class="filter-svg" style="position: absolute; width: 0; height: 0;">
          <filter id="glitch-distort">
            <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" result="warp" />
            <feDisplacementMap in="SourceGraphic" in2="warp" scale="0" id="glitch-map" />
          </filter>
        </svg>

        <div class="glass-crack-system">
            <svg id="glass-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <path class="crack-line" d="M0,200 L300,400 L250,450 L600,600 L550,650 L1000,800 M400,0 L300,400 L700,300 L1000,400 M300,400 L0,1000 M300,400 L1000,1000 M300,400 L600,0" fill="none" stroke="white" stroke-width="2" />
                <g id="shard-group"></g>
                <circle cx="300" cy="400" r="2" fill="white" />
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-data">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text main"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </type-writer-prank>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterPrank extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2000");
      const viewport = this.querySelector('#viewport');
      const shardGroup = this.querySelector('#shard-group');
      const crackPath = this.querySelector('.crack-line');
      
      let index = 0;

      const createShards = () => {
        shardGroup.innerHTML = '';
       
        for (let i = 0; i < 80; i++) {
          const shard = document.createElementNS("http://www.w3.org/2000/svg", "path");
          // Making them long and "stabby"
          const length = Math.random() * 100 + 50;
          const width = Math.random() * 10 + 2;
          shard.setAttribute("d", `M0,0 L${width},${length} L${-width},${length/2} Z`);
          shard.setAttribute("fill", Math.random() > 0.8 ? "#ff0033" : "rgba(255,255,255,0.2)");
          shard.setAttribute("stroke", "white");
          shard.setAttribute("class", "glass-shard");
          
          gsap.set(shard, { x: 300, y: 400, opacity: 0, scale: 0, z: 0 });
          shardGroup.appendChild(shard);
        }
      };

      const runSequence = () => {
        const word = phrases[index];
        const display = this.querySelector('.display-text');
        display.innerHTML = word.split('').map(c => `<span class="char" data-char="${c}">${c}</span>`).join('');
        const chars = this.querySelectorAll('.char');
        
        createShards();
        const shards = this.querySelectorAll('.glass-shard');
        const tl = gsap.timeline();

      
        tl.set(crackPath, { opacity: 1, scale: 1 });
        tl.set(display, { opacity: 0, filter: "url(#glitch-distort)" });

        
        tl.to(viewport, { 
          backgroundColor: "#050000", 
          duration: 0.05, 
          repeat: 15, 
          yoyo: true, 
          delay: 3.0 // The "Is my phone dead?" pause
        });
        
        tl.to(display, { opacity: 1, duration: 0.1 });
        
        // Violent Text Jitter
        tl.fromTo(chars, 
          { opacity: 0, x: "random(-20, 20)", skewX: 45 }, 
          { 
            opacity: 1, x: 0, skewX: 0, 
            stagger: 0.01, 
            duration: 0.1,
            onUpdate: function() {
              this.targets().forEach(t => {
                if(Math.random() > 0.7) {
                  t.textContent = "?#!X"[Math.floor(Math.random()*4)];
                  t.style.color = "#ff0033";
                  t.style.fontFamily = "monospace";
                } else {
                  t.textContent = t.getAttribute('data-char');
                  t.style.color = "white";
                  t.style.fontFamily = "Inter";
                }
              });
            }
          }
        );

        
        tl.add(() => {
          // Screen Shock
          gsap.to(viewport, { scale: 1.1, duration: 0.1, yoyo: true, repeat: 1 });
          gsap.to("#glitch-map", { attr: { scale: 50 }, duration: 0.1, yoyo: true, repeat: 3 });

          shards.forEach((shard, i) => {
            const angle = Math.random() * Math.PI * 2;
            const force = Math.random() * 1500 + 500;
            
            gsap.to(shard, {
              opacity: 1,
              // Move towards and past the camera
              x: 300 + Math.cos(angle) * force,
              y: 400 + Math.sin(angle) * force,
              z: 1000, // Moves "forward" toward user
              scale: 5, // Gets huge as it "hits" the screen
              rotationX: "random(-1000, 1000)",
              rotationZ: "random(-1000, 1000)",
              duration: 0.8,
              ease: "expo.out"
            });
          });

        
          gsap.to(chars, {
            opacity: 0,
            x: "random(-500, 500)",
            y: "random(-500, 500)",
            rotation: "random(-360, 360)",
            duration: 0.5,
            stagger: 0.005
          });
          
          gsap.to(crackPath, { opacity: 0, scale: 2, duration: 0.3 });
        }, "+=1.5");

       
        tl.to(viewport, { 
            opacity: 0, 
            duration: 0.8, 
            delay: 1.2,
            onComplete: () => {
                gsap.set(viewport, { opacity: 1 });
                index = (index + 1) % phrases.length;
                runSequence();
            }
        });
      };

      runSequence();
    }
  }

  customElements.define('type-writer-prank', TypeWriterPrank);
</script>

<style>
  .screen-container {
    background: #000;
    width: 100%; height: 100vh;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .viewport {
    position: relative;
    width: 100%; height: 100%;
    display: flex; justify-content: center; align-items: center;
    background: #000;
    perspective: 1200px; /* Stronger 3D depth */
    transform-style: preserve-3d;
  }

  .glass-crack-system {
    position: absolute;
    inset: 0; z-index: 100;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  svg { width: 100%; height: 100%; overflow: visible; }

  .crack-line {
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 1.5;
  }

  .glass-shard { transform-style: preserve-3d; }

  .display-text {
    font-size: clamp(2rem, 18vw, 12rem);
    font-weight: 900; color: white;
    text-transform: uppercase;
    text-shadow: 2px 0 #ff0033, -2px 0 #fff; 
  }

  .char { 
    display: inline-block; 
    will-change: transform, opacity;
    filter: drop-shadow(0 0 5px rgba(255,0,0,0.5));
  }

  .meta-data {
    font-family: monospace; font-size: 9px;
    color: #111; letter-spacing: 15px; margin-bottom: 40px;
  }

  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle, transparent 0%, black 110%);
    z-index: 50; pointer-events: none;
  }
</style>
