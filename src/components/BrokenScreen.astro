---
// src/components/BrokenScreen.astro
---

<div class="shatter-container">
  <div class="camera-ui">
    <div class="corner top-left"></div>
    <div class="corner top-right"></div>
    <div class="corner bottom-left"></div>
    <div class="corner bottom-right"></div>
    
    <div class="camera-meta top-meta">
      <span class="rec-dot"></span> 00:00:12:04
    </div>
    <div class="camera-meta bottom-meta">
      <span>ISO 400</span>
      <span>F/2.8</span>
      <span>1/125</span>
    </div>
    <div class="center-cross"></div>
  </div>

  <div class="text-layer main-text">FASHION, ART AND STEM</div>
  
  <div class="shard-wrapper" id="shard-wrapper">
    {Array.from({ length: 15 }).map((_, i) => (
      <div class={`shard shard-${i}`}>
        <div class="shard-content">FASHION, ART AND STEM</div>
      </div>
    ))}
  </div>

  <div class="flash-overlay"></div>
</div>

<script>
  import { gsap } from 'gsap';

  const shards = document.querySelectorAll('.shard');
  const flash = document.querySelector('.flash-overlay');
  const mainText = document.querySelector('.main-text');
  const cameraUI = document.querySelectorAll('.camera-ui, .camera-meta');

  function shatterSequence() {
    const tl = gsap.timeline({ 
      repeat: -1, 
      repeatDelay: 3,
      defaults: { ease: "expo.out" } 
    });

    tl.set(shards, { opacity: 0, scale: 1, x: 0, y: 0, rotationX: 0, rotationY: 0 });
    tl.set(mainText, { opacity: 1, filter: 'blur(0px)' });
    tl.set(cameraUI, { opacity: 1 });

    tl.to(mainText, { 
      letterSpacing: "2vw", 
      duration: 1.5, 
      ease: "power4.inOut" 
    });

    // The Flash & UI Glitch
    tl.to(flash, { 
      opacity: 1, 
      duration: 0.04, 
      onStart: () => {
        gsap.set(mainText, { opacity: 0 });
        // Slight shake on the camera UI when the shutter fires
        gsap.to('.camera-ui', { x: "random(-10, 10)", y: "random(-10, 10)", duration: 0.05, repeat: 3 });
      }
    })
    .to(flash, { opacity: 0, duration: 0.2 });

    shards.forEach((shard) => {
      const randomX = (Math.random() - 0.5) * 600;
      const randomY = (Math.random() - 0.5) * 600;
      const randomZ = Math.random() * 500;
      const rotX = (Math.random() - 0.5) * 360;
      const rotY = (Math.random() - 0.5) * 360;

      tl.to(shard, {
        opacity: 1,
        x: randomX,
        y: randomY,
        z: randomZ,
        rotationX: rotX,
        rotationY: rotY,
        scale: 0.5 + Math.random(),
        duration: 1.2,
      }, 0.04);
    });

    tl.to('.shard-content', {
      x: "random(-5, 5)",
      y: "random(-5, 5)",
      duration: 0.05,
      repeat: 10,
      yoyo: true,
      ease: "none"
    }, 0.1);

    // Fade UI out with the shards
    tl.to([shards, cameraUI], { 
      opacity: 0, 
      filter: 'blur(20px)', 
      duration: 1.5,
      stagger: 0.03
    }, "+=0.5");
  }

  window.addEventListener('load', shatterSequence);
</script>

<style>
  .shatter-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #050505;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    perspective: 1200px;
    font-family: 'Inter', sans-serif;
  }

  /* --- PROFESSIONAL CAMERA UI --- */
  .camera-ui {
    position: absolute;
    inset: 40px; /* Padding for the viewfinder */
    z-index: 20;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .corner {
    position: absolute;
    width: 30px;
    height: 30px;
    border: 2px solid #fff;
  }
  .top-left { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .top-right { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .bottom-left { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .bottom-right { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .camera-meta {
    position: absolute;
    color: #fff;
    font-family: monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .top-meta { top: 20px; left: 20px; display: flex; align-items: center; gap: 8px; }
  .bottom-meta { bottom: 20px; width: calc(100% - 40px); display: flex; justify-content: space-between; padding: 0 20px; }

  .rec-dot {
    width: 8px;
    height: 8px;
    background: red;
    border-radius: 50%;
    animation: blink 1s infinite;
  }

  .center-cross {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translate(-50%, -50%);
  }
  .center-cross::before, .center-cross::after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.5);
  }
  .center-cross::before { top: 50%; left: 0; width: 100%; height: 1px; }
  .center-cross::after { left: 50%; top: 0; width: 1px; height: 100%; }

  @keyframes blink { 50% { opacity: 0; } }

  /* --- TEXT & SHARDS --- */
  .text-layer {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2rem, 8vw, 12rem);
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .shard-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-style: preserve-3d;
  }

  .shard {
    position: absolute;
    opacity: 0;
    will-change: transform;
    filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
  }

  .shard-content {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2rem, 8vw, 12rem);
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: -2px -1px 0px rgba(255, 0, 80, 0.7), 2px 1px 0px rgba(0, 255, 255, 0.7);
  }


  .shard-0 { clip-path: polygon(10% 10%, 45% 15%, 40% 45%, 5% 35%); }
  .shard-1 { clip-path: polygon(50% 5%, 90% 10%, 85% 40%, 55% 45%); }
  .shard-2 { clip-path: polygon(15% 55%, 45% 50%, 40% 90%, 10% 85%); }
  .shard-3 { clip-path: polygon(55% 55%, 95% 50%, 90% 95%, 60% 85%); }
  .shard-4 { clip-path: polygon(30% 30%, 70% 30%, 70% 70%, 30% 70%); }
  .shard-5 { clip-path: polygon(0% 0%, 20% 0%, 10% 20%); }
  .shard-6 { clip-path: polygon(80% 0%, 100% 0%, 90% 20%); }
  .shard-7 { clip-path: polygon(0% 100%, 20% 100%, 10% 80%); }
  .shard-8 { clip-path: polygon(80% 100%, 100% 100%, 90% 80%); }
  .shard:nth-child(n+9) { clip-path: polygon(40% 10%, 60% 10%, 50% 90%); opacity: 0.5; }

  .flash-overlay {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    z-index: 100;
    pointer-events: none;
  }
</style>
