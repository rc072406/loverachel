---
// src/components/BrokenScreen.astro
const { 
  phrases = ["SYSTEM FAILURE.", "REALITY BREACH.", "STAY CALM."], 
  waitTime = 3000,
  label = "FRACTURE_OS // VER_0.4.2" 
} = Astro.props;
---

<div class="screen-container">
  <type-writer-obsidian data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport" id="viewport">
        
        <svg class="filter-svg" style="position: absolute; width: 0; height: 0;">
          <filter id="razor-tear">
            <feTurbulence type="fractalNoise" baseFrequency="0.01 0.4" numOctaves="2" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" id="tear-map" xChannelSelector="R" />
          </filter>
        </svg>

        <div class="glass-layer">
            <svg id="glass-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="needle-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="rgba(255,255,255,0.0)" />
                        <stop offset="50%" stop-color="rgba(255,255,255,0.6)" />
                        <stop offset="100%" stop-color="rgba(255,255,255,0.0)" />
                    </linearGradient>
                </defs>
                <path class="crack-static" d="M0,300 L400,450 L350,500 L650,650 M500,0 L400,450 L1000,350 M400,450 L100,1000" fill="none" stroke="white" stroke-width="0.3" opacity="0.8" />
                <g id="needle-group"></g>
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-label">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </type-writer-obsidian>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterObsidian extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3000");
      const viewport = this.querySelector('#viewport');
      const needleGroup = this.querySelector('#needle-group');
      const crackStatic = this.querySelector('.crack-static');
      
      let index = 0;

      const createNeedles = () => {
        needleGroup.innerHTML = '';
        // 150+ ultra-thin daggers
        for (let i = 0; i < 150; i++) {
          const shard = document.createElementNS("http://www.w3.org/2000/svg", "path");
          const len = Math.random() * 300 + 100;
          const width = 0.5 + Math.random() * 1.5;
          // Asymmetrical needle shape
          shard.setAttribute("d", `M0,0 L${width},${len} L-${width/2},${len*0.9} Z`);
          shard.setAttribute("fill", "url(#needle-grad)");
          shard.setAttribute("stroke", "white");
          shard.setAttribute("stroke-width", "0.1");
          shard.setAttribute("class", "needle-shard");
          
          gsap.set(shard, { x: 400, y: 450, opacity: 0, scale: 0, z: 0 });
          needleGroup.appendChild(shard);
        }
      };

      const run = () => {
        const word = phrases[index];
        const display = this.querySelector('.display-text');
        display.innerHTML = word.split('').map(c => `<span class="char" data-c="${c}">${c}</span>`).join('');
        const chars = this.querySelectorAll('.char');
        
        createNeedles();
        const needles = this.querySelectorAll('.needle-shard');
        const tl = gsap.timeline();

        // 1. THE COLD OPEN (Total silence)
        tl.set(crackStatic, { opacity: 0.8 });
        tl.set(display, { opacity: 0, filter: "url(#razor-tear)" });

        // 2. THE AWAKENING (Precision Glitch)
        tl.to(viewport, { duration: 4.5 }); // The trick delay

        tl.to(display, { opacity: 1, duration: 0.05 });
        tl.fromTo(chars, 
          { opacity: 0, y: 5 }, 
          { 
            opacity: 1, y: 0, stagger: 0.01, duration: 0.2, 
            ease: "power4.out",
            onUpdate: function() {
              this.targets().forEach(t => {
                if(Math.random() > 0.97) {
                    t.style.opacity = "0.2";
                    t.style.transform = `translateX(${Math.random() * 4}px)`;
                } else {
                    t.style.opacity = "1";
                    t.style.transform = `translateX(0)`;
                }
              });
            }
          }
        );

        // 3. THE RAZOR IMPACT (Extreme speed)
        tl.add(() => {
          // Micro-shake (High frequency)
          gsap.to(viewport, { x: "random(-3, 3)", y: "random(-3, 3)", duration: 0.02, repeat: 10 });
          
          // Pixel Tear
          gsap.to("#tear-map", { attr: { scale: 120 }, duration: 0.3, ease: "expo.out" });

          needles.forEach((n) => {
            const angle = Math.random() * Math.PI * 2;
            const velocity = Math.random() * 2500 + 1500;
            
            gsap.to(n, {
              opacity: 1,
              x: 400 + Math.cos(angle) * velocity,
              y: 450 + Math.sin(angle) * velocity,
              z: 2500, // Blow past camera
              scale: 12,
              rotationZ: "random(-720, 720)",
              duration: 0.5,
              ease: "expo.out"
            });
          });

          // Text "Vaporizes"
          gsap.to(chars, {
            opacity: 0,
            z: 1000,
            x: "random(-200, 200)",
            rotationX: "random(-90, 90)",
            duration: 0.3,
            stagger: 0.002
          });

          gsap.to(crackStatic, { opacity: 0, duration: 0.1 });
        }, "+=1.8");

        // 4. RESET
        tl.to(viewport, { 
            opacity: 0, 
            duration: 1.2, 
            delay: 0.5,
            onComplete: () => {
                gsap.set(viewport, { opacity: 1 });
                index = (index + 1) % phrases.length;
                run();
            }
        });
      };

      run();
    }
  }

  customElements.define('type-writer-obsidian', TypeWriterObsidian);
</script>

<style>
  .screen-container {
    background: #000;
    width: 100%; height: 100vh;
    overflow: hidden;
  }

  .viewport {
    position: relative;
    width: 100%; height: 100%;
    display: grid; place-items: center;
    background: #000;
    perspective: 2000px; /* Deep perspective for "stab" effect */
    transform-style: preserve-3d;
  }

  .glass-layer {
    position: absolute; inset: 0;
    z-index: 100; pointer-events: none;
    transform-style: preserve-3d;
  }

  svg { width: 100%; height: 100%; overflow: visible; }

  .display-text {
    font-family: 'Fira Code', monospace;
    font-size: clamp(2rem, 10vw, 7rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #fff;
    text-transform: uppercase;
    transform-style: preserve-3d;
    filter: drop-shadow(0 0 1px rgba(255,255,255,0.5));
  }

  .char { display: inline-block; will-change: transform, opacity; }

  .meta-label {
    position: absolute; top: 30px; left: 30px;
    font-family: 'Fira Code', monospace; font-size: 9px;
    color: #1a1a1a; letter-spacing: 0.3em;
  }

  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle, transparent 40%, black 140%);
    z-index: 50; pointer-events: none;
  }

  .needle-shard { pointer-events: none; }
</style>
