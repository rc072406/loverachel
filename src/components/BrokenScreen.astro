---
// src/components/BrokenScreen.astro
const { 
  phrases = ["SYSTEM FAILURE.", "REALITY BREACH.", "STAY CALM."], 
  waitTime = 2000,
  label = "HARDWARE_CHECK // ERROR_77" 
} = Astro.props;
---

<div class="screen-container">
  <type-writer-prank data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport">
        <div class="glass-crack-system">
            <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <path class="crack-line" d="M0,200 L300,400 L250,450 L600,600 L550,650 L1000,800 M400,0 L300,400 L700,300 L1000,400 M300,400 L0,1000" fill="none" stroke="white" stroke-width="2" />
                <circle cx="300" cy="400" r="5" fill="white" class="impact-point" />
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-data">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text main"></h2>
                <h2 class="display-text flicker"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </type-writer-prank>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterPrank extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2000");
      const displays = this.querySelectorAll('.display-text');
      const crackPath = this.querySelector('.crack-line');
      const glassLayer = this.querySelector('.glass-crack-system');
      
      let index = 0;

      const runSequence = () => {
        const word = phrases[index];
        const markup = word.split('').map(c => `<span class="char">${c}</span>`).join('');
        displays.forEach(d => d.innerHTML = markup);

        const chars = this.querySelectorAll('.char');
        const tl = gsap.timeline();

        // 1. Initial "Broken Screen" State (Silent for 1 second)
        tl.set(glassLayer, { opacity: 1, filter: "drop-shadow(0 0 2px white)" });
        tl.set(displays, { opacity: 0 });

      
        tl.to(glassLayer, { 
            duration: 0.1, 
            repeat: 5, 
            yoyo: true, 
            opacity: 0.5, 
            delay: 1.5 // The "Suspense" delay
        });

        tl.to(displays, { 
            opacity: 1, 
            duration: 0.05, 
            onStart: () => {
                // Chaotic flash sound-visual effect
                gsap.to(".viewport", { backgroundColor: "#1a0000", duration: 0.05, repeat: 10, yoyo: true });
            }
        });

       
        tl.fromTo(chars, 
            { opacity: 0, y: 10 }, 
            { 
                opacity: 1, 
                y: 0, 
                stagger: 0.02, 
                ease: "power4.out",
                onUpdate: function() {
                    // Randomly color characters crimson or white
                    this.targets().forEach(t => {
                        if(Math.random() > 0.8) {
                            t.style.color = "#ff0033";
                            t.style.textShadow = "0 0 10px #ff0033";
                        } else {
                            t.style.color = "white";
                            t.style.textShadow = "none";
                        }
                    });
                }
            }
        );

        // 4. Reset for next phrase
        tl.to(displays, { 
            opacity: 0, 
            delay: waitTime / 1000, 
            duration: 0.1,
            onComplete: () => {
                index = (index + 1) % phrases.length;
                runSequence();
            }
        });
      };

      runSequence();
    }
  }

  customElements.define('type-writer-prank', TypeWriterPrank);
</script>

<style>
  .screen-container {
    background: #000;
    width: 100%;
    height: 100vh;
    cursor: none;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .viewport {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
  }

  /* The Crack Overlay */
  .glass-crack-system {
    position: absolute;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 1;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .crack-line {
    stroke: rgba(255, 255, 255, 0.8);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 1px rgba(255,255,255,0.5));
  }

  .impact-point {
    filter: blur(2px);
    box-shadow: 0 0 20px white;
  }

  /* The Content Layer */
  .content-layer {
    z-index: 10;
    text-align: center;
  }

  .meta-data {
    font-family: monospace;
    font-size: 10px;
    color: #333;
    letter-spacing: 5px;
    margin-bottom: 20px;
  }

  .text-canvas {
    position: relative;
  }

  .display-text {
    font-size: clamp(2rem, 10vw, 8rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    color: white;
  }

  .flicker {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    mix-blend-mode: color-dodge;
    opacity: 0.5;
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 30%, black 100%);
    pointer-events: none;
    z-index: 50;
  }

  .char {
    display: inline-block;
    transition: all 0.05s steps(2);
  }
</style>
