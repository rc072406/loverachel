---
// src/components/BrokenScreen.astro
const { 
  phrases = ["FASHION, ART AND STEM.", "FASHION, ART AND STEM.", "FASHION, ART AND STEM."], 
  waitTime = 3500,
  label = "WELCOME // 01" 
} = Astro.props;
---

<div class="screen-container">
  <type-writer-razor data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport" id="viewport">
        
        <div class="glass-layer">
            <svg id="glass-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <path class="crack-static" d="M0,450 L450,450 L400,500 L1000,500 M450,450 L500,0 M450,450 L300,1000" fill="none" stroke="white" stroke-width="0.5" />
                <g id="needle-group"></g>
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-label">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </type-writer-razor>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterRazor extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3500");
      const viewport = this.querySelector('#viewport');
      const needleGroup = this.querySelector('#needle-group');
      const crackStatic = this.querySelector('.crack-static');
      
      let index = 0;

      const createNeedles = () => {
        needleGroup.innerHTML = '';
        for (let i = 0; i < 180; i++) {
          const shard = document.createElementNS("http://www.w3.org/2000/svg", "path");
          const len = Math.random() * 400 + 50;
          shard.setAttribute("d", `M0,0 L1,${len} L-0.5,${len*0.95} Z`); // Needle geometry
          shard.setAttribute("fill", "white");
          shard.setAttribute("class", "needle");
          
          gsap.set(shard, { x: 450, y: 450, opacity: 0, scale: 0 });
          needleGroup.appendChild(shard);
        }
      };

      const run = () => {
        const word = phrases[index];
        const display = this.querySelector('.display-text');
        display.innerHTML = word.split('').map(c => `<span class="char" data-c="${c}">${c}</span>`).join('');
        const chars = this.querySelectorAll('.char');
        
        createNeedles();
        const needles = this.querySelectorAll('.needle');
        const tl = gsap.timeline();

        // 1. THE TRICK (Dead Still)
        tl.set(crackStatic, { opacity: 0.7 });

        // 2. THE STUTTER (High-speed horizontal pixel shifting)
        tl.to(viewport, { duration: 4.0 }); // Long bait

        tl.to(display, { opacity: 1, duration: 0.01 });
        tl.fromTo(chars, 
          { opacity: 0 }, 
          { 
            opacity: 1, stagger: 0.005, 
            onUpdate: function() {
              this.targets().forEach(t => {
                // Precision "Micro-Stab" glitch
                if(Math.random() > 0.98) {
                    t.style.transform = `skewX(${Math.random() * 60 - 30}deg) translateX(${Math.random() * 20}px)`;
                    t.style.color = "#ff0000";
                } else {
                    t.style.transform = "none";
                    t.style.color = "white";
                }
              });
            }
          }
        );

        // 3. THE SHATTER (Instantaneous)
        tl.add(() => {
          // Snap Shake
          gsap.fromTo(viewport, { x: -10 }, { x: 0, duration: 0.05, ease: "elastic.out(1, 0.1)" });

          needles.forEach((n) => {
            const angle = Math.random() * Math.PI * 2;
            const velocity = 2000 + Math.random() * 1000;
            
            gsap.to(n, {
              opacity: 1,
              x: 450 + Math.cos(angle) * velocity,
              y: 450 + Math.sin(angle) * velocity,
              z: 3000,
              scale: 15,
              rotationZ: "random(-360, 360)",
              duration: 0.4,
              ease: "expo.out"
            });
          });

          gsap.to(chars, {
            opacity: 0,
            scale: 2,
            z: 500,
            x: "random(-100, 100)",
            duration: 0.2,
          });

          gsap.to(crackStatic, { opacity: 0, duration: 0.05 });
        }, "+=1.5");

        // 4. RESET
        tl.to(viewport, { 
            opacity: 0, duration: 0.5, delay: 1.5,
            onComplete: () => {
                gsap.set(viewport, { opacity: 1 });
                index = (index + 1) % phrases.length;
                run();
            }
        });
      };

      run();
    }
  }

  customElements.define('type-writer-razor', TypeWriterRazor);
</script>

<style>
  .screen-container { background: #000; width: 100%; height: 100vh; overflow: hidden; }
  
  .viewport {
    position: relative; width: 100%; height: 100%;
    display: grid; place-items: center;
    perspective: 2500px; transform-style: preserve-3d;
  }

  .glass-layer { position: absolute; inset: 0; z-index: 100; transform-style: preserve-3d; }
  
  svg { width: 100%; height: 100%; overflow: visible; }

  .display-text {
    font-family: 'Fira Code', monospace;
    font-size: clamp(2rem, 10vw, 8rem);
    font-weight: 300; color: #fff;
    text-transform: uppercase;
    transform-style: preserve-3d;
  }

  .char { display: inline-block; will-change: transform; }

  .meta-label {
    position: absolute; top: 40px; left: 40px;
    font-family: 'Fira Code', monospace; font-size: 10px;
    color: #111; letter-spacing: 0.5em;
  }

  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle, transparent 50%, black 150%);
    pointer-events: none;
  }
</style>
