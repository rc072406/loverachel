---
// src/components/BrokenScreen.astro
const { 
  phrases = ["SYSTEM FAILURE.", "REALITY BREACH.", "STAY CALM."], 
  waitTime = 2500,
  label = "FRACTURE_OS // VOL.01" 
} = Astro.props;
---

<div class="screen-container">
  <type-writer-precision data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="viewport" id="viewport">
        
        <svg class="filter-svg" style="position: absolute; width: 0; height: 0;">
          <filter id="razor-refraction">
            <feTurbulence type="fractalNoise" baseFrequency="0.02 0.15" numOctaves="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" id="refraction-scale" />
          </filter>
        </svg>

        <div class="glass-system">
            <svg id="glass-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="shard-sheen" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="rgba(255,255,255,0.4)" />
                        <stop offset="50%" stop-color="rgba(255,255,255,0.05)" />
                        <stop offset="100%" stop-color="rgba(255,255,255,0.2)" />
                    </linearGradient>
                </defs>
                <path class="crack-base" d="M0,200 L300,400 L250,450 L600,600 L550,650 L1000,800 M400,0 L300,400 L700,300 L1000,400 M300,400 L0,1000 M300,400 L800,0" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="0.5" />
                <g id="dagger-group"></g>
            </svg>
        </div>

        <div class="content-layer">
            <div class="meta-data">{label}</div>
            <div class="text-canvas">
                <h2 class="display-text fira-code"></h2>
            </div>
        </div>

        <div class="vignette"></div>
    </div>
  </type-writer-precision>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterPrecision extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2500");
      const viewport = this.querySelector('#viewport');
      const daggerGroup = this.querySelector('#dagger-group');
      const crackBase = this.querySelector('.crack-base');
      
      let index = 0;

      const createDaggers = () => {
        daggerGroup.innerHTML = '';
        for (let i = 0; i < 120; i++) {
          const shard = document.createElementNS("http://www.w3.org/2000/svg", "path");
          // Needle-thin daggers
          const length = Math.random() * 250 + 100;
          const width = Math.random() * 4 + 0.5;
          shard.setAttribute("d", `M0,0 L${width},${length} L${-width/2},${length*0.8} Z`);
          shard.setAttribute("fill", "url(#shard-sheen)");
          shard.setAttribute("stroke", "rgba(255,255,255,0.3)");
          shard.setAttribute("stroke-width", "0.2");
          shard.setAttribute("class", "dagger");
          
          gsap.set(shard, { x: 300, y: 400, opacity: 0, scale: 0, z: 0 });
          daggerGroup.appendChild(shard);
        }
      };

      const runSequence = () => {
        const word = phrases[index];
        const display = this.querySelector('.display-text');
        display.innerHTML = word.split('').map(c => `<span class="char" data-c="${c}">${c}</span>`).join('');
        const chars = this.querySelectorAll('.char');
        
        createDaggers();
        const daggers = this.querySelectorAll('.dagger');
        const tl = gsap.timeline();

        // 1. THE TRICK (Dead Static)
        tl.set(crackBase, { opacity: 1, scale: 1 });
        tl.set(display, { opacity: 0, filter: "url(#razor-refraction)" });

        // 2. MODERN GLITCH (Pixel vibration)
        tl.to(viewport, { duration: 4.0 }); // Long silence
        
        tl.to(display, { opacity: 1, duration: 0.1 });
        tl.fromTo(chars, 
          { opacity: 0, x: (i) => i % 2 === 0 ? -5 : 5 }, 
          { 
            opacity: 1, x: 0, stagger: 0.01, duration: 0.05,
            onUpdate: function() {
              this.targets().forEach(t => {
                if(Math.random() > 0.98) {
                    t.style.transform = `translate(${Math.random()*10}px, 0)`;
                    t.style.color = "#ff1133";
                } else {
                    t.style.transform = `translate(0,0)`;
                    t.style.color = "white";
                }
              });
            }
          }
        );

        // 3. THE RAZOR SHATTER (Fast, Sharp, Forward)
        tl.add(() => {
          // Subtle fast shake
          gsap.to(viewport, { x: "random(-5, 5)", duration: 0.05, repeat: 5, yoyo: true });
          gsap.to("#refraction-scale", { attr: { scale: 150 }, duration: 0.4, ease: "expo.out" });

          daggers.forEach((d) => {
            const angle = Math.random() * Math.PI * 2;
            const dist = Math.random() * 2000 + 1000;
            
            gsap.to(d, {
              opacity: 1,
              x: 300 + Math.cos(angle) * dist,
              y: 400 + Math.sin(angle) * dist,
              z: 2000, // Stab forward
              scale: 8,
              rotation: "random(-360, 360)",
              duration: 0.6,
              ease: "expo.out"
            });
          });

          gsap.to(chars, {
            opacity: 0,
            z: "random(200, 800)",
            rotationX: "random(-90, 90)",
            duration: 0.4,
            ease: "power4.in"
          });

          gsap.to(crackBase, { opacity: 0, duration: 0.2 });
        }, "+=1.5");

        // 4. CLEANUP
        tl.to(viewport, { 
            opacity: 0, 
            duration: 1.0, 
            delay: 1,
            onComplete: () => {
                gsap.set(viewport, { opacity: 1 });
                index = (index + 1) % phrases.length;
                runSequence();
            }
        });
      };

      runSequence();
    }
  }

  customElements.define('type-writer-precision', TypeWriterPrecision);
</script>

<style>
  .screen-container {
    background: #000;
    width: 100%; height: 100vh;
    overflow: hidden;
  }

  .viewport {
    position: relative;
    width: 100%; height: 100%;
    display: flex; justify-content: center; align-items: center;
    background: #000;
    perspective: 1500px;
    transform-style: preserve-3d;
  }

  .glass-system {
    position: absolute;
    inset: 0; z-index: 100;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  svg { width: 100%; height: 100%; overflow: visible; }

  .display-text {
    font-family: 'Fira Code', 'IBM Plex Mono', monospace;
    font-size: clamp(2rem, 12vw, 8rem);
    font-weight: 300; /* Modern, thin weight */
    letter-spacing: -0.05em;
    color: white;
    text-transform: uppercase;
  }

  .char { display: inline-block; will-change: transform, opacity; }

  .meta-data {
    position: absolute; top: 40px; left: 40px;
    font-family: 'Fira Code', monospace; font-size: 10px;
    color: #1a1a1a; letter-spacing: 0.5em;
  }

  .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(circle, transparent 20%, black 110%);
    z-index: 50; pointer-events: none;
  }
</style>
