---
// src/components/BrokenScreen.astro
---

<div class="shatter-container">
  <div class="camera-overlay">
    <div class="camera-ui">
      <div class="corner top-left"></div>
      <div class="corner top-right"></div>
      <div class="corner bottom-left"></div>
      <div class="corner bottom-right"></div>
      
      <div class="camera-meta top-meta">
        <span class="rec-dot"></span> 00:00:12:04
      </div>
      <div class="camera-meta bottom-meta">
        <span>ISO 400</span>
        <span>F/2.8</span>
        <span>1/125</span>
      </div>
      <div class="center-cross"></div>
    </div>
  </div>

  <div class="text-layer main-text">FASHION, ART AND STEM</div>
  
  <div class="shard-wrapper" id="shard-wrapper">
    {Array.from({ length: 15 }).map((_, i) => (
      <div class={`shard shard-${i}`}>
        <div class="shard-content">FASHION, ART AND STEM</div>
      </div>
    ))}
  </div>

  <div class="flash-overlay"></div>
</div>

<script>
  import { gsap } from 'gsap';

  const shards = document.querySelectorAll('.shard');
  const flash = document.querySelector('.flash-overlay');
  const mainText = document.querySelector('.main-text');
  const cameraUI = document.querySelector('.camera-ui');

  function shatterSequence() {
    const tl = gsap.timeline({ 
      repeat: -1, 
      repeatDelay: 3,
      defaults: { ease: "expo.out" } 
    });

    // Reset loop state
    tl.set(shards, { opacity: 0, scale: 1, x: 0, y: 0, rotationX: 0, rotationY: 0, filter: 'blur(0px)' });
    tl.set(mainText, { opacity: 1, filter: 'blur(0px)', letterSpacing: "-0.02em" });

    // 1. Tension Build
    tl.to(mainText, { 
      letterSpacing: "2vw", 
      duration: 1.5, 
      ease: "power4.inOut" 
    });

    // 2. The Impact (Flash + Camera UI Glitch)
    tl.to(flash, { 
      opacity: 1, 
      duration: 0.04, 
      onStart: () => {
        gsap.set(mainText, { opacity: 0 });
        // The camera "shakes" but stays visible
        gsap.fromTo(cameraUI, 
          { x: -10, y: -10 }, 
          { x: 0, y: 0, duration: 0.4, ease: "elastic.out(1, 0.3)" }
        );
      }
    })
    .to(flash, { opacity: 0, duration: 0.2 });

    // 3. Shard Explosion
    shards.forEach((shard) => {
      const randomX = (Math.random() - 0.5) * 800;
      const randomY = (Math.random() - 0.5) * 800;
      const randomZ = Math.random() * 600;
      const rotX = (Math.random() - 0.5) * 360;
      const rotY = (Math.random() - 0.5) * 360;

      tl.to(shard, {
        opacity: 1,
        x: randomX,
        y: randomY,
        z: randomZ,
        rotationX: rotX,
        rotationY: rotY,
        scale: 0.5 + Math.random(),
        duration: 1.5,
      }, 1.54); // Triggers immediately with the flash
    });

    // 4. Chaotic Vibration
    tl.to('.shard-content', {
      x: "random(-10, 10)",
      duration: 0.05,
      repeat: 12,
      yoyo: true,
      ease: "none"
    }, 1.6);

    // 5. Dissolve (SHARDS ONLY)
    // We do NOT include cameraUI here so it remains on screen
    tl.to(shards, { 
      opacity: 0, 
      filter: 'blur(30px)', 
      duration: 1.2,
      stagger: 0.02
    }, "+=1");
  }

  window.addEventListener('load', shatterSequence);
</script>

<style>
  .shatter-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #050505;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    perspective: 1500px;
    font-family: 'Inter', sans-serif;
  }

  /* --- CAMERA OVERLAY (Stays constant) --- */
  .camera-overlay {
    position: absolute;
    inset: 0;
    z-index: 100; /* Above shards, below flash if you want the flash to affect UI */
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .camera-ui {
    position: relative;
    width: calc(100% - 80px);
    height: calc(100% - 80px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .corner {
    position: absolute;
    width: 40px;
    height: 40px;
    border: 2px solid #fff;
  }
  .top-left { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .top-right { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .bottom-left { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .bottom-right { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .camera-meta {
    position: absolute;
    color: #fff;
    font-family: 'Inter', monospace;
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .top-meta { top: 25px; left: 25px; display: flex; align-items: center; gap: 10px; }
  .bottom-meta { bottom: 25px; width: calc(100% - 50px); display: flex; justify-content: space-between; padding: 0 25px; }

  .rec-dot {
    width: 10px;
    height: 10px;
    background: #ff0000;
    border-radius: 50%;
    box-shadow: 0 0 10px #ff0000;
    animation: blink 1s steps(2) infinite;
  }

  .center-cross {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    transform: translate(-50%, -50%);
    opacity: 0.4;
  }
  .center-cross::before, .center-cross::after {
    content: '';
    position: absolute;
    background: #fff;
  }
  .center-cross::before { top: 50%; left: 0; width: 100%; height: 1px; }
  .center-cross::after { left: 50%; top: 0; width: 1px; height: 100%; }

  @keyframes blink { 50% { opacity: 0; } }

  /* --- ELEMENTS THAT SHATTER --- */
  .text-layer {
    color: #fff;
    font-weight: 950;
    font-size: clamp(2rem, 8.5vw, 14rem);
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .shard-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transform-style: preserve-3d;
    z-index: 10;
  }

  .shard {
    position: absolute;
    opacity: 0;
    will-change: transform;
    filter: drop-shadow(0 0 15px rgba(255,255,255,0.1));
  }

  .shard-content {
    color: #fff;
    font-weight: 950;
    font-size: clamp(2rem, 8.5vw, 14rem);
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 
      -3px -1px 0px rgba(255, 0, 80, 0.8), 
      3px 1px 0px rgba(0, 255, 255, 0.8);
  }

  /* Clip Paths */
  .shard-0 { clip-path: polygon(5% 5%, 48% 10%, 42% 48%, 2% 40%); }
  .shard-1 { clip-path: polygon(52% 2%, 98% 8%, 92% 45%, 55% 48%); }
  .shard-2 { clip-path: polygon(5% 55%, 48% 52%, 45% 98%, 2% 92%); }
  .shard-3 { clip-path: polygon(55% 52%, 98% 55%, 95% 95%, 52% 98%); }
  .shard-4 { clip-path: polygon(25% 25%, 75% 25%, 75% 75%, 25% 75%); }
  .shard-5 { clip-path: polygon(0% 0%, 30% 0%, 15% 15%); }
  .shard-6 { clip-path: polygon(70% 0%, 100% 0%, 85% 15%); }
  .shard-7 { clip-path: polygon(0% 100%, 30% 100%, 15% 85%); }
  .shard-8 { clip-path: polygon(70% 100%, 100% 100%, 85% 85%); }
  .shard:nth-child(n+9) { clip-path: polygon(45% 45%, 55% 45%, 50% 55%); opacity: 0.3; }

  .flash-overlay {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    z-index: 200; 
    pointer-events: none;
  }
</style>
