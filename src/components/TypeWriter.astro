---
// src/components/TypeWriter.astro
const { phrases = ["Falling in love."], waitTime = 2000 } = Astro.props;
---

<type-writer data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
  <section class="typing-box-container">
    <div class="typing-box">
      <div class="box-content">
        <span class="typewriter-text"></span>
        <span class="cursor">|</span>
      </div>
    </div>
  </section>
</type-writer>

<script>
  class TypeWriterElement extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2000");
      const target = this.querySelector('.typewriter-text');
      
      if (target && phrases.length > 0) {
        this.initTypewriter(target, phrases, waitTime);
      }
    }

    initTypewriter(element, phrases, waitTime) {
      let phraseIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      const type = () => {
        const currentPhrase = phrases[phraseIndex];
        let typeSpeed = isDeleting ? 50 : 100;

        if (isDeleting) {
          element.textContent = currentPhrase.substring(0, charIndex - 1);
          charIndex--;
        } else {
          element.textContent = currentPhrase.substring(0, charIndex + 1);
          charIndex++;
        }

        if (!isDeleting && charIndex === currentPhrase.length) {
          isDeleting = true;
          typeSpeed = waitTime;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          typeSpeed = 500;
        }

        setTimeout(type, typeSpeed);
      };

      type();
    }
  }

  if (!customElements.get('type-writer')) {
    customElements.define('type-writer', TypeWriterElement);
  }
</script>

<style>
  .typing-box-container {
    background: #000;
    display: flex;
    justify-content: center;
}

.typing-box {
    width: 100%;
    max-width: 900px;
    border: 1px solid #333;
    display: flex;
   align-items: center;
}

.box-content {
    padding: 40px;
    font-size: clamp(1.2rem, 3vw, 2rem);
    min-height: 250px;
}
.cursor {
    color: #ff0033;
    font-weight: 300;
    margin-left: 5px;
    animation: blink 0.8s step-end infinite;
}

@keyframes blink {
    from, to { opacity: 1; }
    50% { opacity: 0; }
}
</style>
