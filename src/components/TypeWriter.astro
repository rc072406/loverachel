---
// src/components/TypeWriter.astro
const { 
  phrases = ["FALLING IN LOVE.", "ONE STORY.", "AT A TIME."], 
  waitTime = 2500,
  label = "FATAL_ERROR // SHATTER_MODE" 
} = Astro.props;
---

<div class="luxury-frame shatter-anarchy">
  <div class="frame-meta">
    <div class="meta-left">
        <div class="shatter-icon"></div>
        <span class="label-text">{label}</span>
    </div>
    <div class="status-alert" id="cypher">SYSTEM_FRACTURE</div>
  </div>

  <type-writer-shatter data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="box-content">
        <div class="glass-overlay"></div>
        
        <div class="glitch-canvas">
            <div class="layer main-text"></div>
            <div class="layer ghost-red"></div>
            <div class="layer blood-depth"></div>
            <div class="layer wireframe"></div>
        </div>
        
        <div id="shard-container"></div>
    </div>
  </type-writer-shatter>

  <div class="frame-footer">
    <span class="warning">CAUTION: DATA LOSS IMMINENT</span>
    <span class="coord">FRAGMENT_ID: 0x88912</span>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterShatter extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2500");
      const layers = this.querySelectorAll('.layer');
      const shardContainer = document.getElementById('shard-container');
      const cypher = document.getElementById('cypher');
      
      let index = 0;
      const techChars = "01<>[]{}+=-_#&%";

      const animate = () => {
        const word = phrases[index];
        const markup = word.split(' ').map(w => `
          <span class="word">
            ${w.split('').map(c => `<span class="char" data-c="${c}">${c}</span>`).join('')}
          </span>
        `).join('<span class="space">&nbsp;</span>');

        layers.forEach(l => {
            l.innerHTML = markup;
            l.style.clipPath = "none";
        });

        const allChars = this.querySelectorAll('.char');
        
        const tl = gsap.timeline({
          onComplete: () => gsap.delayedCall(waitTime / 1000, shatterExit)
        });

       
        tl.fromTo(allChars, 
          { 
            opacity: 0, 
            scale: 2, 
            z: 200, 
            filter: "brightness(500%) blur(10px)" 
          },
          { 
            opacity: 1, 
            scale: 1, 
            z: 0, 
            filter: "brightness(100%) blur(0px)",
            duration: 0.3,
            stagger: { each: 0.01, from: "center" },
            ease: "expo.out",
            onUpdate: function() {
              this.targets().forEach(t => {
                if (Math.random() > 0.8) {
                   t.textContent = techChars[Math.floor(Math.random() * techChars.length)];
                   t.style.fontFamily = "'Fira Code', monospace";
                } else {
                   t.textContent = t.getAttribute('data-c');
                   t.style.fontFamily = "'Inter', sans-serif";
                }
              });
              if(cypher && Math.random() > 0.8) cypher.textContent = `SHATTER_VAL: ${Math.random().toFixed(4)}`;
            }
          }
        );

        
        const jitter = gsap.to(".blood-depth", {
            x: "random(-20, 20)",
            y: "random(-10, 10)",
            scale: 1.05,
            duration: 0.04,
            repeat: -1,
            repeatRefresh: true,
            opacity: 0.8
        });

        
        const sliceInterval = setInterval(() => {
            layers.forEach(l => {
                const p1 = Math.random() * 100;
                const p2 = p1 + 10;
                l.style.clipPath = `polygon(0% ${p1}%, 100% ${p1 - 10}%, 100% ${p2}%, 0% ${p2 + 10}%)`;
            });
        }, 80);

        const shatterExit = () => {
          clearInterval(sliceInterval);
          jitter.kill();

         
          allChars.forEach((char, i) => {
            const rect = char.getBoundingClientRect();
            
            gsap.to(char, {
              x: (Math.random() - 0.5) * 1200,
              y: (Math.random() - 0.5) * 1200,
              z: Math.random() * 1000,
              rotationX: Math.random() * 720,
              rotationY: Math.random() * 720,
              rotationZ: Math.random() * 720,
              opacity: 0,
              scale: 0,
              duration: 0.8,
              ease: "power4.out",
              onComplete: () => {
                if (i === allChars.length - 1) {
                   index = (index + 1) % phrases.length;
                   animate();
                }
              }
            });
          });

          // Screen Flash
          gsap.fromTo(".glass-overlay", 
            { opacity: 1, backgroundColor: "#330000" }, 
            { opacity: 0, duration: 0.5 }
          );
        };
      };

      animate();
    }
  }

  customElements.define('type-writer-shatter', TypeWriterShatter);
</script>

<style>

  .luxury-frame {
    background: #000;
    border: 2px solid #200;
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .frame-meta {
    padding: 15px 30px;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: #400;
    background: #050000;
    border-bottom: 1px solid #100;
  }

  .shatter-icon {
    width: 15px;
    height: 15px;
    background: #ff0033;
    display: inline-block;
    margin-right: 15px;
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%, 20% 20%, 80% 80%);
    animation: pulse 0.1s infinite alternate;
  }

  @keyframes pulse { from { opacity: 0.5; } to { opacity: 1; transform: scale(1.2); } }

  .box-content {
    flex-grow: 1;
    position: relative;
    display: grid;
    place-items: center;
    perspective: 1500px;
    background: radial-gradient(circle at center, #100 0%, #000 80%);
  }

  .glass-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><path d="M0 0 L100 100 M100 0 L0 100" stroke="rgba(255,0,0,0.05)" stroke-width="0.5"/></svg>');
  }

  .glitch-canvas {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
  }

  .layer {
    grid-area: 1/1;
    font-size: clamp(2rem, 20vw, 14rem);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    line-height: 0.75;
    text-transform: uppercase;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    transform-style: preserve-3d;
  }

  /* Color Palette: High Contrast Reds & Whites */
  .main-text { color: #fff; z-index: 5; text-shadow: 0 0 20px rgba(255,255,255,0.2); }
  .ghost-red { color: #ff0033; z-index: 4; opacity: 0.6; mix-blend-mode: screen; }
  .blood-depth { color: #660000; z-index: 3; mix-blend-mode: multiply; }
  .wireframe { 
    color: transparent; 
    -webkit-text-stroke: 1px rgba(102, 0, 0, 0.5); 
    z-index: 2; 
  }

  .char { display: inline-block; transition: color 0.1s; transform-style: preserve-3d; }

  .frame-footer {
    padding: 15px 30px;
    border-top: 1px solid #100;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 8px;
    color: #300;
  }

  .warning { color: #ff0033; animation: flicker 0.5s infinite; }
  @keyframes flicker { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .word { white-space: nowrap; padding: 0 15px; }
</style>
