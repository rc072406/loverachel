---
// src/components/TypeWriter.astro
const { 
  phrases = ["FALLING IN LOVE."], 
  waitTime = 3000,
  label = "ISSUE NO.01 // 2026" 
} = Astro.props;
---

<div class="luxury-frame">
  <div class="frame-meta">
    <span class="dot"></span>
    <span class="label-text">{label}</span>
  </div>

  <type-writer-modern data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="box-content">
        <slot>
            <h2 class="typewriter-display"></h2>
        </slot>
        <div class="glitch-line"></div>
    </div>
  </type-writer-modern>

  <div class="frame-corner"></div>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterModern extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3000");
      const target = this.querySelector('.typewriter-display');
      const line = this.querySelector('.glitch-line');
      
      if (!target || phrases.length === 0) return;

      let index = 0;

      const animateSequence = () => {
        const word = phrases[index];
        // Split word into spans for GSAP
        target.innerHTML = word.split('').map(char => 
          `<span class="char" style="display:inline-block; opacity:0">${char === ' ' ? '&nbsp;' : char}</span>`
        ).join('');

        const chars = target.querySelectorAll('.char');
        
        const tl = gsap.timeline({
          onComplete: () => setTimeout(exitSequence, waitTime)
        });

        
        tl.to(chars, {
          opacity: 1,
          fontWeight: 900,
          y: 0,
          stagger: 0.03,
          ease: "expo.out",
          duration: 0.8
        })
        .fromTo(line, { scaleX: 0 }, { scaleX: 1, duration: 1.5, ease: "power4.inOut" }, 0);

        const exitSequence = () => {
          gsap.to(chars, {
            opacity: 0,
            y: -20,
            filter: "blur(10px)",
            stagger: 0.02,
            ease: "expo.in",
            onComplete: () => {
              index = (index + 1) % phrases.length;
              animateSequence();
            }
          });
          gsap.to(line, { scaleX: 0, transformOrigin: "right", duration: 0.5 });
        };
      };

      animateSequence();
    }
  }

  customElements.define('type-writer-modern', TypeWriterModern);
</script>

<style>
  
  .luxury-frame {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #000;
    border: 1px solid #222;
    position: relative;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    overflow: hidden;
  }

  .frame-meta {
    padding: 15px 20px;
    border-bottom: 1px solid #222;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 6px;
    height: 6px;
    background: #ff0033;
    border-radius: 50%;
  }

  .label-text {
    color: #666;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .box-content {
    min-height: 350px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    position: relative;
  }

  .typewriter-display {
    color: #fff;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    margin: 0;
    line-height: 0.9;
    letter-spacing: -0.05em; /* Tight high-fashion tracking */
    text-transform: uppercase;
  }

  .glitch-line {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, transparent, #ff0033, transparent);
    transform-origin: left;
  }

  .frame-corner {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    border-right: 1px solid #444;
    border-bottom: 1px solid #444;
  }

  @supports (font-variation-settings: normal) {
    .typewriter-display {
      font-variation-settings: "wght" 900;
    }
  }
</style>
