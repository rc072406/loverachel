---
// src/components/TypeWriter.astro
const { 
  phrases = ["FALLING IN LOVE."], 
  waitTime = 3000,
  label = "ISSUE NO.01 // 2026" 
} = Astro.props;
---

<div class="luxury-frame anarchy-mode">
  <div class="frame-meta">
    <div class="meta-left">
        <span class="dot"></span>
        <span class="label-text">{label}</span>
    </div>
    <span class="tech-id">SYSTEM_OVERRIDE_ENABLED</span>
  </div>

  <type-writer-chaotic data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="box-content">
        <div class="glitch-canvas">
            <h2 class="typewriter-display main-layer"></h2>
            <h2 class="typewriter-display ghost-layer" aria-hidden="true"></h2>
        </div>
        
        <div class="v-line l-1"></div>
        <div class="v-line l-2"></div>
        <div class="glitch-line"></div>
    </div>
  </type-writer-chaotic>

  <div class="frame-corner"></div>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterChaotic extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3000");
      const mainTarget = this.querySelector('.main-layer');
      const ghostTarget = this.querySelector('.ghost-layer');
      const line = this.querySelector('.glitch-line');
      
      if (!mainTarget || phrases.length === 0) return;

      let index = 0;

      const animateSequence = () => {
        const word = phrases[index];
        const markup = word.split(' ').map(wordStr => 
          `<span class="word-wrap">${wordStr.split('').map(char => 
            `<span class="char">${char}</span>`
          ).join('')}</span>`
        ).join('<span class="space">&nbsp;</span>');

        mainTarget.innerHTML = markup;
        ghostTarget.innerHTML = markup;

        const mainChars = mainTarget.querySelectorAll('.char');
        const ghostChars = ghostTarget.querySelectorAll('.char');
        
        const tl = gsap.timeline({
          onComplete: () => setTimeout(exitSequence, waitTime)
        });

        // Entrance: Randomized weight, font-swapping, and position
        tl.fromTo(mainChars, 
          { opacity: 0, y: () => Math.random() * 40 - 20, x: () => Math.random() * 20 - 10 },
          { 
            opacity: 1, 
            y: 0, 
            x: 0, 
            duration: 0.05, 
            stagger: { each: 0.03, from: "random" },
            onUpdate: function() {
                // Randomly swap fonts during animation
                if (Math.random() > 0.9) {
                    this.targets().forEach(t => t.style.fontFamily = "'Fira Code', monospace");
                } else {
                    this.targets().forEach(t => t.style.fontFamily = "'Inter', sans-serif");
                }
            }
          }
        )
        // Ghost layer lags and stays in Fira Code
        .fromTo(ghostChars,
          { opacity: 0, scale: 1.2 },
          { 
            opacity: 0.4, 
            scale: 1, 
            x: () => Math.random() * 10, 
            duration: 1, 
            ease: "expo.out" 
          }, 0
        )
        .to(line, { scaleX: 1.5, x: "-25%", duration: 0.1, repeat: 5, yoyo: true }, 0);

        const exitSequence = () => {
          gsap.to([mainChars, ghostChars], {
            opacity: 0,
            x: () => (Math.random() - 0.5) * 200,
            y: () => (Math.random() - 0.5) * 200,
            rotation: () => (Math.random() - 0.5) * 45,
            filter: "blur(20px)",
            duration: 0.5,
            stagger: 0.01,
            ease: "circ.in",
            onComplete: () => {
              index = (index + 1) % phrases.length;
              animateSequence();
            }
          });
        };
      };

      animateSequence();
    }
  }

  customElements.define('type-writer-chaotic', TypeWriterChaotic);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;700&family=Inter:wght@900&display=swap');

  .luxury-frame {
    background: #000;
    border: 1px solid #333;
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .frame-meta {
    padding: 10px 20px;
    border-bottom: 1px solid #333;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: #555;
  }

  .box-content {
    min-height: 500px; 
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .glitch-canvas {
    position: relative;
    width: 100%;
    max-width: 800px;
  }

  .typewriter-display {
    margin: 0;
    font-size: clamp(3.5rem, 12vw, 8rem);
    text-transform: uppercase;
    line-height: 0.8;
    word-break: break-word;
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
  }

  .main-layer {
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    position: relative;
    z-index: 2;
  }

  .ghost-layer {
    position: absolute;
    top: 5px;
    left: 5px;
    color: #ff0033;
    font-family: 'Fira Code', monospace;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
  }

  .word-wrap { display: inline-block; white-space: nowrap; }

  
  .v-line {
    position: absolute;
    width: 1px;
    height: 100%;
    background: rgba(255, 255, 255, 0.05);
    top: 0;
  }
  .l-1 { left: 20%; }
  .l-2 { left: 80%; }

  .glitch-line {
    position: absolute;
    height: 4px;
    width: 100%;
    background: #ff0033;
    top: 50%;
    left: 0;
    mix-blend-mode: overlay;
    transform: scaleX(0);
  }

  .frame-corner {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 40px;
    height: 40px;
    border-right: 2px solid #ff0033;
    border-bottom: 2px solid #ff0033;
  }
</style>
