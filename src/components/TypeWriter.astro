---
// src/components/TypeWriter.astro
const { 
  phrases = ["FALLING IN LOVE."], 
  waitTime = 3000,
  label = "KERNEL_PANIC // 0x000000" 
} = Astro.props;
---

<div class="luxury-frame terminal-meltdown">
  <div class="frame-meta">
    <div class="meta-left">
        <span class="dot-matrix"></span>
        <span class="label-text">{label}</span>
    </div>
    <div class="bit-rate" id="bit-rate">0kb/s</div>
  </div>

  <type-writer-chaotic data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="box-content">
        <div class="logic-gate-bg" aria-hidden="true"></div>
        
        <div class="glitch-canvas">
            <h2 class="typewriter-display layer-main"></h2>
            <h2 class="typewriter-display layer-ghost"></h2>
            <h2 class="typewriter-display layer-wire"></h2>
        </div>
        
        <div class="distortion-line"></div>
        <div class="vignette"></div>
    </div>
  </type-writer-chaotic>

  <div class="footer-meta">
    <span>CPU_LOAD: 99%</span>
    <span>MEM_DUMP: TRUE</span>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterChaotic extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "3000");
      const layers = this.querySelectorAll('.typewriter-display');
      const bitRate = this.querySelector('#bit-rate');
      
      if (layers.length === 0 || phrases.length === 0) return;

      let index = 0;
      
      const techChars = "01<>[]{}_-+=|\\/!?:;*&$#%^~";

      const animateSequence = () => {
        const word = phrases[index];
        const markup = word.split(' ').map(wordStr => 
          `<span class="word-wrap">${wordStr.split('').map(char => 
            `<span class="char" data-char="${char}">${char}</span>`
          ).join('')}</span>`
        ).join('<span class="space">&nbsp;</span>');

        layers.forEach(l => l.innerHTML = markup);
        const allChars = this.querySelectorAll('.char');
        
        const tl = gsap.timeline({
          onComplete: () => setTimeout(exitSequence, waitTime)
        });

        // 1. DATA BURST
        tl.to(this, { 
          filter: "contrast(200%) brightness(150%)", 
          duration: 0.05, 
          repeat: 10, 
          yoyo: true 
        });

        tl.fromTo(allChars, 
          { 
            opacity: 0, 
            y: () => (Math.random() - 0.5) * 300, 
            x: () => (Math.random() - 0.5) * 300,
            rotationX: 90,
            scale: 0.5
          },
          { 
            opacity: 1, 
            y: 0, 
            x: 0, 
            rotationX: 0,
            scale: 1,
            duration: 0.3, 
            stagger: { each: 0.01, from: "random" },
            ease: "expo.out",
            onUpdate: function() {
              this.targets().forEach(t => {
                
                if (Math.random() > 0.85) {
                  t.textContent = techChars[Math.floor(Math.random() * techChars.length)];
                  t.style.fontFamily = "'Fira Code', monospace";
                  t.style.color = "#ff0033";
                } else {
                  t.textContent = t.getAttribute('data-char');
                  t.style.fontFamily = "'Inter', sans-serif";
                  t.style.color = "white";
                }
              });
              if(bitRate) bitRate.textContent = `${Math.floor(Math.random() * 999)}kb/s`;
            }
          }, 0
        )
       
        .to(".layer-ghost", { 
          duration: 0.02, 
          x: "random(-10, 10)", 
          y: "random(-5, 5)", 
          repeat: -1, 
          repeatRefresh: true,
          opacity: 0.4
        }, 0)
        .to(".layer-wire", { 
          duration: 0.03, 
          skewX: "random(-20, 20)", 
          repeat: -1, 
          repeatRefresh: true,
          opacity: 0.3
        }, 0);

        const exitSequence = () => {
          gsap.to(allChars, {
            x: () => (Math.random() - 0.5) * 800,
            y: () => (Math.random() - 0.5) * 800,
            rotation: () => (Math.random() - 0.5) * 120,
            opacity: 0,
            scale: 2,
            duration: 0.4,
            stagger: 0.005,
            ease: "power2.in",
            onComplete: () => {
              index = (index + 1) % phrases.length;
              animateSequence();
            }
          });
        };
      };

      animateSequence();
    }
  }

  customElements.define('type-writer-chaotic', TypeWriterChaotic);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;700&family=Inter:wght@900&display=swap');

  .luxury-frame {
    background: #000;
    border: 1px solid #333;
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    color: white;
  }

  .frame-meta {
    padding: 10px 20px;
    border-bottom: 1px solid #222;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: #666;
  }

  .dot-matrix {
    width: 10px;
    height: 10px;
    background: #ff0033;
    display: inline-block;
    margin-right: 10px;
    box-shadow: 0 0 10px #ff0033;
    clip-path: polygon(0% 15%, 15% 15%, 15% 0%, 85% 0%, 85% 15%, 100% 15%, 100% 85%, 85% 85%, 85% 100%, 15% 100%, 15% 85%, 0% 85%);
  }

  .box-content {
    min-height: 550px;
    display: grid;
    place-items: center;
    position: relative;
    padding: 40px;
  }

  .glitch-canvas {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    z-index: 5;
  }

  .typewriter-display {
    grid-area: 1/1;
    font-size: clamp(3rem, 16vw, 11rem);
    text-transform: uppercase;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    line-height: 0.75;
    word-break: break-all;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    pointer-events: none;
  }

  .layer-ghost { color: #ff0033; opacity: 0; mix-blend-mode: hard-light; }
  .layer-wire { -webkit-text-stroke: 1px rgba(255,255,255,0.5); color: transparent; opacity: 0; }

  .word-wrap { display: inline-block; padding: 0 10px; }

  /* Background Chaos */
  .logic-gate-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at center, rgba(255,0,51,0.05) 0%, transparent 70%);
    opacity: 0.5;
  }

  .distortion-line {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 100px;
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-50%) skewY(-5deg);
    pointer-events: none;
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 40%, black 120%);
    pointer-events: none;
  }

  .footer-meta {
    padding: 5px 20px;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 8px;
    background: #0a0a0a;
    color: #333;
  }
</style>
