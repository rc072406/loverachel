---
// src/components/TypeWriter.astro
const { 
  phrases = ["FALLING IN LOVE.", "ONE STORY.", "AT A TIME."], 
  waitTime = 2500,
  label = "SYSTEM_MELTDOWN // VOL_01" 
} = Astro.props;
---

<div class="luxury-frame total-anarchy">
  <div class="frame-meta">
    <div class="meta-left">
        <div class="glitch-square"></div>
        <span class="label-text">{label}</span>
    </div>
    <div class="cypher-text" id="cypher">INIT_BOOT...</div>
  </div>

  <type-writer-anarchy data-phrases={JSON.stringify(phrases)} data-wait={waitTime}>
    <div class="box-content">
        <div class="noise-floor"></div>
        <div class="static-stripes"></div>
        
        <div class="glitch-canvas">
            <div class="layer main-text"></div>
            <div class="layer ghost-red"></div>
            <div class="layer ghost-blue"></div>
            <div class="layer wireframe"></div>
        </div>
        
        <div class="trash-container"></div>
    </div>
  </type-writer-anarchy>

  <div class="frame-footer">
    <div class="progress-bar"><div class="progress-fill"></div></div>
    <span class="coord">40.7128° N, 74.0060° W</span>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  class TypeWriterAnarchy extends HTMLElement {
    constructor() {
      super();
      const phrases = JSON.parse(this.dataset.phrases || "[]");
      const waitTime = parseInt(this.dataset.wait || "2500");
      const layers = this.querySelectorAll('.layer');
      const trashContainer = this.querySelector('.trash-container');
      const cypher = document.getElementById('cypher');
      
      let index = 0;
      const symbols = "01<>[]{}/\\|=+*!#%&?";

      const animate = () => {
        const word = phrases[index];
        
        // 1. Generate Complex Markup
        const markup = word.split(' ').map(w => `
          <span class="word">
            ${w.split('').map(c => `<span class="char" data-c="${c}">${c}</span>`).join('')}
          </span>
        `).join('<span class="space">&nbsp;</span>');

        // 2. Clean and Inject
        layers.forEach(l => {
            l.innerHTML = markup;
            l.style.clipPath = "none"; // Reset slices
        });

        const allChars = this.querySelectorAll('.char');
        const mainChars = this.querySelector('.main-text').querySelectorAll('.char');
        
        // 3. The Master Timeline
        const tl = gsap.timeline({
          onComplete: () => {
            gsap.delayedCall(waitTime / 1000, exit);
          }
        });

        // Entrance: Explosive and Fragmented
        tl.fromTo(allChars, 
          { 
            opacity: 0, 
            z: () => Math.random() * 500 - 250,
            filter: "blur(20px) brightness(200%)",
            scale: 0
          },
          { 
            opacity: 1, 
            z: 0, 
            filter: "blur(0px) brightness(100%)",
            scale: 1,
            duration: 0.4,
            stagger: { each: 0.02, from: "random" },
            ease: "back.out(2)",
            onUpdate: function() {
              this.targets().forEach(t => {
                if (Math.random() > 0.92) {
                   t.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                   t.style.fontFamily = "'Fira Code', monospace";
                   t.style.color = "#ff0033";
                } else {
                   t.textContent = t.getAttribute('data-c');
                   t.style.fontFamily = "'Inter', sans-serif";
                   t.style.color = "";
                }
              });
              if(cypher) cypher.textContent = `ERR: ${Math.random().toString(16).slice(2,8)}`;
            }
          }
        );

        // Continuous Jitter (Independent of timeline flow)
        const jitter = gsap.to(layers, {
            x: "random(-15, 15)",
            y: "random(-10, 10)",
            duration: 0.05,
            repeat: -1,
            repeatRefresh: true,
            ease: "none"
        });

        // Horizontal "Slicing" Glitch
        const slicer = setInterval(() => {
            layers.forEach(l => {
                const y1 = Math.random() * 80;
                const y2 = y1 + Math.random() * 20;
                l.style.clipPath = `inset(${y1}% 0 ${100 - y2}% 0)`;
            });
        }, 100);

        const exit = () => {
          clearInterval(slicer);
          jitter.kill();

          gsap.to(allChars, {
            x: () => (Math.random() - 0.5) * 1500,
            y: () => (Math.random() - 0.5) * 800,
            rotation: () => Math.random() * 360,
            opacity: 0,
            duration: 0.5,
            stagger: 0.005,
            ease: "power4.in",
            onComplete: () => {
              index = (index + 1) % phrases.length;
              animate();
            }
          });
        };
      };

      animate();
    }
  }

  customElements.define('type-writer-anarchy', TypeWriterAnarchy);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;700&family=Inter:wght@900&display=swap');

  .luxury-frame {
    background: #000;
    border: 1px solid #333;
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .frame-meta {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: #444;
    border-bottom: 1px solid #111;
  }

  .glitch-square {
    width: 12px;
    height: 12px;
    background: #ff0033;
    display: inline-block;
    margin-right: 15px;
    animation: sq-glitch 0.2s infinite;
  }

  @keyframes sq-glitch {
    0% { transform: skew(0deg); }
    50% { transform: skew(20deg) scaleY(0.5); }
    100% { transform: skew(-20deg); }
  }

  .box-content {
    flex-grow: 1;
    position: relative;
    display: grid;
    place-items: center;
    background: 
      linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
      linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 2px, 3px 100%;
  }

  .glitch-canvas {
    position: relative;
    width: 90%;
    max-width: 1000px;
    height: 400px;
    display: grid;
    place-items: center;
    perspective: 1000px;
  }

  .layer {
    grid-area: 1/1;
    font-size: clamp(3rem, 18vw, 12rem);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  .main-text { color: #fff; z-index: 4; }
  .ghost-red { color: #ff0033; z-index: 3; mix-blend-mode: screen; }
  .ghost-blue { color: #00f0ff; z-index: 2; mix-blend-mode: screen; }
  .wireframe { 
    color: transparent; 
    -webkit-text-stroke: 1px rgba(255,255,255,0.2); 
    z-index: 1; 
  }

  .char { display: inline-block; position: relative; }

  .frame-footer {
    padding: 20px;
    border-top: 1px solid #111;
    display: flex;
    justify-content: space-between;
    font-family: 'Fira Code', monospace;
    font-size: 9px;
    color: #333;
  }

  .progress-bar { width: 100px; height: 2px; background: #111; position: relative; }
  .progress-fill { 
    width: 40%; height: 100%; background: #ff0033; 
    animation: prog 2s infinite linear;
  }

  @keyframes prog { 0% { left: -100%; } 100% { left: 100%; } }

  .word { white-space: nowrap; padding: 0 10px; }
</style>
