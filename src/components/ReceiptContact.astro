---
---
<section class="receipt-area">
  <div class="perspective-wrapper">
    <p class="press-alert">SIGNAL_LOST // PRESS ME </p>
    
    <div class="receipt-stack" id="receiptStack">
      <div class="receipt receipt-back" id="receiptBack">
        <div class="industrial-overlay"></div>
        <div class="receipt-content">
          <p class="receipt-header">SYSTEM_CONTACT_LOG</p>
          <div class="divider"></div>
          <p>INSTAGRAM: @LOVERACHEL</p>
          <p>EMAIL: N/A [ENCRYPTED]</p>
          <p>LOC: 40.7128° N, 74.0060° W</p>
          <div class="divider"></div>
          <p class="receipt-footer">SCAN FOR ENTRY</p>
        </div>
      </div>

      <div class="receipt receipt-front" id="receiptFront">
        <div class="industrial-overlay"></div>
        <div class="receipt-content">
          <p class="-title">: ISSUE NO.01</p>
          <p>DATE: 07.24.06</p>
          <p>REF: RECODING FEMININITY</p>
          <div class="divider"></div>
          <p class="greeting">To whom it may concern,</p>
          <p>
            Submissions for the magazine and front page are always welcomed. 
            The magazine scouts for editorials and stories that define 
            the intersection of style and technical discipline.
          </p>
          <p>
            love, Rachel is an indie fashion magazine featuring girls 
            changing the game in STEM.
          </p>
          <div class="divider"></div>
          <div class="receipt-signature">love, RACHEL</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .receipt-area {
    min-height: 120vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible !important;
  }

  .perspective-wrapper {
    perspective: 2500px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
  }

  .receipt-stack {
    position: relative;
    width: 360px;
    height: 520px;
    transform-style: preserve-3d;
  }

  .receipt {
    position: absolute;
    inset: 0;
    padding: 45px;
    color: #1a1a1a;
    background: #e0e0e0;
    
 
    background-image: 
      linear-gradient(to bottom, #ffffff 0%, #d4d4d4 100%);
    
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    
   
    --mask-pattern: conic-gradient(from -45deg at bottom, #000 90deg, #0000 0) bottom / 15px 10px repeat-x,
                    conic-gradient(from 135deg at top, #000 90deg, #0000 0) top / 15px 10px repeat-x;

    --mask-body: linear-gradient(#000, #000) center / 100% calc(100% - 20px) no-repeat;
    
    -webkit-mask: var(--mask-pattern), var(--mask-body);
    mask: var(--mask-pattern), var(--mask-body);
    
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    backface-visibility: hidden;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .industrial-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 250 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .receipt-back {
    z-index: 1;
    transform: translateZ(-80px) rotateY(5deg);
    filter: brightness(0.5);
  }

  .receipt-front {
    z-index: 10;
    transform: translateZ(80px);
  }

  .divider {
    height: 1px;
    border-top: 1px dashed rgba(0,0,0,0.3);
    margin: 15px 0;
    width: 100%;
  }

  .receipt-title { font-weight: 800; text-align: center; font-size: 14px; text-transform: uppercase; }
  

  .receipt-signature { 
   font-size: 20px; 
    font-weight: 900; 
    margin-top: 30px; 
    letter-spacing: -1px;
    opacity: 0.9;
    transform: rotate(-3deg);
    filter: blur(0.4px); 
    color: #050505;
  }
  
  .press-alert {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: #ff0033;
    margin-bottom: 30px;
    letter-spacing: 5px;
    text-shadow: 0 0 10px rgba(255,0,51,0.3);
    animation: blink 2s infinite ease-in-out;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const initRefinedReceipt = () => {
    const stack = document.querySelector('#receiptStack');
    const front = document.querySelector('#receiptFront');
    const back = document.querySelector('#receiptBack');

    if (!stack || !front || !back) return;

    const tl = gsap.timeline({ 
      paused: true,
      defaults: { ease: "power4.inOut" } 
    });

    // Realistic "Wind" Flight Path
    tl.to(front, {
      duration: 0.5,
      x: -40,           // Wind-up pull to the left
      y: 20,            // Slight dip
      rotationZ: -5,
      ease: "power2.out"
    })
    .to(front, {
      duration: 1.5,
      x: 2500,          // EXTENDED right-side travel
      y: -1500,         // Shooting high up
      z: -10000,        // Disappearing deep into starfield
      rotationX: 1080,  // Triple tumble
      rotationY: 360,   // Full spin
      rotationZ: 90,
      opacity: 0,
      ease: "power3.in",
      force3D: true
    }, "-=0.1")
    .to(back, {
      duration: 1,
      z: 0,
      filter: "brightness(1)",
      rotateY: 0,
      ease: "back.out(1.2)"
    }, "-=1.3");

    stack.addEventListener('mouseenter', () => tl.play());
    stack.addEventListener('mouseleave', () => tl.reverse());

    stack.addEventListener('mousemove', (e) => {
      if (tl.isActive()) return;
      const rect = stack.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      const target = tl.progress() === 0 ? front : back;
      gsap.to(target, {
        duration: 1,
        rotateY: x * 30,
        rotateX: -y * 30,
        x: x * 25,
        ease: "power3.out",
        overwrite: "auto"
      });
    });
  };

  initRefinedReceipt();
  document.addEventListener('astro:after-swap', initRefinedReceipt);
</script>
