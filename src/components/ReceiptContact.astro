---
---
<section class="receipt-area">
  <div class="perspective-wrapper">
    <p class="press-alert">PRESS ME</p>
    
    <div class="receipt-stack" id="receiptStack">
      <div class="receipt receipt-back" id="receiptBack">
        <div class="paper-texture"></div>
        <div class="receipt-content">
          <p class="receipt-header">SYSTEM_CONTACT_LOG</p>
          <div class="divider"></div>
          <p>INSTAGRAM: @LOVERACHEL</p>
          <p>EMAIL: N/A [ENCRYPTED]</p>
          <p>LOC: 40.7128° N, 74.0060° W</p>
          <div class="divider"></div>
          <p class="receipt-footer">SCAN FOR CLEARANCE</p>
        </div>
      </div>

      <div class="receipt receipt-front" id="receiptFront">
        <div class="paper-texture"></div>
        <div class="receipt-content">
          <p class="receipt-title">RECEIPT: ISSUE NO.01</p>
          <p>DATE: 07.24.06</p>
          <p>REF: RECODING FEMININITY</p>
          <div class="divider"></div>
          <p class="greeting">To whom it may concern,</p>
          <p>
            Submissions for the magazine and front page are always welcomed. 
            The magazine scouts for editorials and stories that define 
            the intersection of style and technical discipline.
          </p>
          <p>
            love, Rachel is an indie fashion magazine featuring girls 
            changing the game in STEM.
          </p>
          <div class="divider"></div>
          <div class="receipt-signature">love, RACHEL</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .receipt-area {
    min-height: 120vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible !important; 
  }

  .perspective-wrapper {
    perspective: 1200px; 
    perspective-origin: 50% 50%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
  }

  .receipt-stack {
    position: relative;
    width: 360px;
    height: 520px;
    transform-style: preserve-3d;
    
  }

  .receipt {
    position: absolute;
    inset: 0;
    padding: 40px;
    color: #1a1a1a;
    background-color: #fcfcfc;
  
    background-image: linear-gradient(to bottom, #ffffff 0%, #f2f2f2 100%);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    border-bottom: 5px dashed #bbb;
    
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    line-height: 1.6;
    
    backface-visibility: hidden;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  
  .paper-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.05;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .receipt-back {
    z-index: 1;
    transform: translateZ(-60px) rotateY(2deg);
  }

  .receipt-front {
    z-index: 10;
    transform: translateZ(60px);
  }

  .divider {
    height: 1px;
    background: #000;
    margin: 15px 0;
    width: 100%;
    opacity: 0.15;
  }

  .receipt-title { font-weight: 800; text-align: center; font-size: 13px; }
  .receipt-signature { font-size: 15px; font-weight: 900; margin-top: 25px; }
  
  .press-alert {
 
    font-size: 10px;

    margin-bottom: 25px;
    letter-spacing: 2px;
    animation: blink 2s infinite;
  }

  @keyframes blink { 0%, 100% { opacity: 0.8; } 50% { opacity: 0.2; } }
</style>

<script>
  import { gsap } from 'gsap';

  const initReceipt = () => {
    const stack = document.querySelector('#receiptStack');
    const front = document.querySelector('#receiptFront');
    const back = document.querySelector('#receiptBack');

    if (!stack || !front || !back) return;

    // Reset initial positions
    gsap.set(front, { z: 60, rotationY: 0, rotationX: 0, opacity: 1 });
    gsap.set(back, { z: -60, filter: "brightness(0.7)" });

    const tl = gsap.timeline({ 
      paused: true,
      defaults: { ease: "expo.inOut" }
    });

    tl.to(front, {
      duration: 1.6,
      z: -5000,        // Way back into the stars
      y: -1200,        // Shoots up
      x: 400,          // Drifts right
      rotationX: 360,  // Full 3D tumble
      rotationY: 90,
      opacity: 0,
      force3D: true    // Forces hardware acceleration
    })
    .to(back, {
      duration: 1.2,
      z: 0,
      filter: "brightness(1)",
      rotateY: 0,
      ease: "expo.out"
    }, "-=1.2");

    stack.addEventListener('mouseenter', () => tl.play());
    stack.addEventListener('mouseleave', () => tl.reverse());

   
    stack.addEventListener('mousemove', (e) => {
      if (tl.progress() > 0.1 && tl.progress() < 0.9) return;

      const rect = stack.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      if (tl.progress() === 0) {
        gsap.to(front, {
          duration: 0.5,
          rotateY: x * 20,
          rotateX: -y * 20,
          overwrite: "auto"
        });
      } else {
        gsap.to(back, {
          duration: 0.5,
          rotateY: x * 15,
          rotateX: -y * 15,
          overwrite: "auto"
        });
      }
    });
  };

  initReceipt();
  document.addEventListener('astro:after-swap', initReceipt);
</script>
