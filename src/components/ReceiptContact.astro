---
---
<section class="premium-container">
  <div class="glass-perspective">
    <div class="status-indicator">
      <span class="dot"></span> SYSTEM_READY
    </div>

    <div class="glass-stack" id="mainStack">
      <div class="glass-card glass-back" id="cardBack">
        <div class="shimmer"></div>
        <div class="card-content">
          <h2 class="title">CONNECT</h2>
          <div class="content-grid">
            <div class="grid-item"><span>IG</span>@LOVERACHEL</div>
            <div class="grid-item"><span>LOC</span>NYC_40.7128° N</div>
            <div class="grid-item"><span>REF</span>ISSUE_01</div>
          </div>
        </div>
      </div>

      <div class="glass-card glass-front" id="cardFront">
        <div class="shimmer"></div>
        <div class="card-content">
          <div class="top-bar">
            <span class="serial">#07-24-06</span>
            <span class="brand">love, RACHEL</span>
          </div>
          
          <div class="main-body">
            <p class="abstract">
              RECODING THE FEMININE ARCHETYPE THROUGH THE LENS OF TECHNICAL DISCIPLINE. 
            </p>
            <p class="instruction">
              AN INDIE FASHION DISCOURSE FEATURING WOMEN IN STEM.
            </p>
          </div>

          <div class="bottom-bar">
            <div class="scanline"></div>
            <span>STRICTLY FOR INTERNAL USE</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .premium-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  .glass-perspective {
    perspective: 2000px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .glass-stack {
    position: relative;
    width: 400px;
    height: 260px; 
    transform-style: preserve-3d;
    cursor: pointer;
  }

  .glass-card {
    position: absolute;
    inset: 0;
    padding: 30px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #fff;
    font-family: 'Fira Code', monospace;
    overflow: hidden;
    backface-visibility: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .glass-front {
    z-index: 2;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 100%);
  }

  .glass-back {
    z-index: 1;
    transform: translateZ(-50px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  
  .shimmer {
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: linear-gradient(
      45deg,
      transparent 0%,
      rgba(255, 255, 255, 0.05) 45%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0.05) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Typography */
  .top-bar { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: 2px; margin-bottom: 40px; opacity: 0.7; }
  .main-body { margin-bottom: 40px; }
  .abstract { font-size: 14px; line-height: 1.4; font-weight: 500; margin-bottom: 15px; }
  .instruction { font-size: 10px; opacity: 0.5; text-transform: uppercase; letter-spacing: 1px; }
  
  .bottom-bar { 
    position: absolute; 
    bottom: 25px; 
    left: 30px; right: 30px; 
    font-size: 9px; 
    letter-spacing: 3px; 
    opacity: 0.3; 
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .scanline { width: 100%; height: 1px; background: #fff; opacity: 0.2; }

  .title { font-size: 32px; font-weight: 900; letter-spacing: -2px; margin-bottom: 20px; }
  .content-grid { display: flex; flex-direction: column; gap: 10px; font-size: 11px; }
  .grid-item span { opacity: 0.4; margin-right: 15px; width: 40px; display: inline-block; }

  /* Status Indicator */
  .status-indicator {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: #fff;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0.6;
  }

  .dot { width: 6px; height: 6px; background: #00ff88; border-radius: 50%; box-shadow: 0 0 10px #00ff88; }
</style>

<script>
  import { gsap } from 'gsap';

  const initGlassCard = () => {
    const stack = document.querySelector('#mainStack');
    const front = document.querySelector('#cardFront');
    const back = document.querySelector('#cardBack');
    const shimmers = document.querySelectorAll('.shimmer');

    if (!stack) return;

    const tl = gsap.timeline({ paused: true });

   
    tl.to(front, {
      duration: 1,
      x: 600,
      rotationY: 45,
      rotationZ: 10,
      opacity: 0,
      scale: 0.8,
      filter: "blur(10px)",
      ease: "power4.inOut"
    })
    .fromTo(back, 
      { z: -50, opacity: 0, scale: 0.9 },
      { duration: 0.8, z: 0, opacity: 1, scale: 1, ease: "expo.out" },
      "-=0.6"
    );

    stack.addEventListener('click', () => {
      if (tl.progress() === 0) tl.play();
      else tl.reverse();
    });


    window.addEventListener('mousemove', (e) => {
      const rect = stack.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      // Card Tilt
      gsap.to(stack, {
        duration: 1,
        rotateY: x * 30,
        rotateX: -y * 30,
        ease: "power2.out"
      });

      
      shimmers.forEach(s => {
        gsap.to(s, {
          duration: 1,
          x: x * 100,
          y: y * 100,
          ease: "power2.out"
        });
      });
    });
  };

  initGlassCard();
</script>
