<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000000, 0.003);
  
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.3, 0.9, 0.15);
  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);

  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(100, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

  const createNebulaTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(100, 150, 255, 0.6)');
    gradient.addColorStop(0.5, 'rgba(200, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.filter = 'blur(10px)';
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

  const starTex = createStarTexture();
  const nebulaTex = createNebulaTexture();

  const starCount = 20000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff), new THREE.Color(0xffead4)];

  for(let i = 0; i < starCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 400;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 400;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 1000;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r; colors[i * 3 + 1] = col.g; colors[i * 3 + 2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const material = new THREE.PointsMaterial({
    size: 0.35, map: starTex, transparent: true, blending: THREE.AdditiveBlending,
    depthWrite: false, vertexColors: true, opacity: 1
  });
  const stars = new THREE.Points(geometry, material);
  scene.add(stars);

  const nebulaCount = 40;
  const nGeometry = new THREE.BufferGeometry();
  const nPositions = new Float32Array(nebulaCount * 3);
  for(let i = 0; i < nebulaCount * 3; i++) nPositions[i] = (Math.random() - 0.5) * 800;
  nGeometry.setAttribute('position', new THREE.BufferAttribute(nPositions, 3));
  const nMaterial = new THREE.PointsMaterial({
    size: 150, map: nebulaTex, transparent: true, blending: THREE.AdditiveBlending,
    depthWrite: false, opacity: 0.05
  });
  const nebula = new THREE.Points(nGeometry, nMaterial);
  scene.add(nebula);

  const cursor = document.getElementById('custom-cursor');
  const flare = cursor.querySelector('.cursor-glare');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY;
  let scrollVel = 0, lastScroll = window.scrollY;
  let mouse3D = new THREE.Vector3();

  window.addEventListener('mousemove', (e) => { mX = e.clientX; mY = e.clientY; });
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    const rawVel = Math.abs(currentScroll - lastScroll);
    scrollVel = Math.min(rawVel, 100); 
    lastScroll = currentScroll;
  });

  function animate() {
    requestAnimationFrame(animate);
    const posAttrib = stars.geometry.attributes.position;
    
    // Convert 2D Mouse to 3D for starfield interaction
    mouse3D.set((mX / window.innerWidth) * 2 - 1, -(mY / window.innerHeight) * 2 + 1, 0.5);
    mouse3D.unproject(camera);
    let dir = mouse3D.sub(camera.position).normalize();
    let distance = -camera.position.z / dir.z;
    let cursor3D = camera.position.clone().add(dir.multiplyScalar(distance));

    // Calculate speed based on scroll velocity
    const diveSpeed = 0.5 + (scrollVel * 0.2);

    for (let i = 0; i < starCount; i++) {
      let x = posAttrib.getX(i);
      let y = posAttrib.getY(i);
      let z = posAttrib.getZ(i);

      z += diveSpeed; 
      
      // Reset logic for infinite dive
      if (z > 100) {
        z = -900;
        x = (Math.random() - 0.5) * 400;
        y = (Math.random() - 0.5) * 400;
      }

      // Star repulsion from cursor core
      const dx = x - cursor3D.x;
      const dy = y - cursor3D.y;
      const distSq = dx * dx + dy * dy;
      if (distSq < 600) {
        const force = (600 - distSq) / 600;
        x += dx * force * 0.05;
        y += dy * force * 0.05;
      }

      posAttrib.setXYZ(i, x, y, z);
    }
    posAttrib.needsUpdate = true;

    // Nebula movement
    nebula.position.z += (diveSpeed * 0.1);
    if(nebula.position.z > 200) nebula.position.z = -400;

    // Warp Field of View effect
    const targetFOV = 60 + Math.min(scrollVel * 0.8, 50);
    camera.fov += (targetFOV - camera.fov) * 0.1;
    camera.updateProjectionMatrix();

    // Custom Cursor Logic
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;
    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      const scaleX = 1 + (velocity / 120);
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${scaleX})`;
      if (flare) {
        flare.style.opacity = Math.min(1, 0.4 + (velocity / 200)).toString();
        flare.style.transform = `scale(${1 + velocity / 150})`;
      }
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.2" : "1";
    }

    scrollVel *= 0.9;
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1;
    background: #000;
  }
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    will-change: transform;
    transform-origin: right center;
    mix-blend-mode: screen;
    transition: opacity 0.3s ease;
  }
  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(0, 140, 255, 0.3);
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute;
    right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.4) 30%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }
  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(100, 200, 255, 0.4) 20%, rgba(0, 100, 255, 0.1) 50%, transparent 80%);
    border-radius: 50%;
    filter: blur(4px);
    mix-blend-mode: screen;
    z-index: 1;
    pointer-events: none;
  }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @keyframes pulse-glow { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.3); opacity: 1; } }
  .content-overlay { pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }
</style>
