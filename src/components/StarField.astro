---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- CONFIG ---
  const STAR_TOTAL = 30000; // Massively increased
  const CURSOR_INFLUENCE_RADIUS = 6;
  const CURSOR_PUSH_STRENGTH = 0.5;

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);


  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');


    ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(64, 20); ctx.lineTo(64, 108); // Vertical
    ctx.moveTo(20, 64); ctx.lineTo(108, 64); // Horizontal
    ctx.stroke();

    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 40);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(180, 220, 255, 0.3)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(64, 64, 40, 0, Math.PI * 2);
    ctx.fill();
    
    return new THREE.CanvasTexture(canvas);
  };

  const starTexture = createStarTexture();

  // --- MULTI-LAYER STAR ENGINE ---
  const createStarLayer = (count, zBound, sizeRange) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const initialPos = new Float32Array(count * 3);
    
    for(let i = 0; i < count * 3; i+=3) {
      const x = (Math.random() - 0.5) * 250;
      const y = (Math.random() - 0.5) * 200;
      const z = (Math.random() - 0.5) * zBound;
      positions[i] = x; positions[i+1] = y; positions[i+2] = z;
      initialPos[i] = x; initialPos[i+1] = y; initialPos[i+2] = z;
    }
    
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const material = new THREE.PointsMaterial({
      size: Math.random() * sizeRange + 0.1,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      opacity: Math.random() * 0.5 + 0.5
    });

    return { mesh: new THREE.Points(geometry, material), initialPos };
  };

  const layers = [
    createStarLayer(STAR_TOTAL * 0.6, 150, 0.3), // Far
    createStarLayer(STAR_TOTAL * 0.3, 80, 0.5),  // Mid
    createStarLayer(STAR_TOTAL * 0.1, 40, 0.8)   // Near
  ];
  layers.forEach(l => scene.add(l.mesh));

  layers.forEach((l, index) => {
    gsap.to(l.mesh.rotation, {
      x: 0.5 + (index * 0.2),
      y: 0.8 + (index * 0.3),
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        scrub: 1 + index,
      }
    });
  });

  
  const cursor = document.getElementById('custom-cursor');
  let mouse = new THREE.Vector2(-100, -100);
  let raycaster = new THREE.Raycaster();
  let mX = 0, mY = 0, pX = 0, pY = 0;

  window.addEventListener('mousemove', (e) => {
    mX = e.clientX; mY = e.clientY;
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

   
    raycaster.setFromCamera(mouse, camera);
    const intersectPoint = new THREE.Vector3();
    raycaster.ray.at(25, intersectPoint);

    layers.forEach(layer => {
      const pos = layer.mesh.geometry.attributes.position.array;
      const init = layer.initialPos;
      for (let i = 0; i < pos.length; i += 3) {
        const dx = pos[i] - intersectPoint.x;
        const dy = pos[i+1] - intersectPoint.y;
        const dist = Math.sqrt(dx*dx + dy*dy);

        if (dist < CURSOR_INFLUENCE_RADIUS) {
          const force = (CURSOR_INFLUENCE_RADIUS - dist) / CURSOR_INFLUENCE_RADIUS;
          pos[i] += dx * force * CURSOR_PUSH_STRENGTH;
          pos[i+1] += dy * force * CURSOR_PUSH_STRENGTH;
        } else {
          pos[i] += (init[i] - pos[i]) * 0.03;
          pos[i+1] += (init[i+1] - pos[i+1]) * 0.03;
        }
      }
      layer.mesh.geometry.attributes.position.needsUpdate = true;
      layer.mesh.rotation.y += 0.0002 * (layers.indexOf(layer) + 1);
     
      layer.mesh.material.opacity = 0.6 + Math.sin(time + layers.indexOf(layer)) * 0.2;
    });

    
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const vel = Math.sqrt(dx*dx + dy*dy);
      const stretch = 1 + (vel / 100);

     
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${stretch})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        glare.style.opacity = Math.min(1, 0.4 + (vel / 200)).toString();
        glare.style.transform = `scale(${1 + vel / 150})`;
      }
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.2" : "1";
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: #000;
    pointer-events: none;
  }

 
  #star-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);
    pointer-events: none;
  }

  /* REINSTATED: Your Original Cursor Architecture */
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.3s ease;
  }

  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 
      0 0 5px #fff, 
      0 0 10px #fff, 
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 30px rgba(0, 140, 255, 0.3); 
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; height: 4px; 
    background: linear-gradient(to left, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(255, 255, 255, 0.4) 30%, 
      transparent 100%
    );
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(
      circle, 
      rgba(255, 255, 255, 0.9) 0%, 
      rgba(100, 200, 255, 0.4) 20%, 
      rgba(0, 100, 255, 0.1) 50%, 
      transparent 80%
    );
    border-radius: 50%;
    filter: blur(4px); 
    mix-blend-mode: screen; 
    z-index: 1;
    pointer-events: none;
  }

  @media (pointer: fine) { 
    body, a, button { cursor: none !important; } 
  }
  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.3); opacity: 1; }
  }
</style>
