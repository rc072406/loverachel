---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 15;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  // --- STAR TEXTURE CREATION ---
  const createGlowTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(canvas);
  };

  // --- STAR GENERATION ---
  const particlesGeometry = new THREE.BufferGeometry();
  const count = 5000;
  const positions = new Float32Array(count * 3);

  for(let i = 0; i < count * 3; i+=3) { 
    // Spreading stars in a large "frustum" in front of camera
    positions[i] = (Math.random() - 0.5) * 100;     // X
    positions[i+1] = (Math.random() - 0.5) * 100;   // Y
    positions[i+2] = (Math.random() * 60) - 40;     // Z
  }
  particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  const stars = new THREE.Points(particlesGeometry, new THREE.PointsMaterial({
    size: 0.25, 
    map: createGlowTexture(),
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    opacity: 1
  }));
  scene.add(stars);

  // --- SCROLL ANIMATION ---
  gsap.to(stars.rotation, {
    x: 0.4,
    y: 0.6,
    scrollTrigger: {
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      scrub: 1.5,
    }
  });

  // --- SHOOTING STAR PHYSICS ---
  const cursor = document.getElementById('custom-cursor');
  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  let posX = mouseX;
  let posY = mouseY;

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });


function animate() {
  requestAnimationFrame(animate);
  
  stars.rotation.y += 0.0005;

  const dt = 0.15; 
  const dx_m = mouseX - posX;
  const dy_m = mouseY - posY;
  posX += dx_m * dt;
  posY += dy_m * dt;

  if (cursor) {
    const angle = Math.atan2(dy_m, dx_m) * (180 / Math.PI);
    const velocity = Math.sqrt(dx_m * dx_m + dy_m * dy_m);
    const scale = 1 + (velocity / 120);

    cursor.style.transform = `translate3d(${posX - 100}px, ${posY - 10}px, 0) rotate(${angle}deg) scaleX(${scale})`;

    // Star Interaction Logic
    const vector = new THREE.Vector3(
      (mouseX / window.innerWidth) * 2 - 1,
      -(mouseY / window.innerHeight) * 2 + 1,
      0.5
    );
    vector.unproject(camera);
    const dir = vector.sub(camera.position).normalize();
    const distance = -camera.position.z / dir.z;
    const mouse3D = camera.position.clone().add(dir.multiplyScalar(distance));

    const positions = stars.geometry.attributes.position.array;
    for (let i = 0; i < count * 3; i += 3) {
      const x = positions[i];
      const y = positions[i+1];
      const dx = mouse3D.x - x;
      const dy = mouse3D.y - y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      if (dist < 3) { 
        const force = (3 - dist) / 3;
        positions[i] -= dx * force * 0.05; 
        positions[i+1] -= dy * force * 0.05;
      }
    }
    stars.geometry.attributes.position.needsUpdate = true;
  }
  renderer.render(scene, camera);
}
  // --- RESPONSIVE RESIZE ---
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  /* 1. The Star Canvas Container */
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    pointer-events: none;
    background: #000;
  }

 

/* 4. The Shooting Star Cursor */
#custom-cursor {
  position: fixed;
  top: 0;
  left: 0;
  width: 100px; 
  height: 20px;
  pointer-events: none !important; 
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: flex-end; 
  will-change: transform;
  transform-origin: right center; 
  mix-blend-mode: screen; 
  transition: opacity 0.3s ease;
}

.cursor-core {
  
  width: 2px; 
  height: 2px;
  background: #fff;
  border-radius: 50%;
  
  box-shadow: 
    0 0 5px #fff, 
    0 0 10px #fff, 
    0 0 20px rgba(255, 255, 255, 0.8),
    0 0 30px rgba(0, 140, 255, 0.3); 
  z-index: 2;
animation: pulse-glow 1.5s infinite alternate;
}

.cursor-tail {
  position: absolute;
  right: 0;
  width: 80px; 
  height: 4px; 
  background: linear-gradient(to left, 
    rgba(255, 255, 255, 1) 0%, 
    rgba(255, 255, 255, 0.4) 30%, 
    transparent 100%
  ); 
  
  clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
  filter: blur(1px) contrast(1.2); 
  transition: width 0.2s ease-out;
  opacity: 0.8;
}

  /* Hide default cursor only on desktops */
  @media (pointer: fine) { 
    body, a, button, .hero-section { cursor: none !important; } 
  }
  
  /* Disable custom cursor on mobile to save battery/prevent lag */
  @media (pointer: coarse) { 
    #custom-cursor { display: none; } 
  }

a, button, [role="button"], .menu-item {
  position: relative;
  z-index: 100001; 
  pointer-events: auto !important;
}


.content-overlay {
  pointer-events: none;
}

.content-overlay > * {
  pointer-events: auto;
}


.cursor-glare {
  position: absolute;
  right: -20px; 
  width: 60px;
  height: 60px;

  background: radial-gradient(
    circle, 
    rgba(255, 255, 255, 0.9) 0%, 
    rgba(100, 200, 255, 0.4) 20%, 
    rgba(0, 100, 255, 0.1) 50%, 
    transparent 80%
  );
  border-radius: 50%;
  filter: blur(4px); 
  mix-blend-mode: screen; 
  z-index: 1;
  pointer-events: none;
}




@keyframes pulse-glow {
  from { transform: scale(1); opacity: 0.8; }
  to { transform: scale(1.3); opacity: 1; }
}
</style>
