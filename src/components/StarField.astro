---
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000000, 0.005);
  
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.3, 0.9, 0.15);
  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);


  const starCount = 40000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff), new THREE.Color(0xffead4)];

  for(let i = 0; i < starCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 600; 
    positions[i * 3 + 1] = (Math.random() - 0.5) * 600;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 1200;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r; colors[i * 3 + 1] = col.g; colors[i * 3 + 2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const material = new THREE.PointsMaterial({
    size: 0.35, map: createStarTexture(), transparent: true, blending: THREE.AdditiveBlending,
    depthWrite: false, vertexColors: true, opacity: 1
  });
  const stars = new THREE.Points(geometry, material);
  scene.add(stars);

  // --- Nebula Construction (50 count) ---
  const nebulaCount = 50;
  const nGeometry = new THREE.BufferGeometry();
  const nPositions = new Float32Array(nebulaCount * 3);
  for(let i = 0; i < nebulaCount * 3; i++) nPositions[i] = (Math.random() - 0.5) * 1000;
  nGeometry.setAttribute('position', new THREE.BufferAttribute(nPositions, 3));
  const nebula = new THREE.Points(nGeometry, new THREE.PointsMaterial({
    size: 200, map: createNebulaTexture(), transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.06
  }));
  scene.add(nebula);

  // --- GSAP INTERACTION LOGIC ---
  // 1. Galaxy Rotation on Scroll
  gsap.to(stars.rotation, {
    x: 0.8, y: 1.2,
    scrollTrigger: {
      trigger: "body", start: "top top", end: "bottom bottom", scrub: 2
    }
  });

  // 2. Camera Tilt on Mouse Move (Organic Parallax)
  window.addEventListener('mousemove', (e) => {
    const x = (e.clientX / window.innerWidth) - 0.5;
    const y = (e.clientY / window.innerHeight) - 0.5;
    gsap.to(camera.rotation, {
      x: -y * 0.1, y: -x * 0.1, duration: 1.5, ease: "power2.out"
    });
  });

  // --- Variables for Animation Loop ---
  let scrollVel = 0;
  let lastScroll = window.scrollY;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    scrollVel = Math.min(Math.abs(currentScroll - lastScroll), 100);
    lastScroll = currentScroll;
  });

  function animate() {
    requestAnimationFrame(animate);
    const posAttrib = stars.geometry.attributes.position;
    const diveSpeed = 0.6 + (scrollVel * 0.3);

    for (let i = 0; i < starCount; i++) {
      let z = posAttrib.getZ(i) + diveSpeed;
      if (z > 100) z = -1100;
      posAttrib.setZ(i, z);
    }
    posAttrib.needsUpdate = true;
    
    // Smoothly decay scroll speed back to cruise
    scrollVel *= 0.92;

   
    updateCursor();
    
    composer.render();
  }
  

  animate();
</script>

<style is:global>

  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1;
    background: #000;
  }
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    will-change: transform;
    transform-origin: right center;
    mix-blend-mode: screen;
    transition: opacity 0.3s ease;
  }
  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 
      0 0 5px #fff,
      0 0 10px #fff,
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 30px rgba(0, 140, 255, 0.3);
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute;
    right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(255, 255, 255, 0.4) 30%, 
      transparent 100%
    );
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }
  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(
      circle, 
      rgba(255, 255, 255, 0.9) 0%, 
      rgba(100, 200, 255, 0.4) 20%, 
      rgba(0, 100, 255, 0.1) 50%, 
      transparent 80%
    );
    border-radius: 50%;
    filter: blur(4px);
    mix-blend-mode: screen;
    z-index: 1;
    pointer-events: none;
  }
  @media (pointer: fine) { body, a, button, .hero-section { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
  .content-overlay { pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }
  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.3); opacity: 1; }
  }
</style>
