<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glow"></div>
  <div class="cursor-star"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000103);
  scene.fog = new THREE.FogExp2(0x000103, 0.002);
  
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 3000);
  camera.position.z = 100;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.8, 0.5, 0.9);
  composer.addPass(bloomPass);

  const starTex = new THREE.TextureLoader().load('https://assets.codepen.io/127738/dot-texture.png');

  const stages = [
    { z: 0, color: 0x4488ff, name: "The Blue Lagoon" },
    { z: -1200, color: 0xffaa44, name: "Golden Corridor" },
    { z: -2400, color: 0xff44aa, name: "Nebula Core" },
    { z: -3600, color: 0x44ffaa, name: "Emerald Deep" }
  ];

  const stageGroups = [];

  stages.forEach((stage, idx) => {
    const group = new THREE.Group();
    const count = 12000;
    const geometry = new THREE.BufferGeometry();
    const pos = new Float32Array(count * 3);
    const cols = new Float32Array(count * 3);
    const color = new THREE.Color(stage.color);

    for (let i = 0; i < count; i++) {
      // Create a "Tunnel" shape using polar coordinates
      const radius = 10 + Math.random() * 150;
      const angle = Math.random() * Math.PI * 2;
      const x = Math.cos(angle) * radius;
      const y = Math.sin(angle) * radius;
      const z = stage.z + (Math.random() - 0.5) * 1200;

      pos[i * 3] = x;
      pos[i * 3 + 1] = y;
      pos[i * 3 + 2] = z;

      cols[i * 3] = color.r + (Math.random() - 0.5) * 0.3;
      cols[i * 3 + 1] = color.g + (Math.random() - 0.5) * 0.3;
      cols[i * 3 + 2] = color.b + (Math.random() - 0.5) * 0.3;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(cols, 3));

    const points = new THREE.Points(geometry, new THREE.PointsMaterial({
      size: 1.2,
      map: starTex,
      transparent: true,
      blending: THREE.AdditiveBlending,
      vertexColors: true,
      depthWrite: false,
      sizeAttenuation: true
    }));

    group.add(points);
    scene.add(group);
    stageGroups.push({ group, baseZ: stage.z });
  });

  let scrollVelocity = 0;
  let targetScroll = 0;

  ScrollTrigger.create({
    trigger: "body",
    start: "top top",
    end: "bottom bottom",
    onUpdate: (self) => {
      scrollVelocity = self.getVelocity() / 100;
      targetScroll = self.progress * -3600; // Total depth of stages
    }
  });

  let currentCameraZ = 100;
  let mX = 0, mY = 0, pX = 0, pY = 0;

  window.addEventListener('mousemove', (e) => {
    mX = (e.clientX / window.innerWidth - 0.5) * 20;
    mY = (e.clientY / window.innerHeight - 0.5) * 20;
  });

  function animate() {
    requestAnimationFrame(animate);

    // Smooth scroll following
    currentCameraZ += (targetScroll - currentCameraZ) * 0.05;
    camera.position.z = currentCameraZ + 100;

    // Camera FOV Warp based on speed
    const speed = Math.abs(scrollVelocity);
    camera.fov += (60 + (speed * 2) - camera.fov) * 0.1;
    camera.updateProjectionMatrix();

    // Mouse movement influence
    camera.position.x += (-mX - camera.position.x) * 0.05;
    camera.position.y += (mY - camera.position.y) * 0.05;
    camera.lookAt(0, 0, camera.position.z - 200);

    // Render
    composer.render();

    // Cursor smoothing
    pX += (mX * 50 - pX) * 0.1; // mapping back to screen space roughly
    pY += (mY * 50 - pY) * 0.1;
    const cursor = document.getElementById('custom-cursor');
    if (cursor) {
      cursor.style.transform = `translate3d(${window.innerWidth/2 + pX}px, ${window.innerHeight/2 + pY}px, 0)`;
    }
    
    scrollVelocity *= 0.9; // Friction
  }

  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; background: #000; }
  #custom-cursor {
    position: fixed; top: 0; left: 0; width: 24px; height: 24px; margin-left: -12px; margin-top: -12px;
    pointer-events: none !important; z-index: 100000; mix-blend-mode: screen; will-change: transform;
  }
  .cursor-star {
    width: 4px; height: 4px; background: #fff; border-radius: 50%;
    box-shadow: 0 0 10px #fff, 0 0 20px #4488ff;
  }
  .cursor-glow {
    position: absolute; top: 50%; left: 50%; width: 120px; height: 120px;
    background: radial-gradient(circle, rgba(68, 136, 255, 0.15) 0%, transparent 70%);
    transform: translate(-50%, -50%); filter: blur(15px);
  }
  body { height: 500vh; margin: 0; overflow-x: hidden; background: #000; }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
</style>
