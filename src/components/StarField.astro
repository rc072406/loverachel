<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glow"></div>
  <div class="cursor-star"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x020202);
  
  const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 3000);

  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.2, 0.8, 0.95);
  composer.addPass(bloomPass);


  const createPremiumTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
    grad.addColorStop(0.1, 'rgba(212, 175, 55, 0.3)'); // Gold tint
    grad.addColorStop(0.4, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

 
  const path = new THREE.CatmullRomCurve3([
    new THREE.Vector3(0, 0, 200),
    new THREE.Vector3(50, -100, -200),
    new THREE.Vector3(-80, -300, -800),
    new THREE.Vector3(0, -600, -1500), // The Dive
    new THREE.Vector3(0, -800, -2500)  // The Black Hole Location
  ]);


  const bhGeo = new THREE.SphereGeometry(40, 64, 64);
  const bhMat = new THREE.MeshBasicMaterial({ color: 0x000000 });
  const blackHole = new THREE.Mesh(bhGeo, bhMat);
  blackHole.position.set(0, -800, -2600);
  scene.add(blackHole);


  const starCount = 35000;
  const starGeo = new THREE.BufferGeometry();
  const posArr = new Float32Array(starCount * 3);
  const colArr = new Float32Array(starCount * 3);
  const gold = new THREE.Color(0xD4AF37);

  for(let i = 0; i < starCount; i++) {
   
    const t = Math.random();
    const point = path.getPoint(t);
    const angle = Math.random() * Math.PI * 2;
    const radius = 20 + Math.pow(Math.random(), 2) * 200;
    
    posArr[i*3] = point.x + Math.cos(angle) * radius;
    posArr[i*3+1] = point.y + Math.sin(angle) * radius;
    posArr[i*3+2] = point.z;

    const brightness = 0.5 + Math.random() * 0.5;
    colArr[i*3] = gold.r * brightness;
    colArr[i*3+1] = gold.g * brightness;
    colArr[i*3+2] = gold.b * brightness;
  }

  starGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));
  starGeo.setAttribute('color', new THREE.BufferAttribute(colArr, 3));

  const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({
    size: 1.4,
    map: createPremiumTexture(),
    transparent: true,
    blending: THREE.AdditiveBlending,
    vertexColors: true,
    depthWrite: false
  }));
  scene.add(stars);

  // Scroll Orchestration
  let progress = 0;
  ScrollTrigger.create({
    trigger: "body",
    start: "top top",
    end: "bottom bottom",
    scrub: 1,
    onUpdate: (self) => { progress = self.progress; }
  });

  let mX = 0, mY = 0;
  window.addEventListener('mousemove', (e) => {
    mX = (e.clientX / window.innerWidth - 0.5) * 2;
    mY = (e.clientY / window.innerHeight - 0.5) * 2;
  });

  function animate() {
    requestAnimationFrame(animate);

   
    const camPos = path.getPoint(progress);
    const lookAtPos = path.getPoint(Math.min(progress + 0.01, 1));
    
    camera.position.lerp(camPos, 0.1);
    camera.lookAt(lookAtPos);
 
    camera.rotation.z += (mX * 0.05 - camera.rotation.z) * 0.05;
    camera.position.x += mX * 2;

  
    if (progress > 0.8) {
        const pull = (progress - 0.8) * 5;
        camera.fov = 55 + (pull * 40); // Warp speed FOV
        camera.updateProjectionMatrix();
        bloomPass.strength = 1.2 + pull * 2; // Blinded by the light
    } else {
        camera.fov = 55;
        camera.updateProjectionMatrix();
        bloomPass.strength = 1.2;
    }

    composer.render();

    const cursor = document.getElementById('custom-cursor');
    if (cursor) {
      cursor.style.left = `${(mX/2 + 0.5) * window.innerWidth}px`;
      cursor.style.top = `${(mY/2 + 0.5) * window.innerHeight}px`;
    }
  }

  animate();
</script>

<style is:global>
  body { height: 800vh; margin: 0; background: #000; overflow-x: hidden; }
  #star-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; }
  
  #custom-cursor {
    position: fixed; pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%); mix-blend-mode: exclusion;
  }
  .cursor-star { 
    width: 2px; height: 2px; background: #D4AF37; border-radius: 50%; 
    box-shadow: 0 0 15px #D4AF37, 0 0 30px #D4AF37; 
  }
  .cursor-glow {
    position: absolute; width: 40px; height: 40px; 
    background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, transparent 70%);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
</style>
