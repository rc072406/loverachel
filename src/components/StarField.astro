<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
  const container = document.getElementById('star-container');
  

  const starCount = isMobile ? 15000 : 40000;
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 30;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: false, 
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);


  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(
    new THREE.Vector2(window.innerWidth, window.innerHeight), 
    1.5, 0.4, 0.85
  );
  composer.addPass(bloomPass);


  const starMaterial = new THREE.ShaderMaterial({
    uniforms: {
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector3() },
      uScroll: { value: 0 },
      uSize: { value: isMobile ? 2.0 : 3.5 }
    },
    vertexShader: `
      uniform float uTime;
      uniform vec3 uMouse;
      uniform float uScroll;
      uniform float uSize;
      attribute vec3 color;
      varying vec3 vColor;
      varying float vOpacity;

      void main() {
        vColor = color;
        vec3 pos = position;

        
        pos.y = mod(pos.y - uScroll * 0.1 + 100.0, 200.0) - 100.0;
        
       
        float dist = distance(pos.xy, uMouse.xy);
        if(dist < 15.0) {
          float force = (15.0 - dist) / 15.0;
          pos.xy += normalize(pos.xy - uMouse.xy) * force * 2.0;
        }

   
        vOpacity = 0.6 + sin(uTime + position.x) * 0.4;

        vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
        gl_PointSize = uSize * (300.0 / -mvPosition.z);
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      varying float vOpacity;
      void main() {
        float r = distance(gl_PointCoord, vec2(0.5));
        if(r > 0.5) discard;
        float glow = pow(1.0 - r * 2.0, 2.0);
        gl_FragColor = vec4(vColor, glow * vOpacity);
      }
    `,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });

  // 4. Geometry Setup
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const palette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff)];

  for(let i = 0; i < starCount; i++) {
    positions[i*3] = (Math.random() - 0.5) * 200;
    positions[i*3+1] = (Math.random() - 0.5) * 200;
    positions[i*3+2] = (Math.random() - 0.5) * 100;
    const col = palette[Math.floor(Math.random() * palette.length)];
    colors[i*3] = col.r; colors[i*3+1] = col.g; colors[i*3+2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const stars = new THREE.Points(geometry, starMaterial);
  scene.add(stars);


  let mouseX = 0, mouseY = 0, scrollY = 0;
  window.addEventListener('mousemove', (e) => {
    // Convert mouse to world space roughly
    mouseX = (e.clientX / window.innerWidth - 0.5) * 100;
    mouseY = -(e.clientY / window.innerHeight - 0.5) * 100;
  });

  ScrollTrigger.create({
    trigger: "body",
    start: "top top",
    end: "bottom bottom",
    onUpdate: (self) => {
      scrollY = self.scroll();
    }
  });


  const cursor = document.getElementById('custom-cursor');
  let curX = 0, curY = 0;

  function animate() {
    requestAnimationFrame(animate);
    const time = performance.now() * 0.001;
    
    starMaterial.uniforms.uTime.value = time;
    starMaterial.uniforms.uScroll.value = window.scrollY;
    
   
    starMaterial.uniforms.uMouse.value.x += (mouseX - starMaterial.uniforms.uMouse.value.x) * 0.1;
    starMaterial.uniforms.uMouse.value.y += (mouseY - starMaterial.uniforms.uMouse.value.y) * 0.1;


    if (cursor && !isMobile) {
      curX += (window.event?.clientX || 0 - curX) * 0.15;
     
    }

    composer.render();
  }
  animate();


  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { 
    position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
    z-index: -1; background: #000;
    pointer-events: none;
  }
  #custom-cursor {

    position: fixed; top: 0; left: 0; width: 100px; height: 20px;

    pointer-events: none !important; z-index: 100000;

    display: flex; align-items: center; justify-content: flex-end;

    will-change: transform; transform-origin: right center;

    mix-blend-mode: screen; transition: opacity 0.3s ease;

  }

  .cursor-core {

    width: 2px; height: 2px; background: #fff; border-radius: 50%;

    box-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(0, 140, 255, 0.3);

    animation: pulse-glow 1.5s infinite alternate;

  }

  .cursor-tail {

    position: absolute; right: 0; width: 80px; height: 4px;

    background: linear-gradient(to left, #fff 0%, rgba(255, 255, 255, 0.4) 30%, transparent 100%);

    clip-path: polygon(0% 50%, 100% 20%, 100% 80%); filter: blur(0.5px); opacity: 0.8;

  }

  .cursor-glare {

    position: absolute; right: -20px; width: 60px; height: 60px;

    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(100, 200, 255, 0.4) 20%, transparent 80%);

    border-radius: 50%; filter: blur(4px); mix-blend-mode: screen;

  }

  @media (pointer: fine) { body, a, button { cursor: none !important; } }

  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; }

  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.3); opacity: 1; } }

</style> 
