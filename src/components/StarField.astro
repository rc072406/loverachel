---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- CONFIG ---
  const STAR_COUNT = 25000;
  const COLORS = [0xffffff, 0xd4eaff, 0xe5d4ff, 0xffead4];

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  
  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(100, 150, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.beginPath(); ctx.arc(32, 32, 32, 0, Math.PI * 2); ctx.fill();
    return new THREE.CanvasTexture(canvas);
  };

  const starTexture = createStarTexture();

  
  const createLayer = (count, zDepth, baseSize, opacity) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);
    const twinkle = new Float32Array(count); // Custom attribute for per-star shimmer

    for(let i = 0; i < count; i++) {
      const i3 = i * 3;
      positions[i3] = (Math.random() - 0.5) * 200;
      positions[i3+1] = (Math.random() - 0.5) * 200;
      positions[i3+2] = (Math.random() - 0.5) * zDepth;

      const color = new THREE.Color(COLORS[Math.floor(Math.random() * COLORS.length)]);
      colors[i3] = color.r; colors[i3+1] = color.g; colors[i3+2] = color.b;
      twinkle[i] = Math.random() * Math.PI * 2;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({
      size: baseSize,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      vertexColors: true,
      opacity: opacity
    });

    return { mesh: new THREE.Points(geometry, material), twinkle };
  };

  const layer1 = createLayer(STAR_COUNT * 0.7, 180, 0.12, 0.4); 
  const layer2 = createLayer(STAR_COUNT * 0.2, 100, 0.35, 0.8);
  const layer3 = createLayer(STAR_COUNT * 0.1, 50, 0.8, 0.5);
  
  scene.add(layer1.mesh, layer2.mesh, layer3.mesh);

  
  let scrollSpeed = 0;
  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    scrollSpeed = Math.abs(currentScroll - lastScrollY);
    lastScrollY = currentScroll;
  });

  [layer1.mesh, layer2.mesh, layer3.mesh].forEach((layer, i) => {
    gsap.to(layer.rotation, {
      x: 0.3 * (i + 1),
      y: 0.5 * (i + 1),
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        scrub: 2,
      }
    });
  });


  const cursor = document.getElementById('custom-cursor');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY;

  window.addEventListener('mousemove', (e) => {
    mX = e.clientX; mY = e.clientY;
  });

  
  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

   
    camera.position.x += (Math.sin(time * 0.5) * 0.02 - camera.position.x * 0.05);
    camera.position.y += (Math.cos(time * 0.3) * 0.02 - camera.position.y * 0.05);
    camera.lookAt(0, 0, 0);

   
    const targetFOV = 65 + (scrollSpeed * 0.1);
    camera.fov += (targetFOV - camera.fov) * 0.1;
    camera.updateProjectionMatrix();
    scrollSpeed *= 0.9; // Decay scroll speed

   
    [layer1, layer2, layer3].forEach((l, idx) => {
      l.mesh.rotation.y += 0.0002 * (idx + 1);
      // Independent shimmering
      l.mesh.material.opacity = (0.4 + (idx * 0.2)) + Math.sin(time * (1 + idx)) * 0.15;
    });

    
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.12;
    pY += dy * 0.12;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      const scaleX = 1 + (velocity / 100);

      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${scaleX})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        glare.style.opacity = Math.min(1, 0.4 + (velocity / 200)).toString();
        glare.style.transform = `scale(${1 + velocity / 150})`;
      }
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.2" : "1";
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: #000;
    pointer-events: none;
    overflow: hidden;
  }

 
  #star-container::before {
    content: '';
    position: absolute;
    inset: -50%;
    background: 
      radial-gradient(circle at 20% 30%, rgba(30, 40, 80, 0.3) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(50, 20, 60, 0.2) 0%, transparent 40%);
    filter: blur(80px);
    opacity: 0.6;
    animation: nebula-drift 60s infinite alternate ease-in-out;
    pointer-events: none;
  }

  #star-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 20%, rgba(0,0,0,0.9) 100%);
    pointer-events: none;
  }

  @keyframes nebula-drift {
    from { transform: translate(-2%, -2%) rotate(0deg); }
    to { transform: translate(2%, 2%) rotate(5deg); }
  }

  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.3s ease;
  }

  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 5px #fff, 0 0 15px #fff, 0 0 30px rgba(0, 140, 255, 0.5); 
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; height: 4px; 
    background: linear-gradient(to left, #fff 0%, rgba(100, 200, 255, 0.4) 40%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(0, 100, 255, 0.1) 60%, transparent 80%);
    border-radius: 50%;
    filter: blur(6px); 
    mix-blend-mode: screen; 
  }

  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; position: relative; z-index: 10; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.4); opacity: 1; }
  }
</style>
