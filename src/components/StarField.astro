---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 15;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  // --- STAR TEXTURE ---
  const createGlowTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(canvas);
  };

  // --- LAYER GENERATOR ---
  const createStarLayer = (count, size, opacity, spread, zRange) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    for(let i = 0; i < count * 3; i+=3) { 
      positions[i] = (Math.random() - 0.5) * spread;
      positions[i+1] = (Math.random() - 0.5) * spread;
      positions[i+2] = (Math.random() * zRange) - (zRange/2);
    }
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    return new THREE.Points(geometry, new THREE.PointsMaterial({
      size,
      map: createGlowTexture(),
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      opacity
    }));
  };

  const bgStars = createStarLayer(4000, 0.12, 0.4, 120, 60); // Distant, small
  const fgStars = createStarLayer(600, 0.35, 0.7, 80, 40);   // Closer, brighter
  scene.add(bgStars, fgStars);

  // --- PARALLAX SCROLLING ---
  gsap.to(bgStars.rotation, {
    x: 0.2, y: 0.3,
    scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 2 }
  });

  gsap.to(fgStars.rotation, {
    x: 0.5, y: 0.8,
    scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 1 }
  });

  // --- MOUSE & PHYSICS ---
  const cursor = document.getElementById('custom-cursor');
  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  let posX = mouseX;
  let posY = mouseY;

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

 
  window.addEventListener('mousedown', () => {
    gsap.to(cursor, { scale: 0.7, duration: 0.15 });
    gsap.to(fgStars.material, { opacity: 1, duration: 0.2 });
  });
  window.addEventListener('mouseup', () => {
    gsap.to(cursor, { scale: 1, duration: 0.4, ease: "back.out(2)" });
    gsap.to(fgStars.material, { opacity: 0.7, duration: 0.8 });
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;
    
   
    bgStars.rotation.y += 0.0002;
   
    fgStars.material.opacity = 0.5 + Math.sin(time * 1.5) * 0.2;

    
    const dt = 0.15; 
    const dx = mouseX - posX;
    const dy = mouseY - posY;
    posX += dx * dt;
    posY += dy * dt;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      
  
      const stretch = 1 + (velocity / 120);
      const squeeze = 1 - Math.min(0.4, velocity / 180);

      cursor.style.transform = `translate3d(${posX - 100}px, ${posY - 10}px, 0) rotate(${angle}deg) scale(${stretch}, ${squeeze})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        const glareIntensity = Math.min(1, 0.4 + (velocity / 200));
        glare.style.opacity = glareIntensity.toString();
        glare.style.transform = `scale(${1 + velocity / 150}) translateX(${-velocity/4}px)`;
      }

    
      cursor.style.opacity = (mouseY > window.innerHeight - 80) ? "0.2" : "1";
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    pointer-events: none;
    background: radial-gradient(circle at center, #050a15 0%, #000 100%);
  }


  #star-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 40%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
  }

  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; 
    height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: plus-lighter; 
    transition: opacity 0.3s ease;
    filter: drop-shadow(0 0 8px rgba(100, 200, 255, 0.4));
  }

  .cursor-core {
    width: 2px; 
    height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 10px #fff, 0 0 20px #fff;
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 90px; 
    height: 2px; 
    background: linear-gradient(to left, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(100, 200, 255, 0.5) 40%, 
      transparent 100%
    );
    clip-path: polygon(0% 50%, 100% 0%, 100% 100%);
    filter: blur(0.5px);
    opacity: 0.7;
  }

  .cursor-glare {
    position: absolute;
    right: -25px; 
    width: 60px; height: 60px;
    background: radial-gradient(circle, 
      rgba(255, 255, 255, 0.8) 0%, 
      rgba(0, 150, 255, 0.2) 40%, 
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(6px); 
    z-index: 1;
  }

  @media (pointer: fine) { 
    body, a, button, .hero-section { cursor: none !important; } 
  }
  
  @media (pointer: coarse) { 
    #custom-cursor { display: none; } 
  }

  .content-overlay {
    pointer-events: none;
    position: relative;
    z-index: 10;
  }

  .content-overlay > * {
    pointer-events: auto;
  }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(1.4); opacity: 1; }
  }
</style>
