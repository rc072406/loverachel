<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glow"></div>
  <div class="cursor-star"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- Scene Setup (Your perfect starfield logic preserved) ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000000, 0.005);
  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 5;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  composer.addPass(new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.8, 0.4, 0.85));

  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(180, 220, 255, 0.6)'); 
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

  const starCount = 20000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [new THREE.Color(0xffffff), new THREE.Color(0xd4eaff), new THREE.Color(0xffead4), new THREE.Color(0xf0d9ff)];

  for(let i = 0; i < starCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 150;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 150;
    positions[i * 3 + 2] = Math.random() * -800; 
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r; colors[i * 3 + 1] = col.g; colors[i * 3 + 2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const stars = new THREE.Points(geometry, new THREE.PointsMaterial({ size: 0.5, map: createStarTexture(), transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, vertexColors: true, opacity: 0.8 }));
  scene.add(stars);

  let currentVelocity = 0.4, targetVelocity = 0.4;
  ScrollTrigger.create({ trigger: "body", start: "top top", end: "bottom bottom", onUpdate: (self) => { targetVelocity = 0.4 + (self.getVelocity() / 300); }});

  // --- NEW NATURAL CURSOR LOGIC ---
  const cursor = document.getElementById('custom-cursor');
  const glow = cursor.querySelector('.cursor-glow');
  const star = cursor.querySelector('.cursor-star');
  
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY; // Position for smoothing

  window.addEventListener('mousemove', (e) => { mX = e.clientX; mY = e.clientY; });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

    // Background stars update
    currentVelocity += (targetVelocity - currentVelocity) * 0.05;
    const posArray = stars.geometry.attributes.position.array;
    for (let i = 0; i < starCount; i++) {
      posArray[i * 3 + 2] += currentVelocity;
      if (currentVelocity > 0 && posArray[i * 3 + 2] > 15) posArray[i * 3 + 2] = -800;
      else if (currentVelocity < 0 && posArray[i * 3 + 2] < -800) posArray[i * 3 + 2] = 15;
    }
    stars.geometry.attributes.position.needsUpdate = true;
    stars.material.opacity = 0.8 + Math.sin(time) * 0.1;

    // Camera sway
    camera.position.x += (mX / window.innerWidth - 0.5) * 0.8 - camera.position.x * 0.04;
    camera.position.y += -(mY / window.innerHeight - 0.5) * 0.8 - camera.position.y * 0.04;
    camera.lookAt(0, 0, -20);

    // Natural Cursor Physics
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.2; // Increase "stiffness" slightly for more control
    pY += dy * 0.2;

    const speed = Math.sqrt(dx * dx + dy * dy);
    const angle = Math.atan2(dy, dx) * (180 / Math.PI);

    // Dynamic Visuals
    // 1. Scale the core based on movement (stretching)
    const stretch = 1 + Math.min(speed / 40, 3); 
    // 2. Blur based on speed (simulating motion blur)
    const blur = Math.min(speed / 10, 4);

    if (cursor) {
      cursor.style.transform = `translate3d(${pX}px, ${pY}px, 0) rotate(${angle}deg)`;
      
      // The "Star" elongates and blurs naturally
      star.style.transform = `scale(${stretch}, ${1 / Math.sqrt(stretch)})`;
      star.style.filter = `blur(${blur}px)`;
      
      // The "Glow" follows and expands/contracts
      glow.style.transform = `scale(${1 + speed / 60})`;
      glow.style.opacity = 0.3 + Math.min(speed / 100, 0.5);
    }

    targetVelocity += (0.4 - targetVelocity) * 0.02;
    composer.render();
  }

  animate();
</script>

<style is:global>
  #star-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; background: #000; }
  
  #custom-cursor {
    position: fixed; top: 0; left: 0;
    width: 20px; height: 20px;
    margin-left: -10px; margin-top: -10px;
    pointer-events: none !important; z-index: 100000;
    mix-blend-mode: screen;
    will-change: transform;
    display: flex; align-items: center; justify-content: center;
  }

  .cursor-star {
    width: 8px; height: 8px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 10px #fff, 0 0 20px #70baff;
    z-index: 2;
    transition: transform 0.1s ease-out; /* Makes the stretch feel organic */
  }

  .cursor-glow {
    position: absolute;
    width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, rgba(0, 100, 255, 0.1) 40%, transparent 70%);
    border-radius: 50%;
    filter: blur(8px);
    z-index: 1;
    will-change: transform, opacity;
  }

  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
</style>
