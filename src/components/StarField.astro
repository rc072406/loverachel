<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.3, 0.9, 0.15);
  composer.addPass(bloomPass);

  const createTex = (isStar) => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(64,64,0,64,64,64);
    if(isStar) {
      grad.addColorStop(0, 'white'); grad.addColorStop(0.2, 'rgba(255,255,255,0.8)');
      grad.addColorStop(0.5, 'rgba(100,180,255,0.2)');
    } else {
      grad.addColorStop(0, 'rgba(100,150,255,0.6)'); grad.addColorStop(0.5, 'rgba(200,180,255,0.2)');
    }
    grad.addColorStop(1, 'transparent');
    ctx.fillStyle = grad; ctx.fillRect(0,0,128,128);
    return new THREE.CanvasTexture(canvas);
  };

  const starCount = 40000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff), new THREE.Color(0xffead4)];

  for(let i = 0; i < starCount; i++) {
    positions[i*3] = (Math.random() - 0.5) * 200;
    positions[i*3+1] = (Math.random() - 0.5) * 200;
    positions[i*3+2] = (Math.random() - 0.5) * 150;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i*3] = col.r; colors[i*3+1] = col.g; colors[i*3+2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const material = new THREE.ShaderMaterial({
    uniforms: {
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector3(0,0,0) },
      uTexture: { value: createTex(true) },
      uOpacity: { value: 1.0 }
    },
    vertexShader: `
      varying vec3 vColor;
      uniform vec3 uMouse;
      void main() {
        vColor = color;
        vec3 pos = position;
        float dist = distance(pos, uMouse);
        if (dist < 6.0) {
          float force = (6.0 - dist) / 6.0;
          pos += normalize(pos - uMouse) * force * 1.8;
        }
        vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
        gl_PointSize = 0.25 * (300.0 / -mvPosition.z);
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader: `
      uniform sampler2D uTexture;
      uniform float uOpacity;
      varying vec3 vColor;
      void main() {
        gl_FragColor = vec4(vColor, uOpacity) * texture2D(uTexture, gl_PointCoord);
      }
    `,
    transparent: true, blending: THREE.AdditiveBlending, depthWrite: false
  });

  const stars = new THREE.Points(geometry, material);
  const nGeo = new THREE.BufferGeometry();
  const nPos = new Float32Array(150);
  for(let i=0; i<150; i++) nPos[i] = (Math.random()-0.5)*150;
  nGeo.setAttribute('position', new THREE.BufferAttribute(nPos, 3));
  const nebula = new THREE.Points(nGeo, new THREE.PointsMaterial({ size: 50, map: createTex(false), transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.08 }));

  const spaceGroup = new THREE.Group();
  spaceGroup.add(stars, nebula);
  scene.add(spaceGroup);

  gsap.to(spaceGroup.rotation, { x: 0.3, y: 0.5, scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 3 }});

  const cursor = document.getElementById('custom-cursor');
  const flare = cursor?.querySelector('.cursor-glare');
  let mX = 0, mY = 0, pX = 0, pY = 0;
  const mouseV = new THREE.Vector3();

  const updateInput = (x, y) => {
    mX = x; mY = y;
    const vec = new THREE.Vector3((x / window.innerWidth) * 2 - 1, -(y / window.innerHeight) * 2 + 1, 0.5);
    vec.unproject(camera);
    const dir = vec.sub(camera.position).normalize();
    const mPos = camera.position.clone().add(dir.multiplyScalar(-camera.position.z / dir.z));
    const invRot = new THREE.Euler(-stars.rotation.x, -stars.rotation.y, -stars.rotation.z);
    mPos.applyEuler(invRot);
    material.uniforms.uMouse.value.copy(mPos);
  };

  window.addEventListener('mousemove', (e) => updateInput(e.clientX, e.clientY));
  window.addEventListener('touchmove', (e) => updateInput(e.touches[0].clientX, e.touches[0].clientY), {passive: true});

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;
    stars.rotation.y += 0.0002; stars.rotation.x += 0.0001;
    nebula.rotation.y += 0.0001;
    material.uniforms.uOpacity.value = 0.7 + Math.sin(time) * 0.3;
    nebula.material.opacity = 0.05 + Math.cos(time * 0.5) * 0.03;
    pX += (mX - pX) * 0.15; pY += (mY - pY) * 0.15;
    if (cursor) {
      const velocity = Math.sqrt(Math.pow(mX-pX, 2) + Math.pow(mY-pY, 2));
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${Math.atan2(mY-pY, mX-pX) * 57.29}deg) scaleX(${1 + velocity / 120})`;
      if(flare) flare.style.opacity = Math.min(1, 0.4 + (velocity / 200));
    }
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { position: fixed; inset: 0; z-index: -1; background: #000; overflow: hidden; }
  #custom-cursor {
    position: fixed; top: 0; left: 0; width: 100px; height: 20px;
    pointer-events: none !important; z-index: 100000;
    display: flex; align-items: center; justify-content: flex-end;
    will-change: transform; transform-origin: right center;
    mix-blend-mode: screen;
  }
  .cursor-core {
    width: 2px; height: 2px; background: #fff; border-radius: 50%;
    box-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(0, 140, 255, 0.3);
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute; right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, #fff 0%, rgba(255, 255, 255, 0.4) 30%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%); filter: blur(0.5px); opacity: 0.8;
  }
  .cursor-glare {
    position: absolute; right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(100, 200, 255, 0.4) 20%, transparent 80%);
    border-radius: 50%; filter: blur(4px); mix-blend-mode: screen;
  }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
  .content-overlay { position: relative; z-index: 1; pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }
  @keyframes pulse-glow { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.3); opacity: 1; } }
</style>
