<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: false, 
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.3, 0.9, 0.15);
  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);

  const createTexture = (isNebula) => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    if(isNebula) {
      gradient.addColorStop(0, 'rgba(100, 150, 255, 0.6)');
      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    } else {
      gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    }
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(canvas);
  };

  const starShaderMaterial = new THREE.ShaderMaterial({
    uniforms: {
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector3(0, 0, 0) },
      uTexture: { value: createTexture(false) },
      uOpacity: { value: 1.0 }
    },
    vertexShader: `
      attribute vec3 color;
      varying vec3 vColor;
      uniform float uTime;
      uniform vec3 uMouse;
      void main() {
        vColor = color;
        vec3 pos = position;
        float dist = distance(pos, uMouse);
        if (dist < 6.0) {
          float force = (6.0 - dist) / 6.0;
          pos += normalize(pos - uMouse) * force * 1.5;
        }
        vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
        gl_PointSize = 0.22 * (300.0 / -mvPosition.z);
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader: `
      uniform sampler2D uTexture;
      uniform float uOpacity;
      varying vec3 vColor;
      void main() {
        gl_FragColor = vec4(vColor, uOpacity) * texture2D(uTexture, gl_PointCoord);
      }
    `,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });

  const starCount = 40000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff), new THREE.Color(0xffead4)];

  for(let i = 0; i < starCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 200;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 200;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 150;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r; colors[i * 3 + 1] = col.g; colors[i * 3 + 2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const stars = new THREE.Points(geometry, starShaderMaterial);
  scene.add(stars);

  const nebulaCount = 40;
  const nGeo = new THREE.BufferGeometry();
  const nPos = new Float32Array(nebulaCount * 3);
  for(let i = 0; i < nebulaCount * 3; i++) nPos[i] = (Math.random() - 0.5) * 150;
  nGeo.setAttribute('position', new THREE.BufferAttribute(nPos, 3));
  const nebula = new THREE.Points(nGeo, new THREE.PointsMaterial({
    size: 40, map: createTexture(true), transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.08
  }));
  scene.add(nebula);

  gsap.to([stars.rotation, nebula.rotation], { 
    y: 0.5, x: 0.2,
    scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 1 } 
  });

  let mX = 0, mY = 0, pX = 0, pY = 0;
  const mouseV = new THREE.Vector3();

  const updateMouse = (x, y) => {
    mX = x; mY = y;
    const vec = new THREE.Vector3((x / window.innerWidth) * 2 - 1, -(y / window.innerHeight) * 2 + 1, 0.5);
    vec.unproject(camera);
    const dir = vec.sub(camera.position).normalize();
    const distance = -camera.position.z / dir.z;
    starShaderMaterial.uniforms.uMouse.value.copy(camera.position).add(dir.multiplyScalar(distance));
  };

  window.addEventListener('mousemove', (e) => updateMouse(e.clientX, e.clientY));
  window.addEventListener('touchmove', (e) => updateMouse(e.touches[0].clientX, e.touches[0].clientY), {passive: true});

  const cursor = document.getElementById('custom-cursor');
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const time = clock.getElapsedTime();
    starShaderMaterial.uniforms.uTime.value = time;
    starShaderMaterial.uniforms.uOpacity.value = 0.7 + Math.sin(time) * 0.3;
    stars.rotation.y += 0.0002;
    nebula.rotation.y += 0.0001;
    pX += (mX - pX) * 0.1;
    pY += (mY - pY) * 0.1;
    if (cursor) {
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0)`;
    }
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { 
    position: fixed; 
    inset: 0; 
    width: 100%; 
    height: 100%; 
    z-index: -1; 
    background: #000;
    overflow: hidden;
  }
  #custom-cursor {
    position: fixed; top: 0; left: 0; width: 100px; height: 20px;
    pointer-events: none; z-index: 10000;
    will-change: transform;
    mix-blend-mode: screen;
  }
  .cursor-core {
    width: 2px; height: 2px; background: #fff; border-radius: 50%;
    box-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(0, 140, 255, 0.3);
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute; right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, #fff 0%, rgba(255, 255, 255, 0.4) 30%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%); filter: blur(0.5px); opacity: 0.8;
  }
  .cursor-glare {
    position: absolute; right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(100, 200, 255, 0.4) 20%, transparent 80%);
    border-radius: 50%; filter: blur(4px); mix-blend-mode: screen;
  }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  .content-overlay { position: relative; z-index: 1; pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }
  @keyframes pulse-glow { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.3); opacity: 1; } }
</style>
