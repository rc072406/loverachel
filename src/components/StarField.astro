<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000000, 0.005);
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 25;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.3, 0.9, 0.15);
  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);

  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(100, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };
  
  const createNebulaTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(100, 150, 255, 0.6)');
    gradient.addColorStop(0.5, 'rgba(200, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.filter = 'blur(10px)';
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

  const starTex = createStarTexture();
  const nebulaTex = createNebulaTexture();

  const starCount = 40000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const initialPositions = new Float32Array(starCount * 3); 
  const colors = new Float32Array(starCount * 3);
  const temperatures = new Float32Array(starCount);
  const starPalette = [
    new THREE.Color(0xd4eaff),
    new THREE.Color(0xffffff),
    new THREE.Color(0xf0d9ff),
    new THREE.Color(0xffead4)
  ];

  for(let i = 0; i < starCount; i++) {
    const x = (Math.random() - 0.5) * 200;
    const y = (Math.random() - 0.5) * 200;
    const z = (Math.random() - 0.5) * 150;
    positions[i * 3] = initialPositions[i * 3] = x;
    positions[i * 3 + 1] = initialPositions[i * 3 + 1] = y;
    positions[i * 3 + 2] = initialPositions[i * 3 + 2] = z;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r;
    colors[i * 3 + 1] = col.g;
    colors[i * 3 + 2] = col.b;
    temperatures[i] = Math.random() * Math.PI * 2;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geometry.setAttribute('temperature', new THREE.BufferAttribute(temperatures, 1));

  const material = new THREE.PointsMaterial({
    size: 0.25,
    map: starTex,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    vertexColors: true,
    opacity: 1
  });
  const stars = new THREE.Points(geometry, material);
  scene.add(stars);

  const nebulaCount = 50;
  const nGeometry = new THREE.BufferGeometry();
  const nPositions = new Float32Array(nebulaCount * 3);
  for(let i = 0; i < nebulaCount * 3; i++) nPositions[i] = (Math.random() - 0.5) * 150;
  nGeometry.setAttribute('position', new THREE.BufferAttribute(nPositions, 3));

  const nMaterial = new THREE.PointsMaterial({
    size: 50,
    map: nebulaTex,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    opacity: 0.08
  });
  const nebula = new THREE.Points(nGeometry, nMaterial);
  scene.add(nebula);

  const spaceGroup = new THREE.Group();
  spaceGroup.add(stars);
  spaceGroup.add(nebula);
  scene.add(spaceGroup);

  gsap.to(spaceGroup.rotation, { 
    x: 0.3, 
    y: 0.5, 
    scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 3 } 
  });

  const cursor = document.getElementById('custom-cursor');
  const flare = cursor.querySelector('.cursor-glare');
  let mX = window.innerWidth / 2;
  let mY = window.innerHeight / 2;
  let pX = mX;
  let pY = mY;
  let scrollVel = 0;
  let lastScroll = 0;

  const mouseV = new THREE.Vector3();

  window.addEventListener('mousemove', (e) => { 
    mX = e.clientX; 
    mY = e.clientY; 
    mouseV.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseV.y = -(e.clientY / window.innerHeight) * 2 + 1;
    mouseV.z = 0.5;
  });

  window.addEventListener('scroll', () => {
    scrollVel = Math.abs(window.scrollY - lastScroll);
    lastScroll = window.scrollY;
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

   
    camera.lookAt(0, 0, 0);

    
    stars.rotation.y += 0.0002;
    stars.rotation.x += 0.0001;
    nebula.rotation.y += 0.0001;


    const posAttr = stars.geometry.attributes.position;
    const vector = new THREE.Vector3(mouseV.x, mouseV.y, 0).unproject(camera);
    const dir = vector.sub(camera.position).normalize();
    const distance = -camera.position.z / dir.z;
    const mPos = camera.position.clone().add(dir.multiplyScalar(distance));

 
    const inverseRotation = new THREE.Euler(-stars.rotation.x, -stars.rotation.y, -stars.rotation.z);
    mPos.applyEuler(inverseRotation);

    for (let i = 0; i < starCount; i++) {
      const ix = i * 3, iy = i * 3 + 1;
      const dx = posAttr.array[ix] - mPos.x;
      const dy = posAttr.array[iy] - mPos.y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      if (dist < 6) { 
        const force = (6 - dist) / 6;
        posAttr.array[ix] += dx * force * 0.12;
        posAttr.array[iy] += dy * force * 0.12;
      } else {
        posAttr.array[ix] += (initialPositions[ix] - posAttr.array[ix]) * 0.05;
        posAttr.array[iy] += (initialPositions[iy] - posAttr.array[iy]) * 0.05;
      }
    }
    posAttr.needsUpdate = true;

    // 5. Visual pulsing
    stars.material.opacity = 0.7 + Math.sin(time) * 0.3;
    nebula.material.opacity = 0.05 + Math.cos(time * 0.5) * 0.03;

    // 6. Cursor trailing
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;
    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${1 + (velocity / 120)})`;
      if (flare) {
        flare.style.opacity = Math.min(1, 0.4 + (velocity / 200)).toString();
        flare.style.transform = `scale(${1 + velocity / 150})`;
      }
    }
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; background: #000; }
  #custom-cursor {
    position: fixed; top: 0; left: 0; width: 100px; height: 20px;
    pointer-events: none !important; z-index: 100000;
    display: flex; align-items: center; justify-content: flex-end;
    will-change: transform; transform-origin: right center;
    mix-blend-mode: screen; transition: opacity 0.3s ease;
  }
  .cursor-core {
    width: 2px; height: 2px; background: #fff; border-radius: 50%;
    box-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(0, 140, 255, 0.3);
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute; right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, #fff 0%, rgba(255, 255, 255, 0.4) 30%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%); filter: blur(0.5px); opacity: 0.8;
  }
  .cursor-glare {
    position: absolute; right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(100, 200, 255, 0.4) 20%, transparent 80%);
    border-radius: 50%; filter: blur(4px); mix-blend-mode: screen;
  }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
  .content-overlay { pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }
  @keyframes pulse-glow { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.3); opacity: 1; } }
</style>
