---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);


  const STAR_TOTAL = 35000; // Increased count
  const COLOR_PALETTE = [0xffffff, 0xcbe9ff, 0xf0daff, 0xffeddb]; // Ultra-pale, realistic tints
  const BLOOM_THRESHOLD = 0.5; // Starts with brightness > 0.5 glow
  const BLOOM_STRENGTH = 1.2;
  const BLOOM_RADIUS = 0.8;

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 30;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  // Important for bloom functionality
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);


  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(
    new THREE.Vector2(window.innerWidth, window.innerHeight), 
    BLOOM_STRENGTH, BLOOM_RADIUS, BLOOM_THRESHOLD
  );

  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);

  
  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');      // Pure Core
    gradient.addColorStop(0.1, 'rgba(255, 255, 255, 0.8)');   // Airy disk
    gradient.addColorStop(0.3, 'rgba(200, 230, 255, 0.3)');   // Atmospheric color bleed
    gradient.addColorStop(0.6, 'rgba(100, 150, 255, 0.1)');   // Outer halo
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');             // Black
    ctx.fillStyle = gradient;
    ctx.beginPath(); ctx.arc(32, 32, 32, 0, Math.PI * 2); ctx.fill();
    return new THREE.CanvasTexture(canvas);
  };
  
  
  const createNebulaTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(100, 150, 255, 1)'); 
    gradient.addColorStop(0.5, 'rgba(200, 180, 255, 0.4)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.beginPath(); ctx.arc(64, 64, 64, 0, Math.PI * 2); ctx.fill();
    return new THREE.CanvasTexture(canvas);
  }

  const starTexture = createStarTexture();
  const nebulaTexture = createNebulaTexture();

 
  const createStarLayer = (count, zDepth, baseSize, opacity) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);

    for(let i = 0; i < count; i++) {
      const i3 = i * 3;
     
      positions[i3] = (Math.random() - 0.5) * 250;
      positions[i3+1] = (Math.random() - 0.5) * 200;
      positions[i3+2] = (Math.random() - 0.5) * zDepth;

      const color = new THREE.Color(COLOR_PALETTE[Math.floor(Math.random() * COLOR_PALETTE.length)]);
      colors[i3] = color.r; colors[i3+1] = color.g; colors[i3+2] = color.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({
      size: baseSize,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      vertexColors: true,
      opacity: opacity
    });

    return new THREE.Points(geometry, material);
  };

  const layer1Far = createStarLayer(STAR_TOTAL * 0.7, 200, 0.15, 0.4); 
  const layer2Mid = createStarLayer(STAR_TOTAL * 0.2, 100, 0.4, 0.9);   // Shiny, caught by Bloom
  const layer3Near = createStarLayer(STAR_TOTAL * 0.1, 50, 1.2, 0.3);  // Foreground Bokeh

  scene.add(layer1Far, layer2Mid, layer3Near);

  
  const dustGeometry = new THREE.BufferGeometry();
  const dustCount = 60; // Very few, massive points
  const dustPositions = new Float32Array(dustCount * 3);
  for(let i = 0; i < dustCount * 3; i++) {
    dustPositions[i] = (Math.random() - 0.5) * 150;
  }
  dustGeometry.setAttribute('position', new THREE.BufferAttribute(dustPositions, 3));
  const dustMaterial = new THREE.PointsMaterial({
    size: 60, // Massive points
    map: nebulaTexture,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    opacity: 0.1
  });
  const nebulaDustLayer = new THREE.Points(dustGeometry, dustMaterial);
  scene.add(nebulaDustLayer);

  let scrollWarp = 0;
  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    scrollWarp = Math.abs(currentScroll - lastScrollY);
    lastScrollY = currentScroll;
  });

  // Layered rotation parallax
  [layer1Far, layer2Mid, layer3Near, nebulaDustLayer].forEach((layer, i) => {
    gsap.to(layer.rotation, {
      x: 0.4 * (i + 1),
      y: 0.6 * (i + 1),
      scrollTrigger: {
        trigger: "body", start: "top top", end: "bottom bottom", scrub: 3,
      }
    });
  });

  // --- MOUSE & CURSOR ---
  const cursor = document.getElementById('custom-cursor');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY;

  window.addEventListener('mousemove', (e) => {
    mX = e.clientX; mY = e.clientY;
  });


  const cameraTimeline = gsap.timeline({ repeat: -1 });

  cameraTimeline.to(camera.position, {
    x: "+=0.4", y: "-=0.2", z: "+=0.1", duration: 15, ease: "sine.inOut"
  }, 0);
  cameraTimeline.to(camera.position, {
    x: "-=0.2", y: "+=0.3", z: "-=0.2", duration: 20, ease: "sine.inOut"
  }, 10);
  cameraTimeline.to(camera.rotation, {
    z: "+=0.005", duration: 25, ease: "sine.inOut"
  }, 0);

 
  cameraTimeline.add(() => {
    camera.lookAt(0, 0, 0);
  }, 0);

  // --- ANIMATION LOOP ---
  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

    
    const targetFOV = 60 + (scrollWarp * 0.1);
    camera.fov += (targetFOV - camera.fov) * 0.1;
    camera.updateProjectionMatrix();
    scrollWarp *= 0.9; 

    
    layer1Far.rotation.y += 0.0001;
    layer2Mid.rotation.y += 0.0002;
    nebulaDustLayer.rotation.z += 0.00005; // Extremely slow 3D nebula shift
    
   
    layer2Mid.material.opacity = 0.6 + Math.sin(time * 2.5) * 0.3;
    layer3Near.material.opacity = 0.2 + Math.cos(time * 1.5) * 0.2;

    
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      const scaleX = 1 + (velocity / 100);

      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${scaleX})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        glare.style.opacity = Math.min(1, 0.3 + (velocity / 200)).toString();
        glare.style.transform = `scale(${1 + velocity / 150})`;
      }
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.1" : "1";
    }

  
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: radial-gradient(circle at center, #02040a 0%, #000000 100%);
    pointer-events: none;
    overflow: hidden;
  }

  
  #star-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.9) 100%);
    pointer-events: none;
  }


  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.3s ease;
  }

  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 
      0 0 5px #fff, 0 0 10px #fff, 
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 30px rgba(0, 140, 255, 0.3); 
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; height: 4px; 
    background: linear-gradient(to left, #fff 0%, rgba(100, 200, 255, 0.4) 30%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(0, 100, 255, 0.1) 60%, transparent 80%);
    border-radius: 50%;
    filter: blur(4px); 
    mix-blend-mode: screen; 
  }

  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; position: relative; z-index: 10; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.4); opacity: 1; }
  }
</style>
