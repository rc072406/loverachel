---
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000000, 0.006);
  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 100;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  const renderScene = new RenderPass(scene, camera);
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.8, 0.1);
  const composer = new EffectComposer(renderer);
  composer.addPass(renderScene);
  composer.addPass(bloomPass);

  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(120, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };
  
  const createNebulaTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    gradient.addColorStop(0, 'rgba(100, 150, 255, 0.5)');
    gradient.addColorStop(0.5, 'rgba(200, 180, 255, 0.1)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.filter = 'blur(10px)';
    ctx.fillRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(canvas);
  };

  const starTex = createStarTexture();
  const nebulaTex = createNebulaTexture();

  const starCount = 45000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const starPalette = [
    new THREE.Color(0xd4eaff),
    new THREE.Color(0xffffff),
    new THREE.Color(0xf0d9ff),
    new THREE.Color(0xffead4)
  ];

  for(let i = 0; i < starCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 400;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 400;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 600;
    const col = starPalette[Math.floor(Math.random() * starPalette.length)];
    colors[i * 3] = col.r;
    colors[i * 3 + 1] = col.g;
    colors[i * 3 + 2] = col.b;
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const material = new THREE.PointsMaterial({
    size: 0.35,
    map: starTex,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    vertexColors: true,
    opacity: 0.8
  });
  const stars = new THREE.Points(geometry, material);
  scene.add(stars);

  const nGeometry = new THREE.BufferGeometry();
  const nPos = new Float32Array(150 * 3);
  for(let i = 0; i < 450; i++) nPos[i] = (Math.random() - 0.5) * 500;
  nGeometry.setAttribute('position', new THREE.BufferAttribute(nPos, 3));
  const nMaterial = new THREE.PointsMaterial({
    size: 80,
    map: nebulaTex,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    opacity: 0.06
  });
  const nebula = new THREE.Points(nGeometry, nMaterial);
  scene.add(nebula);

  gsap.to(camera.position, {
    z: -150,
    ease: "none",
    scrollTrigger: {
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      scrub: 1
    }
  });

  gsap.to(stars.rotation, {
    z: 1.5,
    scrollTrigger: {
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      scrub: 2
    }
  });

  const cursor = document.getElementById('custom-cursor');
  const flare = cursor.querySelector('.cursor-glare');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY, scrollVel = 0, lastScroll = 0;

  window.addEventListener('mousemove', (e) => { mX = e.clientX; mY = e.clientY; });
  window.addEventListener('scroll', () => {
    scrollVel = Math.abs(window.scrollY - lastScroll);
    lastScroll = window.scrollY;
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

    stars.rotation.y += 0.0003;
    nebula.rotation.y += 0.0001;

    const driftX = Math.sin(time * 0.4) * 2;
    const driftY = Math.cos(time * 0.4) * 2;
    camera.position.x += (driftX - camera.position.x) * 0.02;
    camera.position.y += (driftY - camera.position.y) * 0.02;

    const targetFOV = 65 + (scrollVel * 0.15);
    camera.fov += (targetFOV - camera.fov) * 0.1;
    camera.updateProjectionMatrix();
    scrollVel *= 0.92;

    stars.material.opacity = 0.6 + Math.sin(time * 1.5) * 0.2;

    const dx = mX - pX; const dy = mY - pY;
    pX += dx * 0.12; pY += dy * 0.12;
    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const vel = Math.sqrt(dx*dx + dy*dy);
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${1 + vel / 100})`;
      if (flare) {
        flare.style.opacity = Math.min(1, 0.4 + (vel / 150)).toString();
        flare.style.transform = `scale(${1 + vel / 100})`;
      }
    }
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1;
    background: radial-gradient(circle at center, #050505 0%, #000 100%);
  }
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    will-change: transform;
    transform-origin: right center;
    mix-blend-mode: screen;
    transition: opacity 0.3s ease;
  }
  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px #fff, 0 0 15px rgba(255, 255, 255, 0.6), 0 0 25px rgba(0, 140, 255, 0.4);
    animation: pulse-glow 1.5s infinite alternate;
  }
  .cursor-tail {
    position: absolute;
    right: 0; width: 80px; height: 4px;
    background: linear-gradient(to left, #fff 0%, rgba(255, 255, 255, 0.3) 40%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 15%, 100% 85%);
    filter: blur(0.5px);
    opacity: 0.8;
  }
  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, rgba(0, 100, 255, 0.1) 60%, transparent 80%);
    border-radius: 50%;
    filter: blur(5px);
    mix-blend-mode: screen;
  }
  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }
  .content-overlay { pointer-events: none; position: relative; z-index: 10; }
  .content-overlay > * { pointer-events: auto; }
  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.4); opacity: 1; }
  }
</style>
