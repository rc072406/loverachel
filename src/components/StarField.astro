---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

 
  const STAR_TOTAL = 40000; 
  const COLORS = [0xffffff, 0xd9eeff, 0xe2d9ff, 0xffe9d9, 0x1e3a8a]; 
  const BLOOM_PARAMS = { strength: 1.5, radius: 1.0, threshold: 0.4 };

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
 
  scene.fog = new THREE.FogExp2(0x000000, 0.008); 

  const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 2000);
  camera.position.z = 50;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: "high-performance" });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  container.appendChild(renderer.domElement);

  
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), BLOOM_PARAMS.strength, BLOOM_PARAMS.radius, BLOOM_PARAMS.threshold);
  composer.addPass(bloomPass);


  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
    grad.addColorStop(0.2, 'rgba(255, 255, 255, 0.6)');
    grad.addColorStop(0.5, 'rgba(100, 180, 255, 0.1)');
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.arc(32, 32, 32, 0, Math.PI * 2); ctx.fill();
    return new THREE.CanvasTexture(canvas);
  };
  
  const createNebulaTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 256; canvas.height = 256;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
    grad.addColorStop(0, 'rgba(60, 100, 255, 0.3)');
    grad.addColorStop(0.6, 'rgba(120, 50, 200, 0.1)');
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.filter = 'blur(10px)';
    ctx.beginPath(); ctx.arc(128, 128, 128, 0, Math.PI * 2); ctx.fill();
    return new THREE.CanvasTexture(canvas);
  };

  const starTex = createStarTexture();
  const nebulaTex = createNebulaTexture();

 
  const createLayer = (count, range, size, opacity) => {
    const geo = new THREE.BufferGeometry();
    const pos = new Float32Array(count * 3);
    const col = new Float32Array(count * 3);
    for(let i = 0; i < count; i++) {
      const i3 = i * 3;
      pos[i3] = (Math.random() - 0.5) * range;
      pos[i3+1] = (Math.random() - 0.5) * range;
      pos[i3+2] = (Math.random() - 0.5) * range;
      const c = new THREE.Color(COLORS[Math.floor(Math.random() * COLORS.length)]);
      col[i3] = c.r; col[i3+1] = c.g; col[i3+2] = c.b;
    }
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
    const mat = new THREE.PointsMaterial({ size, map: starTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, vertexColors: true, opacity });
    return new THREE.Points(geo, mat);
  };

  const farField = createLayer(STAR_TOTAL * 0.7, 1000, 0.15, 0.5);
  const midField = createLayer(STAR_TOTAL * 0.25, 400, 0.5, 0.8);
  const nearField = createLayer(STAR_TOTAL * 0.05, 150, 1.8, 0.4);
  scene.add(farField, midField, nearField);


  const dustGeo = new THREE.BufferGeometry();
  const dPos = new Float32Array(100 * 3);
  for(let i = 0; i < 300; i++) dPos[i] = (Math.random() - 0.5) * 600;
  dustGeo.setAttribute('position', new THREE.BufferAttribute(dPos, 3));
  const dustMat = new THREE.PointsMaterial({ size: 150, map: nebulaTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.15 });
  const nebula = new THREE.Points(dustGeo, dustMat);
  scene.add(nebula);


  gsap.to(camera.position, {
    x: "+=15", y: "+=10", duration: 30, repeat: -1, yoyo: true, ease: "sine.inOut"
  });

  gsap.to(scene.rotation, {
    y: Math.PI * 2, duration: 400, repeat: -1, ease: "none"
  });

 
  let scrollVel = 0;
  let lastS = 0;
  window.addEventListener('scroll', () => {
    scrollVel = Math.abs(window.scrollY - lastS);
    lastS = window.scrollY;
  });

  
  const cursor = document.getElementById('custom-cursor');
  let mX = 0, mY = 0, pX = 0, pY = 0;
  window.addEventListener('mousemove', (e) => { mX = e.clientX; mY = e.clientY; });

  // --- ANIMATION LOOP ---
  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.0005;

    
    camera.position.x += Math.sin(time) * 0.01;
    camera.position.y += Math.cos(time * 0.8) * 0.01;
    camera.lookAt(0,0,0);

 
    const targetFOV = 55 + (scrollVel * 0.2);
    camera.fov += (targetFOV - camera.fov) * 0.1;
    camera.updateProjectionMatrix();
    scrollVel *= 0.95;

  
    nearField.rotation.y += 0.0005;
    midField.rotation.z -= 0.0002;
    nebula.rotation.y += 0.0001;
    
 
    dustMat.opacity = 0.1 + Math.sin(time * 0.5) * 0.05;

    // Cursor Physics
    const dx = mX - pX; const dy = mY - pY;
    pX += dx * 0.15; pY += dy * 0.15;
    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const vel = Math.sqrt(dx*dx + dy*dy);
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${1 + vel / 100})`;
      cursor.querySelector('.cursor-glare').style.opacity = (0.3 + vel / 200).toString();
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.1" : "1";
    }

    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: #000;
    overflow: hidden;
  }


  #star-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);
    pointer-events: none;
  }


  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.4s ease;
  }

  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 10px #fff, 0 0 20px rgba(0, 140, 255, 0.5); 
    animation: pulse-glow 2s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; height: 4px; 
    background: linear-gradient(to left, #fff 0%, rgba(100, 200, 255, 0.2) 50%, transparent 100%);
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    opacity: 0.7;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; width: 60px; height: 60px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, transparent 70%);
    filter: blur(8px); 
  }

  @media (pointer: fine) { body, a, button { cursor: none !important; } }
  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; position: relative; z-index: 10; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(1.5); opacity: 1; }
  }
</style>
