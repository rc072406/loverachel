<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glow"></div>
  <div class="cursor-star"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000103);
  
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 4000);
  camera.position.z = 200; // Start back a bit

  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
  composer.addPass(bloomPass);


  const createInternalTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');
    const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
    grad.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    grad.addColorStop(0.5, 'rgba(255, 255, 255, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 128, 128);
    const tex = new THREE.CanvasTexture(canvas);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  };

  const starTexture = createInternalTexture();

  const stages = [
    { z: 0, color: 0x4488ff },
    { z: -1000, color: 0xffaa44 },
    { z: -2000, color: 0xff44aa },
    { z: -3000, color: 0x44ffaa }
  ];

  stages.forEach((stage) => {
    const count = 8000;
    const geo = new THREE.BufferGeometry();
    const pos = new Float32Array(count * 3);
    const cols = new Float32Array(count * 3);
    const color = new THREE.Color(stage.color);

    for (let i = 0; i < count; i++) {
      // Tunnel math
      const radius = 5 + Math.random() * 150;
      const angle = Math.random() * Math.PI * 2;
      pos[i*3] = Math.cos(angle) * radius;
      pos[i*3+1] = Math.sin(angle) * radius;
      pos[i*3+2] = stage.z + (Math.random() - 0.5) * 1000;

      cols[i*3] = color.r + (Math.random()-0.5)*0.2;
      cols[i*3+1] = color.g + (Math.random()-0.5)*0.2;
      cols[i*3+2] = color.b + (Math.random()-0.5)*0.2;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(cols, 3));

    const points = new THREE.Points(geo, new THREE.PointsMaterial({
      size: 1.5,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      vertexColors: true,
      depthWrite: false,
      sizeAttenuation: true
    }));
    scene.add(points);
  });

  let targetZ = 200;
  let scrollVel = 0;

  ScrollTrigger.create({
    trigger: "body",
    start: "top top",
    end: "bottom bottom",
    onUpdate: (self) => {
      scrollVel = Math.abs(self.getVelocity());
      targetZ = 200 + (self.progress * -3500);
    }
  });

  let mX = 0, mY = 0;
  window.addEventListener('mousemove', (e) => {
    mX = (e.clientX / window.innerWidth - 0.5) * 10;
    mY = (e.clientY / window.innerHeight - 0.5) * 10;
  });

  function animate() {
    requestAnimationFrame(animate);
    
    // Smoother diving
    camera.position.z += (targetZ - camera.position.z) * 0.05;
    
    // Mouse Tilt
    camera.position.x += (mX - camera.position.x) * 0.05;
    camera.position.y += (-mY - camera.position.y) * 0.05;
    camera.lookAt(0, 0, camera.position.z - 100);

    // Warp FOV
    camera.fov += (60 + (scrollVel / 150) - camera.fov) * 0.1;
    camera.updateProjectionMatrix();

    composer.render();
    scrollVel *= 0.95;

    // Cursor
    const cursor = document.getElementById('custom-cursor');
    if (cursor) {
      cursor.style.left = `${(mX / 10 + 0.5) * window.innerWidth}px`;
      cursor.style.top = `${(mY / 10 + 0.5) * window.innerHeight}px`;
    }
  }

  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; background: #000; }
  #custom-cursor {
    position: fixed; pointer-events: none; z-index: 9999;
    transform: translate(-50%, -50%);
  }
  .cursor-star { width: 4px; height: 4px; background: #fff; border-radius: 50%; box-shadow: 0 0 15px #fff; }
  body { height: 600vh; margin: 0; background: #000; }
</style>
