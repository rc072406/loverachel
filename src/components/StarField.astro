---
// src/components/LuxStarField.astro
---


<div id="star-container"></div>
<div id="luxury-cursor">
  <span class="cursor-text">love</span>
  <span class="cursor-text ghost">love</span>
  <span class="cursor-text ghost">love</span>
</div>
<div class="content-overlay">
  <slot />
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const STAR_COUNT = 15000;
  const COLORS = [0xffffff, 0xffd7e5, 0xdec9ff];
  
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 50;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.5)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(32, 32, 32, 0, Math.PI * 2);
    ctx.fill();
    return new THREE.CanvasTexture(canvas);
  };

  const starTexture = createStarTexture();

  const createLayer = (count, radius, size, opacity) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);

    for(let i = 0; i < count * 3; i+=3) {
      positions[i] = (Math.random() - 0.5) * radius;
      positions[i+1] = (Math.random() - 0.5) * radius;
      positions[i+2] = (Math.random() - 0.5) * radius;
      
      const color = new THREE.Color(COLORS[Math.floor(Math.random() * COLORS.length)]);
      colors[i] = color.r;
      colors[i+1] = color.g;
      colors[i+2] = color.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({
      size: size,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      opacity: opacity,
      vertexColors: true
    });

    return new THREE.Points(geometry, material);
  };

  const layers = [
    { mesh: createLayer(STAR_COUNT * 0.6, 400, 0.4, 0.3), speed: 0.0001 },
    { mesh: createLayer(STAR_COUNT * 0.3, 200, 0.8, 0.6), speed: 0.0003 },
    { mesh: createLayer(STAR_COUNT * 0.1, 100, 1.5, 0.8), speed: 0.0005 }
  ];

  layers.forEach(l => scene.add(l.mesh));

  const mouse = { x: 0, y: 0 };
  const smoothMouse = { x: 0, y: 0 };
  const cursor = document.getElementById('luxury-cursor');
  const ghosts = document.querySelectorAll('.ghost');

  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  gsap.ticker.add(() => {
    const dt = 1.0 - Math.pow(1.0 - 0.1, gsap.ticker.deltaRatio());
    smoothMouse.x += (mouse.x - smoothMouse.x) * dt;
    smoothMouse.y += (mouse.y - smoothMouse.y) * dt;

    const vx = mouse.x - smoothMouse.x;
    const vy = mouse.y - smoothMouse.y;
    const velocity = Math.sqrt(vx*vx + vy*vy);

    if (cursor) {
      gsap.set(cursor, {
        x: smoothMouse.x,
        y: smoothMouse.y,
        rotate: vx * 0.03,
        skewX: vx * 0.05
      });

      ghosts.forEach((ghost, i) => {
        gsap.to(ghost, {
          duration: 0.2 + (i * 0.1),
          x: vx * (0.4 + i * 0.3),
          y: vy * (0.4 + i * 0.3),
          opacity: Math.min(0.4, velocity / 150),
          overwrite: true
        });
      });
    }

    layers.forEach((l, i) => {
      l.mesh.rotation.y += l.speed;
      l.mesh.rotation.x += l.speed * 0.5;
      l.mesh.position.x = (smoothMouse.x - window.innerWidth/2) * (0.005 * (i + 1));
      l.mesh.position.y = (smoothMouse.y - window.innerHeight/2) * (-0.005 * (i + 1));
    });

    renderer.render(scene, camera);
  });

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  :root {
    --crimson: #dc143c;
    --deep-crimson: #4a0000;
  }

  body {
    margin: 0;
    overflow-x: hidden;
    background: #000;
    cursor: none !important;
  }

  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1;
    background: radial-gradient(circle at center, #0a0505 0%, #000000 100%);
    pointer-events: none;
  }

  #luxury-cursor {
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    will-change: transform;
    mix-blend-mode: screen;
  }

  .cursor-text {
    font-family: 'Crimson Text', serif;
    font-size: 2.2rem;
    font-weight: 400;
    font-style: italic;
    background: linear-gradient(to bottom, #fff 0%, var(--crimson) 60%, var(--deep-crimson) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.03em;
    filter: drop-shadow(0 0 10px rgba(220, 20, 60, 0.4));
    white-space: nowrap;
    user-select: none;
  }

  .ghost {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
    filter: blur(8px);
    z-index: -1;
    background: var(--crimson);
    -webkit-background-clip: text;
  }

  .content-overlay {
    position: relative;
    z-index: 10;
    pointer-events: none;
  }

  .content-overlay > * {
    pointer-events: auto;
  }

  a, button {
    cursor: none !important;
  }

  @media (pointer: coarse) {
    #luxury-cursor { display: none; }
    body { cursor: auto !important; }
  }
</style>
