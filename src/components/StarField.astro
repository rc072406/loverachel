---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);

  camera.position.z = 15;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const createGlowTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.1)');
    gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(canvas);
  };

  const particlesGeometry = new THREE.BufferGeometry();
  const count = 4500;
  const positions = new Float32Array(count * 3);

  for(let i = 0; i < count * 3; i+=3) { 
    positions[i] = (Math.random() - 0.5) * 60;     // X
    positions[i+1] = (Math.random() - 0.5) * 60;   // Y
    positions[i+2] = (Math.random() - 0.8) * 40;   // Z (Mostly negative to stay in front)
  }
  particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  const stars = new THREE.Points(particlesGeometry, new THREE.PointsMaterial({
    size: 0.22, 
    map: createGlowTexture(),
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    opacity: 0.9
  }));
  scene.add(stars);

  gsap.to(stars.rotation, {
    x: 0.4,
    y: 0.8,
    scrollTrigger: {
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      scrub: 1.5,
    }
  });

  // --- SHOOTING STAR CURSOR LOGIC ---
  const cursor = document.getElementById('custom-cursor');
  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  let posX = mouseX;
  let posY = mouseY;

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function animate() {
    requestAnimationFrame(animate);
    
    stars.rotation.y += 0.0007;

    const dt = 0.12; 
    const dx = mouseX - posX;
    const dy = mouseY - posY;
    
    posX += dx * dt;
    posY += dy * dt;
    
    if (cursor) {
    
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      // Stretching effect based on speed
      const scale = 1 + (velocity / 150);

      cursor.style.transform = `translate3d(${posX}px, ${posY}px, 0) rotate(${angle}deg) scaleX(${scale})`;
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -1; 
    pointer-events: none;
    background: #000;
  }

  .content-overlay {
    position: relative;
    z-index: 10;
    background: transparent !important;
  }

  /* --- THE SHOOTING STAR --- */
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 40px; /* Tail length */
    height: 10px;
    pointer-events: none;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    will-change: transform;
    mix-blend-mode: exclusion;
  }

  .cursor-core {
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 15px #fff, 0 0 30px #fff;
  }

  .cursor-tail {
    position: absolute;
    right: 4px;
    width: 60px;
    height: 2px;
    background: linear-gradient(to left, rgba(255,255,255,0.8), transparent);
    filter: blur(1px);
    transform-origin: right center;
  }

  @media (pointer: fine) { 
    body, a, button { cursor: none !important; } 
  }
  
  @media (pointer: coarse) { 
    #custom-cursor { display: none; } 
  }
</style>
