---
---
<div class="starfield-container">
  <canvas id="starfield-canvas"></canvas>
  
  <div id="star-cursor">
    <div class="cursor-core"></div>
    <div class="cursor-tail"></div>
  </div>

  <div class="content-overlay">
    <slot />
  </div>
</div>

<style>
  .starfield-container {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100vh;
    background: #000;
    z-index: -1;
  }
  #starfield-canvas { display: block; }
  .content-overlay { position: relative; z-index: 10; width: 100%; }

  #star-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 20px; height: 20px;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: screen;
  }
  .cursor-core {
    width: 8px; height: 8px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 20px #fff, 0 0 40px #4e9eff;
  }
  .cursor-tail {
    position: absolute;
    top: 50%; left: 50%;
    width: 120px; height: 2px;
    background: linear-gradient(to left, rgba(255,255,255,0.9), transparent);
    transform-origin: left center;
    filter: blur(1px);
  }
</style>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let scene, camera, renderer, stars;
  const count = 8000;
  const mouse = new THREE.Vector2(-1000, -1000);
  
  // Storage for star physics
  const basePositions = new Float32Array(count * 3);
  const currentPositions = new Float32Array(count * 3);
  const velocities = new Float32Array(count);
  const sizes = new Float32Array(count);

  function init() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 5;

    renderer = new THREE.WebGLRenderer({ 
      canvas: document.getElementById('starfield-canvas'),
      antialias: true 
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    const geo = new THREE.BufferGeometry();
    
    for (let i = 0; i < count; i++) {
      // Spread stars in a large cube
      const x = (Math.random() - 0.5) * 40;
      const y = (Math.random() - 0.5) * 40;
      const z = (Math.random() - 0.5) * 40;
      
      basePositions.set([x, y, z], i * 3);
      currentPositions.set([x, y, z], i * 3);
      velocities[i] = Math.random() * 0.02 + 0.01;
      sizes[i] = Math.random() * 1.5;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(currentPositions, 3));
    
    
    const mat = new THREE.PointsMaterial({
      size: 0.05,
      color: 0xffffff,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending,
      sizeAttenuation: true
    });

    stars = new THREE.Points(geo, mat);
    scene.add(stars);

    setupInteractions();
    animate();
  }

  function setupInteractions() {
   
    ScrollTrigger.create({
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      onUpdate: (self) => {
        
        const velocity = Math.abs(self.getVelocity() / 1000);
        gsap.to(stars.scale, { 
          z: 1 + velocity * 0.5, 
          duration: 0.5, 
          ease: "power2.out" 
        });
      }
    });

  
    window.addEventListener('mousemove', (e) => {
      // Normalize mouse for Three.js (-1 to +1)
      mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
      
      
      const cursor = document.getElementById('star-cursor');
      gsap.to(cursor, {
        x: e.clientX,
        y: e.clientY,
        duration: 0.8,
        ease: "power3.out"
      });
    });
  }

  function animate() {
    const positions = stars.geometry.attributes.position.array;
    
  
    const vector = new THREE.Vector3(mouse.x, mouse.y, 0.5);
    vector.unproject(camera);
    const dir = vector.sub(camera.position).normalize();
    const distance = -camera.position.z / dir.z;
    const worldMouse = camera.position.clone().add(dir.multiplyScalar(distance));

    for (let i = 0; i < count; i++) {
      const i3 = i * 3;
      
      
      positions[i3 + 2] += velocities[i];
      if (positions[i3 + 2] > 5) positions[i3 + 2] = -35;

      
      const dx = positions[i3] - worldMouse.x;
      const dy = positions[i3 + 1] - worldMouse.y;
      const dist = Math.sqrt(dx*dx + dy*dy);
      
      if (dist < 2) {
        const force = (2 - dist) * 0.02;
        positions[i3] += dx * force;
        positions[i3 + 1] += dy * force;
      }
      
  
      positions[i3] += (basePositions[i3] - positions[i3]) * 0.01;
      positions[i3 + 1] += (basePositions[i3 + 1] - positions[i3 + 1]) * 0.01;
    }

    stars.geometry.attributes.position.needsUpdate = true;
    renderer.render(scene, camera);
    requestAnimationFrame(animate);
  }

  init();
</script>
