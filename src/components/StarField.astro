<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const vertexShader = `
    uniform float uTime;
    uniform vec3 uMouse;
    uniform float uRadius;
    attribute float aSize;
    attribute vec3 aInitialPos;
    varying vec3 vColor;
    varying float vOpacity;

    void main() {
      vColor = color;
      vec3 pos = position;
      
      vec3 worldPos = (modelMatrix * vec4(pos, 1.0)).xyz;
      float dist = distance(worldPos, uMouse);
      
      if (dist < uRadius) {
        float force = (uRadius - dist) / uRadius;
        pos += normalize(worldPos - uMouse) * force * 4.0;
      } else {
        pos = mix(pos, aInitialPos, 0.05);
      }

      vOpacity = 0.5 + 0.5 * sin(uTime + position.x * 0.1);
      
      vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
      gl_PointSize = aSize * (300.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
    }
  `;

  const fragmentShader = `
    varying vec3 vColor;
    varying float vOpacity;
    void main() {
      float d = distance(gl_PointCoord, vec2(0.5));
      if (d > 0.5) discard;
      float strength = pow(1.0 - d * 2.0, 2.0);
      gl_FragColor = vec4(vColor, strength * vOpacity);
    }
  `;

  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 30;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: false, 
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));
  const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
  composer.addPass(bloomPass);

  const starCount = 60000;
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(starCount * 3);
  const colors = new Float32Array(starCount * 3);
  const sizes = new Float32Array(starCount);
  const palette = [new THREE.Color(0xd4eaff), new THREE.Color(0xffffff), new THREE.Color(0xf0d9ff), new THREE.Color(0x99ccff)];

  for (let i = 0; i < starCount; i++) {
    positions[i*3] = (Math.random() - 0.5) * 200;
    positions[i*3+1] = (Math.random() - 0.5) * 200;
    positions[i*3+2] = (Math.random() - 0.5) * 150;
    const col = palette[Math.floor(Math.random() * palette.length)];
    colors[i*3] = col.r; colors[i*3+1] = col.g; colors[i*3+2] = col.b;
    sizes[i] = Math.random() * 1.5 + 0.5;
  }

  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('aInitialPos', new THREE.BufferAttribute(new Float32Array(positions), 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));

  const starMaterial = new THREE.ShaderMaterial({
    uniforms: {
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector3(1000, 1000, 1000) },
      uRadius: { value: 12.0 }
    },
    vertexShader,
    fragmentShader,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    vertexColors: true
  });

  const stars = new THREE.Points(geometry, starMaterial);
  scene.add(stars);

  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2(-10, -10);
  const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);

  window.addEventListener('mousemove', (e) => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  gsap.to(stars.rotation, {
    y: Math.PI * 0.2,
    scrollTrigger: {
      trigger: "body",
      start: "top top",
      end: "bottom bottom",
      scrub: 1.5
    }
  });

  const cursor = document.getElementById('custom-cursor');
  let curX = 0, curY = 0, tarX = 0, tarY = 0;

  function animate() {
    requestAnimationFrame(animate);
    const time = performance.now() * 0.001;
    starMaterial.uniforms.uTime.value = time;

    raycaster.setFromCamera(mouse, camera);
    const intersectPoint = new THREE.Vector3();
    raycaster.ray.intersectPlane(plane, intersectPoint);
    starMaterial.uniforms.uMouse.value.lerp(intersectPoint, 0.1);

    stars.rotation.y += 0.0003;
    stars.rotation.z += 0.0001;

    tarX = (mouse.x + 1) * 0.5 * window.innerWidth;
    tarY = (-mouse.y + 1) * 0.5 * window.innerHeight;
    curX += (tarX - curX) * 0.15;
    curY += (tarY - curY) * 0.15;

    if (cursor) {
      const dx = tarX - curX;
      const dy = tarY - curY;
      const vel = Math.sqrt(dx * dx + dy * dy);
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      cursor.style.transform = `translate3d(${curX - 100}px, ${curY - 10}px, 0) rotate(${angle}deg) scaleX(${1 + vel / 100})`;
    }

    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  body { margin: 0; overflow-x: hidden; background: #000; }
  #star-container { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  #custom-cursor {
    position: fixed; top: 0; left: 0; width: 100px; height: 20px;
    pointer-events: none; z-index: 9999;
    display: flex; align-items: center; justify-content: flex-end;
    mix-blend-mode: screen; will-change: transform;
  }
  .cursor-core {
    width: 3px; height: 3px; background: #fff; border-radius: 50%;
    box-shadow: 0 0 15px #fff, 0 0 30px #4af;
  }
  .cursor-tail {
    position: absolute; right: 0; width: 60px; height: 2px;
    background: linear-gradient(to left, #fff, transparent);
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
  }
  .cursor-glare {
    position: absolute; right: -15px; width: 40px; height: 40px;
    background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 70%);
    filter: blur(4px);
  }
  @media (pointer: fine) { * { cursor: none !important; } }
  .content-overlay { pointer-events: none; position: relative; z-index: 1; }
  .content-overlay > * { pointer-events: auto; }
</style>
