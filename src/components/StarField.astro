---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- CONFIG ---
  const STAR_COUNT = 25000; 
  // Realistic cosmic colors (White, Pale Blue, Soft Lavender, subtle Orange-Red)
  const COLORS = [0xffffff, 0xd4eaff, 0xe5d4ff, 0xffead4];

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 20;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

 
  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 64; canvas.height = 64;
    const ctx = canvas.getContext('2d');

 
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');      // Hot core
    gradient.addColorStop(0.1, 'rgba(255, 255, 255, 0.9)');    // Inner glow
    gradient.addColorStop(0.3, 'rgba(200, 230, 255, 0.4)');    // Chromatic bleed
    gradient.addColorStop(0.6, 'rgba(100, 150, 255, 0.1)');    // Outer atmosphere
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');              // Dissolve
    
    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(32, 32, 32, 0, Math.PI * 2);
    ctx.fill();
    
    return new THREE.CanvasTexture(canvas);
  };

  const starTexture = createStarTexture();

  // --- MULTI-LAYER COSMOS ---
  const createLayer = (count, zDepth, baseSize, opacity) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);

    for(let i = 0; i < count; i++) {
      const i3 = i * 3;
      positions[i3] = (Math.random() - 0.5) * 180;
      positions[i3+1] = (Math.random() - 0.5) * 180;
      positions[i3+2] = (Math.random() - 0.5) * zDepth;

     
      const color = new THREE.Color(COLORS[Math.floor(Math.random() * COLORS.length)]);
      colors[i3] = color.r;
      colors[i3+1] = color.g;
      colors[i3+2] = color.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({
      size: baseSize,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      vertexColors: true,
      opacity: opacity
    });

    return new THREE.Points(geometry, material);
  };

  
  const layer1 = createLayer(STAR_COUNT * 0.7, 150, 0.12, 0.6); 
  const layer2 = createLayer(STAR_COUNT * 0.2, 80, 0.35, 0.8);
  const layer3 = createLayer(STAR_COUNT * 0.1, 40, 0.9, 0.4); 
  
  scene.add(layer1, layer2, layer3);

 
  [layer1, layer2, layer3].forEach((layer, i) => {
    gsap.to(layer.rotation, {
      x: 0.2 * (i + 1),
      y: 0.3 * (i + 1),
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        scrub: 1.5 + (i * 0.5),
      }
    });
  });

  
  const cursor = document.getElementById('custom-cursor');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY;

  window.addEventListener('mousemove', (e) => {
    mX = e.clientX; mY = e.clientY;
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.0008;

    
    layer1.rotation.y += 0.0001;
    layer2.rotation.y += 0.0002;
    layer3.rotation.y += 0.0004;
    
    
    layer2.material.opacity = 0.5 + Math.sin(time * 2) * 0.3;
    layer3.material.opacity = 0.2 + Math.cos(time * 1.5) * 0.2;

    
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      const scaleX = 1 + (velocity / 120);

      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${scaleX})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        glare.style.opacity = Math.min(1, 0.4 + (velocity / 200)).toString();
        glare.style.transform = `scale(${1 + velocity / 150})`;
      }
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.2" : "1";
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: radial-gradient(circle at center, #060914 0%, #000 100%);
    pointer-events: none;
  }

  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.3s ease;
  }

  .cursor-core {
    width: 2px; height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 
      0 0 5px #fff, 0 0 10px #fff, 
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 30px rgba(0, 140, 255, 0.3); 
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; height: 4px; 
    background: linear-gradient(to left, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(255, 255, 255, 0.4) 30%, 
      transparent 100%
    );
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; 
    width: 60px; height: 60px;
    background: radial-gradient(
      circle, 
      rgba(255, 255, 255, 0.9) 0%, 
      rgba(100, 200, 255, 0.4) 20%, 
      rgba(0, 100, 255, 0.1) 50%, 
      transparent 80%
    );
    border-radius: 50%;
    filter: blur(4px); 
    mix-blend-mode: screen; 
    z-index: 1;
  }

  @media (pointer: fine) { 
    body, a, button { cursor: none !important; } 
  }
  @media (pointer: coarse) { #custom-cursor { display: none; } }

  .content-overlay { pointer-events: none; position: relative; z-index: 10; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.3); opacity: 1; }
  }
</style>
