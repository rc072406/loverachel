---
// src/components/StarField.astro 
---
<div id="star-container"></div>
<div id="custom-cursor">
  <div class="cursor-glare"></div>
  <div class="cursor-core"></div>
  <div class="cursor-tail"></div>
</div>
<div class="content-overlay">
  <slot /> 
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- CONFIG ---
  const STAR_COUNT = 20000; 
  const COLORS = [0xffffff, 0xcee7ff, 0xf0d9ff]; // Pure, Blue-tint, Lavender-tint

  // --- INITIALIZATION ---
  const container = document.getElementById('star-container');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 30;

  const renderer = new THREE.WebGLRenderer({ 
    alpha: true, 
    antialias: true,
    powerPreference: "high-performance" 
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);


  const createStarTexture = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 128; canvas.height = 128;
    const ctx = canvas.getContext('2d');

    // High-contrast Cross Glint
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(64, 10); ctx.lineTo(64, 118); // Long Vertical
    ctx.moveTo(10, 64); ctx.lineTo(118, 64); // Long Horizontal
    ctx.stroke();

    // Inner Soft Glow
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 50);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.6)');
    gradient.addColorStop(0.5, 'rgba(100, 180, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    
    ctx.fillStyle = gradient;
    ctx.filter = 'blur(1px)';
    ctx.beginPath();
    ctx.arc(64, 64, 50, 0, Math.PI * 2);
    ctx.fill();
    
    return new THREE.CanvasTexture(canvas);
  };

  const starTexture = createStarTexture();

  
  const createLayer = (count, zRange, size, speed) => {
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const shimmer = new Float32Array(count);

    for(let i = 0; i < count * 3; i+=3) {
      positions[i] = (Math.random() - 0.5) * 200;
      positions[i+1] = (Math.random() - 0.5) * 200;
      positions[i+2] = (Math.random() - 0.5) * zRange;
      shimmer[i/3] = Math.random() * Math.PI * 2;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    
    const material = new THREE.PointsMaterial({
      size: size,
      map: starTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      opacity: 0.8,
      color: COLORS[Math.floor(Math.random() * COLORS.length)]
    });

    const mesh = new THREE.Points(geometry, material);
    return { mesh, speed };
  };

  const layers = [
    createLayer(STAR_COUNT * 0.7, 100, 0.25, 0.0002), // Far Background
    createLayer(STAR_COUNT * 0.2, 60, 0.6, 0.0005),   // Midground (Shiny)
    createLayer(STAR_COUNT * 0.1, 30, 1.2, 0.0008)    // Foreground (Hero Stars)
  ];

  layers.forEach(l => scene.add(l.mesh));

  
  layers.forEach((l, i) => {
    gsap.to(l.mesh.rotation, {
      x: 0.4 + (i * 0.1),
      y: 0.6 + (i * 0.2),
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        scrub: 1 + i,
      }
    });
  });


  const cursor = document.getElementById('custom-cursor');
  let mX = window.innerWidth / 2, mY = window.innerHeight / 2;
  let pX = mX, pY = mY;

  window.addEventListener('mousemove', (e) => {
    mX = e.clientX;
    mY = e.clientY;
  });

  function animate() {
    requestAnimationFrame(animate);
    const time = Date.now() * 0.001;

    
    layers.forEach((l, i) => {
      l.mesh.rotation.y += l.speed;
      // High-frequency twinkle for the "Shiny" look
      l.mesh.material.opacity = 0.5 + Math.sin(time * (2 + i)) * 0.3;
    });

   
    const dx = mX - pX;
    const dy = mY - pY;
    pX += dx * 0.15;
    pY += dy * 0.15;

    if (cursor) {
      const angle = Math.atan2(dy, dx) * (180 / Math.PI);
      const velocity = Math.sqrt(dx*dx + dy*dy);
      const scaleX = 1 + (velocity / 100); // Dynamic stretch

    
      cursor.style.transform = `translate3d(${pX - 100}px, ${pY - 10}px, 0) rotate(${angle}deg) scaleX(${scaleX})`;
      
      const glare = cursor.querySelector('.cursor-glare');
      if (glare) {
        glare.style.opacity = Math.min(1, 0.3 + (velocity / 200)).toString();
        glare.style.transform = `scale(${1 + velocity / 150})`;
      }
      
      cursor.style.opacity = (mY > window.innerHeight - 80) ? "0.2" : "1";
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style is:global>
  #star-container {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: -1; 
    background: radial-gradient(circle at center, #050812 0%, #000000 100%);
    pointer-events: none;
  }

  
  #custom-cursor {
    position: fixed;
    top: 0; left: 0;
    width: 100px; 
    height: 20px;
    pointer-events: none !important; 
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
    will-change: transform;
    transform-origin: right center; 
    mix-blend-mode: screen; 
    transition: opacity 0.3s ease;
  }

  .cursor-core {
    width: 2px; 
    height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 
      0 0 5px #fff, 
      0 0 10px #fff, 
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 30px rgba(0, 140, 255, 0.3); 
    z-index: 2;
    animation: pulse-glow 1.5s infinite alternate;
  }

  .cursor-tail {
    position: absolute;
    right: 0;
    width: 80px; 
    height: 4px; 
    background: linear-gradient(to left, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(255, 255, 255, 0.4) 30%, 
      transparent 100%
    );
    clip-path: polygon(0% 50%, 100% 20%, 100% 80%);
    filter: blur(0.5px);
    opacity: 0.8;
  }

  .cursor-glare {
    position: absolute;
    right: -20px; 
    width: 60px; height: 60px;
    background: radial-gradient(
      circle, 
      rgba(255, 255, 255, 0.9) 0%, 
      rgba(100, 200, 255, 0.4) 20%, 
      rgba(0, 100, 255, 0.1) 50%, 
      transparent 80%
    );
    border-radius: 50%;
    filter: blur(4px); 
    mix-blend-mode: screen; 
    z-index: 1;
  }

  @media (pointer: fine) { 
    body, a, button { cursor: none !important; } 
  }
  
  @media (pointer: coarse) { 
    #custom-cursor { display: none; } 
  }

  .content-overlay { pointer-events: none; }
  .content-overlay > * { pointer-events: auto; }

  @keyframes pulse-glow {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.3); opacity: 1; }
  }
</style>
