---
const models = [
  { id: 1, name: "XXX", details: "MARILYN / 4.25.02", image: "/api/placeholder/400/500", link: "#" },
  { id: 2, name: "XXX", details: "NEXT / 16", image: "/api/placeholder/400/500", link: "#" },
  { id: 3, name: "XXX", details: "XX / 20 / MARILYN", image: "/api/placeholder/400/500", link: "#" },
  { id: 4, name: "XXX", details: "DNA / ELITE", image: "/api/placeholder/400/500", link: "#" }
];
---

<section class="database-section">
  <div class="database-intro">
    <h2 class="database-title">model database</h2>
    <p class="press-alert">Casting Board V1</p>
  </div>

  <div class="model-board-grid">
    {models.map((model) => (
      <a href={model.link} class={`polaroid-card card-${model.id}`}>
        <div class="polaroid-sidebar">
          <span class="model-details">{model.details}</span>
          <span class="model-name">{model.name}</span>
        </div>
        
        <div class="polaroid-photo-wrapper">
          <img src={model.image} alt={model.name} loading="lazy" />
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .database-section {
    background: transparent;
    position: relative;
    min-height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px 4vw;
    box-sizing: border-box;
    overflow: hidden;
  }

  .database-intro {
    position: absolute;
    left: 4vw;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 1; 
    pointer-events: none;
  }

  .database-title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 7vw, 5.5rem); 
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .press-alert {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 20px; 
    color: rgba(255, 255, 255, 0.5);
    animation: blink 2.5s infinite ease-in-out;
  }

  .model-board-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 50px;
    max-width: 1100px;
    width: 100%;
    margin-left: 15vw; 
    z-index: 2;
  }

  .polaroid-card {
    display: flex;
    background: #fbfbfa; 
    padding: 16px 16px 16px 84px; 
    position: relative;
    text-decoration: none;
    outline: none;
    box-shadow: 
      2px 6px 15px rgba(0, 0, 0, 0.22),
      0px 1px 3px rgba(0, 0, 0, 0.1);
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                box-shadow 0.25s ease;
    will-change: transform;
  }

  .polaroid-photo-wrapper {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    background: #111;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .polaroid-photo-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .polaroid-sidebar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 84px;
    display: flex;
    flex-direction: row-reverse; 
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    box-sizing: border-box;
    writing-mode: vertical-rl;
    transform: rotate(180deg); 
  }

  .model-name {
    font-family: "La Belle Aurore", cursive;
    font-size: 2.2rem;
    font-weight: 700;
    color: #161616;
    letter-spacing: -0.01em;
    line-height: 1;
    filter: blur(0.2px) drop-shadow(0.5px 0.5px 0px rgba(0,0,0,0.05));
    -webkit-font-smoothing: antialiased;
  }

  .model-details {
    font-family: "La Belle Aurore", cursive;
    font-size: 1.3rem;
    font-weight: 500;
    color: #444444;
    letter-spacing: 0.05em;
    filter: blur(0.2px) drop-shadow(0.5px 0.5px 0px rgba(0,0,0,0.05));
    -webkit-font-smoothing: antialiased;
  }

  .card-1 { transform: rotate(0deg); }
  .card-2 { transform: rotate(0deg); }
  .card-3 { transform: rotate(0deg); }
  .card-4 { transform: rotate(0deg); }

@media (hover: hover) {
  .polaroid-card:hover {
    z-index: 10;
    transform: scale(1.04) rotate(2deg) translateY(-5px); 
    box-shadow: 
      10px 20px 30px rgba(0, 0, 0, 0.3),
      0px 4px 8px rgba(0, 0, 0, 0.15);
  }
}

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (max-width: 900px) {
    .database-section {
      padding: 40px 20px;
    }
    .database-intro {
      position: relative;
      left: 0;
      top: 0;
      transform: none;
      margin-bottom: 40px;
      width: 100%;
      align-items: center;
    }
    .database-title {
      writing-mode: horizontal-tb;
      transform: none;
      text-align: center;
      font-size: 3rem;
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.5);
    }
    .press-alert {
      margin-top: 8px;
    }
    .model-board-grid {
      grid-template-columns: 1fr;
      margin-left: 0;
      gap: 30px;
      max-width: 400px;
    }
    .polaroid-card {
      padding: 12px 12px 12px 64px; 
    }
    .polaroid-sidebar {
      width: 64px;
      padding: 16px 0;
    }
    .model-name {
      font-size: 1.6rem; 
    }
    .model-details {
      font-size: 1.05rem;
    }
    .card-1, .card-2, .card-3, .card-4 { 
      transform: rotate(0deg); 
    }
    .polaroid-card:active {
      transform: scale(0.98);
    }
  }

  @media (max-width: 400px) {
    .polaroid-card {
      padding: 10px 10px 10px 52px;
    }
    .polaroid-sidebar {
      width: 52px;
      padding: 12px 0;
    }
    .model-name {
      font-size: 1.35rem;
    }
    .model-details {
      font-size: 0.85rem;
    }
  }
</style>
