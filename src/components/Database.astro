---
// src/components/Database.astro
const models = [
  { id: 1, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 2, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 3, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 4, name: "Name", image: "/api/placeholder/400/400", link: "#" }
];
---

<section class="database-section">
  <div class="database-intro">
    <h2 class="database-title">model database</h2>
    <p class="press-alert">press me</p>
  </div>

  <div class="model-pile-container">
    {models.map((model) => (
      <a href={model.link} class={`model-card card-${model.id}`}>
        <img src={model.image} alt={model.name} />
        <div class="polaroid-caption">
          <span>{model.name}</span>
          <svg class="hollow-heart" viewBox="0 0 24 24">
            <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

const runAnimation = () => {
  const cards = gsap.utils.toArray(".model-card");
  const section = document.querySelector(".database-section");
  
  if (!section || cards.length === 0) return;

  
  requestAnimationFrame(() => {
    const scrollTriggerEndValue = cards.length * window.innerHeight;

    gsap.to(cards, {
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: `+=${scrollTriggerEndValue}`,
        scrub: 1,
        pin: true,
        anticipatePin: 1,
      
        invalidateOnRefresh: true, 
      },
      x: () => (Math.random() > 0.5 ? window.innerWidth * 1.5 : -window.innerWidth * 1.5),
      y: () => -window.innerHeight * (1.2 + Math.random()), 
      rotation: () => Math.random() * 90 - 45,
      scale: 2,
      ease: "none",
      stagger: {
        each: 1, 
        from: "end"
      }
    });
  });
  };

  runAnimation();
  document.addEventListener("astro:after-swap", runAnimation);
</script>

<style>
  .database-section {
    position: relative;
    height: 100vh;
    width: 100%;
    background: #000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    touch-action: pan-y;
  }

 .database-intro {
  position: absolute;
  left: 3vw;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  z-index: 1; 
  pointer-events: none;
  max-height: 90vh;
}

.database-title {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  font-family: 'Inter', sans-serif;
  font-weight: 900;
  font-size: clamp(3rem, 8vw, 6rem); 
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 0.8;
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.6);
  margin: 0;
  padding-bottom: 20px;
}

.press-alert {
  color: white;
  font-family: 'Inter', sans-serif;
  font-size: 20px;
  font-weight: 300;
  margin-top: 20px; 
  position: relative;
  display: inline-block;
  animation: blink 2s infinite ease-in-out;
}

@media (max-width: 768px) {
  .database-intro {
    left: 10px;
    top: 20px;
    transform: none;
  }
  
  .database-title {
    font-size: 3.5rem;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.5);
  }
}

  .model-pile-container {
    position: relative;
    width: 100%;
    height: 400px;
    perspective: 2000px;
    z-index: 10;
  }


  .model-card {
    position: absolute;
    width: 260px;
    height: 315px;
    background: #fdfdfd;
    padding: 12px 12px 65px 12px;
    left: 50%;
    top: 50%;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border: 1px solid rgba(0,0,0,0.05);
    text-decoration: none;
    cursor: pointer;
    transform: translate3d(-50%, -50%, 0);
     will-change: transform, opacity;
    -webkit-backface-visibility: hidden; 
    backface-visibility: hidden;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  }



  .model-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

.card-1 { transform: translate3d(-55%, -50%, 0) rotate(-5deg); z-index: 1; }
.card-2 { transform: translate3d(-48%, -52%, 0) rotate(3deg); z-index: 2; }
.card-3 { transform: translate3d(-52%, -48%, 0) rotate(-2deg); z-index: 3; }
.card-4 { transform: translate3d(-45%, -50%, 0) rotate(6deg); z-index: 4; }

  .polaroid-caption {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: -2px;
    font-family: "La Belle Aurore", cursive;
    font-size: 1.8rem;
    transform: rotate(-2.5deg);
    filter: blur(0.3px) contrast(1.2);
  -webkit-font-smoothing: antialiased;
   text-shadow: 0.5px 0.5px 1px rgba(0,0,0,0.15);
  color: #222;
  }


  .hollow-heart {
    width: 1.4em; 
    height: 1.4em;
    stroke: #1a1a1a;
    stroke-width: 1.3px; 
    stroke-linecap: round;
    stroke-linejoin: round;
    position: relative;
    margin-left: -14px; 
    margin-top: -8px; 
    transform: rotate(8deg); 
    opacity: 0.9;
    fill: none !important;
    filter: blur(0.3px) contrast(1.2);
  -webkit-font-smoothing: antialiased;

  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  /* DESKTOP STYLES (Larger Polaroid) */
  @media (min-width: 769px) {
    .model-card {
      width: 400px; /* Increased for desktop */
      height: 485px; /* Scaled proportionally */
      padding: 18px 18px 90px 18px;
    }
    
    .polaroid-caption {
      font-size: 3rem !important; 
      bottom: 35px !important;
    }
  }

</style>
