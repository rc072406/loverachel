---
// src/components/Database.astro
// 1. Define  models here
const models = [
  {
    id: 1,
    name: "filler",
    image: "/images/filler.jpg", 
    link: "/profiles/filler"
  },
  {
    id: 2,
    name: "filler",
    image: "/images/filler.jpg",
    link: "/profiles/filler"
  },
  {
    id: 3,
    name: "filler",
    image: "/images/filler.jpg",
    link: "/profiles/filler"
  },
  {
    id: 4,
    name: "JORDAN",
    image: "/images/filler.jpg",
    link: "/profiles/filler"
  }
];
---

<section class="database-section">
  <div class="database-intro">
    <h2 class="database-title">model database</h2>
    <p class="press-alert">scroll to explore</p>
  </div>

  <div class="model-pile-container">
    {}
    {[1, 2, 3, 4].map((id) => (
      <a href={`/profiles/model-${id}`} class={`model-card card-${id}`}>
        <img src={`/api/placeholder/400/400`} alt={`Model ${id}`} />
        <div class="polaroid-caption">
          <span>name</span>
          <svg class="hollow-heart" viewBox="0 0 24 24">
            <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const runAnimation = () => {
    const cards = gsap.utils.toArray(".model-card");
    const section = document.querySelector(".database-section");
    
   
    const scrollTriggerEndValue = cards.length * window.innerHeight;

    
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: `+=${scrollTriggerEndValue}`,
        pin: true,
        scrub: 1,
        anticipatePin: 1,
      }
    });

    tl.to(cards, {
      
      x: (i) => (i % 2 === 0 ? -window.innerWidth * 2 : window.innerWidth * 2),
      y: -window.innerHeight * 1.2,
      rotation: (i) => (i % 2 === 0 ? -60 : 60),
      scale: 2,
      stagger: {
        each: 1,
        from: "end" // Top card flies first
      },
      ease: "none"
    });
  };

  runAnimation();
  // Standard Astro event for view transitions
  document.addEventListener("astro:after-swap", runAnimation);
</script>

<style>
  .database-section {
    position: relative;
    height: 100vh;
    width: 100%;
    background: #000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    touch-action: none; 
  }

  .database-intro {
    text-align: center;
    z-index: 10;
    margin-bottom: 40px;
    pointer-events: none;
  }

  .database-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    color: #fff;
    text-transform: uppercase;
  }

  .press-alert {
    font-family: 'Fira Code', monospace;
    color: #ff0033;
    font-size: 14px;
    text-transform: uppercase;
    animation: blink 1.5s infinite;
  }

  .model-pile-container {
    position: relative;
    width: 100%;
    height: 400px;
    perspective: 2000px;
  }

  .model-card {
    position: absolute;
    width: 300px;
    height: 365px;
    background: #fdfdfd;
    padding: 12px 12px 60px 12px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border: 1px solid rgba(0,0,0,0.05);
    text-decoration: none;
    cursor: pointer;
    will-change: transform;
  }

 
  .card-1 { transform: translate(-55%, -50%) rotate(-5deg); z-index: 4; }
  .card-2 { transform: translate(-48%, -52%) rotate(3deg); z-index: 3; }
  .card-3 { transform: translate(-52%, -48%) rotate(-2deg); z-index: 2; }
  .card-4 { transform: translate(-45%, -50%) rotate(6deg); z-index: 1; }

  .model-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .polaroid-caption {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0px;
    font-family: 'Reenie Beanie', cursive;
    font-size: 1.8rem;
    color: #1a1a1a;
    transform: rotate(-2.5deg);
  }

  .hollow-heart {
    width: 0.8em;
    height: 0.8em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* --- MOBILE FIX --- */
  @media (max-width: 1024px) {
    .model-card {
      width: 220px; /* Shrunk for mobile screens */
      height: 280px;
      padding-bottom: 50px;
    }
    
    /* Keep them absolute so GSAP can fly them away! */
    .model-pile-container {
      height: 300px;
    }
  }
</style>
