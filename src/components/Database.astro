---
// src/components/Database.astro
const models = [
  { id: 1, name: "Name 1", image: "/api/placeholder/400/400", link: "#" },
  { id: 2, name: "Name 2", image: "/api/placeholder/400/400", link: "#" },
  { id: 3, name: "Name 3", image: "/api/placeholder/400/400", link: "#" },
  { id: 4, name: "Name 4", image: "/api/placeholder/400/400", link: "#" }
];
---

<section class="database-section">
  <div class="database-intro">
    <h2 class="database-title">model database</h2>
    <p class="press-alert">Hello!</p>
  </div>

  <div class="swiper model-swiper">
    <div class="swiper-wrapper">
      {models.map((model) => (
        <div class="swiper-slide">
          <a href={model.link} class="model-card">
            <img src={model.image} alt={model.name} />
            <div class="polaroid-caption">
              <span>{model.name}</span>
              <svg class="hollow-heart" viewBox="0 0 24 24">
                <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
              </svg>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { EffectCreative, Mousewheel } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-creative';

  const initSwiper = () => {
    new Swiper('.model-swiper', {
      modules: [EffectCreative, Mousewheel],
      effect: 'creative',
      speed: 800,
      grabCursor: true,
  
      mousewheel: {
        thresholdDelta: 20, 
        releaseOnEdges: true, 
      },
      creativeEffect: {
        prev: {
        
          translate: ['-120%', '-150%', 500], 
          rotate: [0, 0, -60],
          scale: 1.5,
          opacity: 0,
        },
        next: {
          
          translate: ['2%', '2%', -50],
          rotate: [0, 0, 5],
          opacity: 1,
        },
        limitProgress: 5, 
      },
    });
  };

  initSwiper();
  document.addEventListener("astro:after-swap", initSwiper);
</script>

<style>
  .database-section {
    position: relative;
    height: 100vh;
    width: 100%;
    background: #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .model-swiper {
    width: 100%;
    height: 100vh;
    overflow: visible !important;
    display: flex;
    align-items: center;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }


  .model-card {
    position: relative;
    width: 260px;
    height: 315px;
    background: #fdfdfd;
    padding: 12px 12px 65px 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border: 1px solid rgba(0,0,0,0.05);
    text-decoration: none;
    will-change: transform;
    transform-style: preserve-3d;
  }


  .swiper-slide:nth-child(odd) .model-card { transform: rotate(-4deg); }
  .swiper-slide:nth-child(even) .model-card { transform: rotate(3deg); }

  .model-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
  }


  .polaroid-caption {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: "La Belle Aurore", cursive;
    font-size: 1.8rem;
    transform: rotate(-2.5deg);
    color: #222;
  }

  .hollow-heart {
    width: 1.4em;
    height: 1.4em;
    stroke: #1a1a1a;
    stroke-width: 1.3px;
    fill: none !important;
    margin-left: -14px;
    margin-top: -8px;
    transform: rotate(8deg);
  }


  .database-intro {
    position: absolute;
    left: 3vw;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    pointer-events: none;
  }

  .database-title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6rem);
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.6);
  }

  .press-alert {
    color: white;
    font-family: 'Inter', sans-serif;
    margin-top: 20px;
    animation: blink 2s infinite;
  }

  @keyframes blink { 50% { opacity: 0.3; } }

  @media (min-width: 769px) {
    .model-card {
      width: 400px;
      height: 485px;
      padding: 18px 18px 90px 18px;
    }
    .polaroid-caption { font-size: 3rem !important; bottom: 20px !important; }
  }
</style>
