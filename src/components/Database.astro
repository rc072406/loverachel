---
// src/components/Database.astro
const models = [
  { id: 1, name: "Name 1", image: "/api/placeholder/400/400", link: "#" },
  { id: 2, name: "Name 2", image: "/api/placeholder/400/400", link: "#" },
  { id: 3, name: "Name 3", image: "/api/placeholder/400/400", link: "#" },
  { id: 4, name: "Name 4", image: "/api/placeholder/400/400", link: "#" }
];
---

<section class="database-section">
  <div class="database-intro">
    <h2 class="database-title">model database</h2>
    <p class="press-alert">swipe to explore</p>
  </div>

  <div class="swiper model-swiper">
    <div class="swiper-wrapper">
      {models.map((model) => (
        <div class="swiper-slide">
          <a href={model.link} class="model-card">
            <img src={model.image} alt={model.name} loading="lazy" />
            <div class="polaroid-caption">
              <span>{model.name}</span>
              <svg class="hollow-heart" viewBox="0 0 24 24">
                <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
              </svg>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script>
  import Swiper from 'swiper';
  import { EffectCreative } from 'swiper/modules';

  const initSwiper = () => {
    new Swiper('.model-swiper', {
      modules: [EffectCreative],
      effect: 'creative',
      grabCursor: true,
      loop: true,
      speed: 600,
      creativeEffect: {
        prev: {
          
          shadow: false,
          translate: ['-150%', '-20%', 500],
          rotate: [0, 0, -35],
          opacity: 0,
        },
        next: {
          // The cards waiting in the stack
          translate: ['0%', '0%', -400],
          rotate: [0, 0, 5],
          scale: 0.8,
          opacity: 0.8,
        },
      },
     
      watchSlidesProgress: true,
    });
  };

  initSwiper();
  document.addEventListener("astro:after-swap", initSwiper);
</script>

<style>
  .database-section {
    position: relative;
    height: 100vh;
    width: 100%;
    background: #000;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }


  .model-swiper {
    width: 100%;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible !important; 
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }

  
  .model-card {
    position: relative;
    width: 280px;
    height: 340px;
    background: #fdfdfd;
    padding: 12px 12px 65px 12px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.6);
    border: 1px solid rgba(0,0,0,0.05);
    text-decoration: none;
    cursor: grab;
    /* Hardware Acceleration */
    will-change: transform, opacity;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .model-card:active { cursor: grabbing; }

  .model-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    pointer-events: none;
  }

  /* Captions & Hearts  */
  .polaroid-caption {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: "La Belle Aurore", cursive;
    font-size: 1.8rem;
    transform: rotate(-2.5deg);
    color: #222;
  }

  .hollow-heart {
    width: 1.4em;
    height: 1.4em;
    stroke: #1a1a1a;
    stroke-width: 1.3px;
    fill: none !important;
    margin-left: -14px;
    margin-top: -8px;
    transform: rotate(8deg);
  }

  /* Responsive & Typography */
  .database-intro {
    position: absolute;
    left: 3vw;
    z-index: 20;
    pointer-events: none;
  }

  .database-title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6rem);
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,255,255,0.6);
  }

  @media (min-width: 769px) {
    .model-card {
      width: 400px;
      height: 485px;
      padding: 18px 18px 90px 18px;
    }
    .polaroid-caption { font-size: 3rem !important; bottom: 20px !important; }
  }
</style>
