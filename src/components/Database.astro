---
// src/components/Database.astro
const models = [
  { id: 1, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 2, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 3, name: "Name", image: "/api/placeholder/400/400", link: "#" },
  { id: 4, name: "Name", image: "/api/placeholder/400/400", link: "#" }
];


const total = models.length;
---

<section class="scroll-track">
  <div class="database-section">
    <div class="database-intro">
      <h2 class="database-title">model database</h2>
      <p class="press-alert">scroll me</p>
    </div>

    <div class="model-pile-container" id="card-pile">
      {models.map((model, i) => (
        <a 
          href={model.link} 
          class={`model-card card-${model.id}`}
          style={`--reverse-index: ${total - 1 - i};`}
        >
          <img src={model.image} alt={model.name} />
          <div class="polaroid-caption">
            <span>{model.name}</span>
            <svg class="hollow-heart" viewBox="0 0 24 24">
              <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const setupScroll = () => {
    const track = document.querySelector('.scroll-track');
    const pile = document.getElementById('card-pile');
    if (!track || !pile) return;

    const onScroll = () => {
      const rect = track.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, -rect.top / (rect.height - window.innerHeight)));
   
      pile.style.setProperty('--scroll-p', progress.toString());
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  setupScroll();
  document.addEventListener("astro:after-swap", setupScroll);
</script>

<style>
  .scroll-track {
    height: 400vh;
    background: #000;
  }

  .database-section {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .database-intro { position: absolute; left: 3vw; top: 50%; transform: translateY(-50%); z-index: 1; pointer-events: none; }
  .database-title { writing-mode: vertical-rl; transform: rotate(180deg); font-family: 'Inter', sans-serif; font-weight: 900; font-size: clamp(3rem, 8vw, 6rem); text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.6); }
  .press-alert { color: white; font-family: 'Inter', sans-serif; font-size: 20px; animation: blink 2s infinite ease-in-out; }

  .model-pile-container {
    position: relative;
    width: 100%;
    height: 400px;
    perspective: 2000px;
    z-index: 10;
    --scroll-p: 0;
  }

  .model-card {
    position: absolute;
    width: 260px;
    height: 315px;
    background: #fdfdfd;
    padding: 12px 12px 65px;
    left: 50%;
    top: 50%;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    text-decoration: none;
    
   
    --start: calc(var(--reverse-index) * 0.15);
    --local-p: clamp(0, (var(--scroll-p) - var(--start)) / 0.3, 1);
    
    
    transform: translate3d(
      calc(-50% + (150vw * var(--local-p))), 
      calc(-50% + (-100vh * var(--local-p))), 
      0
    ) 
    rotate(calc(var(--base-rotation) + (45deg * var(--local-p))))
    scale(calc(1 + var(--local-p)));

    opacity: calc(1 - var(--local-p));

   
    transition: transform 0.6s cubic-bezier(0.1, 0.7, 0.3, 1), opacity 0.4s ease-out;
    
    will-change: transform, opacity;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }


  .card-1 { --base-rotation: -5deg; z-index: 1; }
  .card-2 { --base-rotation: 3deg; z-index: 2; }
  .card-3 { --base-rotation: -2deg; z-index: 3; }
  .card-4 { --base-rotation: 6deg; z-index: 4; }

  .model-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
  .polaroid-caption { position: absolute; bottom: 12px; left: 0; right: 0; display: flex; justify-content: center; font-family: "La Belle Aurore", cursive; font-size: 1.8rem; color: #222; }
  .hollow-heart { width: 1.4em; height: 1.4em; stroke: #1a1a1a; margin-left: -14px; fill: none !important; }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  
  @media (min-width: 769px) {
    .model-card { width: 400px; height: 485px; padding: 18px 18px 90px; }
    .polaroid-caption { font-size: 3rem !important; bottom: 20px !important; }
  }
</style>
