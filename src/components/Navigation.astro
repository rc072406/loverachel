---
const { pathname } = Astro.url; 

// Function to check if the link is active
const isActive = (path) => {
  const normalizedPath = pathname.replace(/\/$/, "");
  const targetPath = path.replace(/\/$/, "");
  return normalizedPath === targetPath;
};

const isAbout = isActive('/about');
const isIssues = isActive('/issues');
const isContact = isActive('/contact');
---

<nav-island>
  <header class="mobile-header">
    <div class="logo"><a href="/index">love, RACHEL</a></div>
    <button class="hamburger" id="menuOpen">
      <span></span><span></span>
    </button>
  </header>

  <nav class="side-navigation" id="sideNav">
    <div class="nav-header">
      <div class="logo"><a href="/index">love, RACHEL</a></div>
      <button class="menu-close" id="menuClose">✕</button>
    </div>

    <section class="toc-section">
      <nav class="toc-nav">
        <a href="/about" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">About</span>
            <p>Architecting the exclusive visual chimera.</p>
            {isAbout && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
        <a href="/issues" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">Issues</span>
            <p>From the best pointe shoes to bio-tech. Explore our latest features.</p>
            {isIssues && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
        <a href="/contact" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">Contact</span>
            <p>Join the collective. How to contribute your voice.</p>
            {isContact && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
      </nav>
    </section>
  </nav>
</nav-island>

<script>
  class NavIsland extends HTMLElement {
    constructor() {
      super();
      const nav = this.querySelector('#sideNav');
      const openBtn = this.querySelector('#menuOpen');
      const closeBtn = this.querySelector('#menuClose');

      openBtn?.addEventListener('click', () => nav?.classList.add('active'));
      closeBtn?.addEventListener('click', () => nav?.classList.remove('active'));
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') nav?.classList.remove('active');
      });
    }
  }

  // Prevent "Already Defined" error on hot-reloads
  if (!customElements.get('nav-island')) {
    customElements.define('nav-island', NavIsland);
  }
</script>
<style>
/* --- HEADER & NAVIGATION --- */
.mobile-header {
    position: fixed;
    top: 0;
    width: 100%;
    height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
    background: rgba(0,0,0,0.9);
    
    border-bottom: var(--border);
   
    background: rgba(0, 0, 0, 0.7); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    z-index: 100002 !important; /* Higher than your custom-cursor (100000) */
    pointer-events: auto !important;
}

.logo a {
    font-family: var(--bodoni);
    font-weight: 900;
    font-size: 1.8rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: -1px;
   
}

.hamburger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    -webkit-tap-highlight-color: transparent; 
    outline: none; 
}

.hamburger span {
    display: block;
    width: 35px;
    height: 2px;
    background: #fff;
    
}

/* --- THE SIDE NAVIGATION (OVERLAY) --- */
.side-navigation {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    background: #000;
    z-index: 2000;
    transition: 0.6s cubic-bezier(0.85, 0, 0.15, 1);
    display: flex;
    flex-direction: column;
    padding: 60px;
    overflow-y: auto;
}

.side-navigation.active {
    right: 0;
}

.nav-header {
    display: flex;
    justify-content: space-between;
    border-bottom: var(--border);
    padding-bottom: 20px;
    margin-bottom: 40px;
}

.toc-nav {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.toc-link {
    font-family: 'Inter', sans-serif ;
    font-size: clamp(2.5rem, 8vw, 5rem); 
    line-height: 0.9;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none; 
  
    display:block; 
}
a {
    text-decoration: none;
    color: inherit;
}
.nav-alert {
    color: var(--accent);
    font-family: var(--fira);
    font-size: 12px;
    text-transform: uppercase;
    margin-top: 10px;
    letter-spacing: 1px;
    animation: blink 1.5s infinite;
}
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.3; }  
    100% { opacity: 1; }
}
</style>
