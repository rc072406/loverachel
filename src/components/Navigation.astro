---
const { pathname } = Astro.url; 

// Function to check if the link is active
const isActive = (path) => {
  const normalizedPath = pathname.replace(/\/$/, "");
  const targetPath = path.replace(/\/$/, "");
  return normalizedPath === targetPath;
};

const isAbout = isActive('/about');
const isIssues = isActive('/issues');
const isContact = isActive('/contact');
---

<nav-island>
  <header class="mobile-header">
    <div class="logo"><a href="/index">love, RACHEL</a></div>
    <button class="hamburger" id="menuOpen">
      <span></span><span></span>
    </button>
  </header>

  <nav class="side-navigation" id="sideNav">
    <div class="nav-header">
      <div class="logo"><a href="/index">love, RACHEL</a></div>
      <button class="menu-close" id="menuClose">✕</button>
    </div>

    <section class="toc-section">
      <nav class="toc-nav">
        <a href="/about" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">About</span>
            <p>Architecting the exclusive visual chimera.</p>
            {isAbout && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
        <a href="/issues" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">Issues</span>
            <p>From the best pointe shoes to bio-tech. Explore our latest features.</p>
            {isIssues && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
        <a href="/contact" class="toc-item">
          <div class="toc-content">
            <span class="toc-link">Contact</span>
            <p>Join the collective. How to contribute your voice.</p>
            {isContact && <p class="nav-alert">Where are you?</p>}
          </div>
        </a>
      </nav>
    </section>
  </nav>
</nav-island>

<script>
  class NavIsland extends HTMLElement {
    constructor() {
      super();
      const nav = this.querySelector('#sideNav');
      const openBtn = this.querySelector('#menuOpen');
      const closeBtn = this.querySelector('#menuClose');

      openBtn?.addEventListener('click', () => nav?.classList.add('active'));
      closeBtn?.addEventListener('click', () => nav?.classList.remove('active'));
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') nav?.classList.remove('active');
      });
    }
  }

  // Prevent "Already Defined" error on hot-reloads
  if (!customElements.get('nav-island')) {
    customElements.define('nav-island', NavIsland);
  }
</script>
<style>
/* --- HEADER & NAVIGATION --- */
.mobile-header {
    position: fixed;
    top: 0;
    width: 100%;
    height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
  
    z-index: 1000;
    background: transparent; 
  
}

.logo a {
    font-family: var(--bodoni);
    font-weight: 700;
    font-size: 2.5rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: -1px;
   
}

.hamburger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-end; 
    gap: 10px; 
    padding: 10px;
    outline: none;
    -webkit-tap-highlight-color: transparent;
}

.hamburger span {
    display: block;
    height: 2px;
    background: #fff;
    transition: width 0.4s cubic-bezier(0.23, 1, 0.32, 1);
}

.hamburger span:first-child {
    width: 40px;
}


.hamburger span:last-child {
    width: 24px; 
}


.hamburger:hover span:last-child {
    width: 40px;
}

/* --- THE SIDE NAVIGATION (OVERLAY) --- */
.side-navigation {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    background: black;
    z-index: 2002;
    transition: 0.6s cubic-bezier(0.85, 0, 0.15, 1);
    display: flex;
    flex-direction: column;
    padding: 60px;
    overflow-y: auto;
}

.side-navigation.active {
    right: 0;
}

.nav-header {
    display: flex;
    justify-content: space-between;
    border-bottom: var(--border);
    padding-bottom: 20px;
    margin-bottom: 40px;
}

.toc-nav {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.toc-link {
    font-family: 'GFS Didot', serif;
    font-size: clamp(2.5rem, 8vw, 5rem); 
    line-height: 0.9;
    color: #fff;
    text-decoration: none; 
    display:block; 
}
a {
    text-decoration: none;
    color: inherit;
}
.nav-alert {
    color: var(--accent);
    font-family: var(--fira);
    font-size: 12px;
    margin-top: 10px;
    letter-spacing: 1px;
    animation: blink 1.5s infinite;
    text-transform: uppercase;
}
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.3; }  
    100% { opacity: 1; }
}


.toc-item {
    display: block;
    max-width: 100%;
}

/* Horizontal Layout (Desktop / Screens wider than 768px) */
@media (min-width: 768px) {
    .toc-nav {
        flex-direction: row; 
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-top: auto; 
        margin-bottom: auto;
    }

    .toc-item {
        flex: 1; 
        max-width: 300px; 
    }

    .toc-link {
        margin-bottom: 15px;
    }
}


.side-navigation.active .toc-nav {
    animation: fadeIn 0.8s ease forwards;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
.menu-close {
    background: none;     
    border: none;        
    color: #fff;         
    font-size: 2rem;     
    cursor: pointer;      
    padding: 10px;       
    outline: none;        
    -webkit-tap-highlight-color: transparent; 
}
</style>
