---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter from '../components/TypeWriter.astro';
import Database from '../components/Database.astro';
---

<BaseLayout title="FASHION AND STEM MAGAZINE FOR GIRLS">
  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
        </div>
      </div>
    </div>
  </section>

 <TypeWriter 
  phrases={["Falling in love.", "One story at a time.", "One picture at a time.", "One page at a time."]} 
  waitTime={3000} 
/>

 <Database />
</BaseLayout>
