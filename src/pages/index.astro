---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="FASHION AND STEM MAGAZINE FOR GIRLS">
  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
          <span>ISSUE NO.01 COMING SOON // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
          <span>RECODING FEMININITY // </span>
        </div>
      </div>
    </div>
  </section>

 <TypeWriter 
  phrases={["Falling in love.", "One story at a time.", "One page at a time."]} 
  waitTime={3000} 
/>

  <section class="database-section">
    <div class="database-intro">
      <h2 class="database-title">model database</h2>
      <p class="press-alert">press me</p>
    </div>

    <div class="model-pile-container">
      <div class="model-card card-1"><img src="" alt="Model 1"><div class="polaroid-caption">name<svg class="hollow-heart" viewBox="0 0 24 24">
        <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
    </svg></div></div>
      <div class="model-card card-2"><img src="" alt="Model 2"><div class="polaroid-caption">name<svg class="hollow-heart" viewBox="0 0 24 24">
        <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
    </svg></div></div>
      <div class="model-card card-3"><img src="" alt="Model 3"><div class="polaroid-caption">name<svg class="hollow-heart" viewBox="0 0 24 24">
        <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
    </svg></div></div>
      <div class="model-card card-4"><img src="" alt="Model 4"><div class="polaroid-caption">name<svg class="hollow-heart" viewBox="0 0 24 24">
        <path d="M12 20s-1-4.5-5-7.5c-3-2.2-4.5-4.5-3.5-7 1.2-3 5-2.5 7 1.5 1.5-3.5 6.5-4 8-1.5 1.5 2.5 0 5-3.5 7.5-4 3-6 7-6 7z" />
    </svg></div></div>
    </div>
  </section>
</BaseLayout>
