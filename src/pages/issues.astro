---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ISSUES">
  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>EXTRA EXTRA // </span>
          <span>EXTRA EXTRA // </span>
          <span>EXTRA EXTRA // </span>
          <span>EXTRA EXTRA // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
        </div>
      </div>
    </div>
  </section>

  <section class="database-section">
    <div class="database-intro">
        <h2 class="database-title">ARCHIVE</h2>
        <p class="intro-text" style="max-width: 600px;">
            The first iteration of our digital interface is currently under construction. 
            Check back for the full drop of Issue No. 01.
        </p>
    </div>
  </section>
</BaseLayout>
