---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from '../components/Cards.astro';

---

<BaseLayout title="CONTACT">
  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>CONTACT // </span>
          <span>CONTACT // </span>
          <span>CONTACT // </span>
          <span>CONTACT // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
        </div>
      </div>
    </div>
  </section>
<Cards />


</BaseLayout>
