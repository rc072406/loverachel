---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout title="ABOUT THE COLLECTIVE">
  <section class="hero-section">
    <div class="hero-row">
      <div class="marquee">
        <div class="track">
          <span>ABOUT THE COLLECTIVE // </span>
          <span>ABOUT THE COLLECTIVE // </span>
          <span>ABOUT THE COLLECTIVE // </span>
          <span>ABOUT THE COLLECTIVE // </span>
        </div>
      </div>
    </div>
    
    <div class="hero-row ghost-row">
      <div class="marquee reverse">
        <div class="track">
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
          <span>WHERE ARE YOU? // </span>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section">


    <div class="about-grid">
      <div class="grid-label">
        <span>EST. 2026</span>
        <div class="vertical-line"></div>
      </div>

      <article class="about-content">
        <p class="intro-text">
          <em>love, RACHEL</em> is a chimera, a digital (and hopefully one day printed) magazine 
          where girls in STEM meet the tactile world of fashion. 
        </p>
        <div class="story-columns">
          <p>
            Born from the intersection of code and creative expression, this 
            project explores what it means to be a girl in STEM in the modern age. 
            We believe that traditionally male-dominated fields and feminine 
            beauty aren't opposites, but are the same language.
          </p>
          <p>
            Every issue, made strictly with HTML and cascading style sheets, 
            is a deep dive into girls who are changing the game, documenting 
            the journey of building something from 0 to 100. This isn't your 
            average fashion magazine; it's the stories of all the inspiring 
            and amazing girls in STEM.
          </p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>

.about-section {
    position: relative;
    padding: 150px 5%;
    background-color: transparent !important;
    min-height: 100vh;
    overflow: hidden; 
    background: transparent !important;
    
}






/* Asymmetrical Grid */
.about-grid {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 60px;
    position: relative;
    z-index: 10;
}

.grid-label {
    font-family: 'GFS Didot', serif;
    font-size: 12px;
    writing-mode: vertical-rl; 
    text-transform: uppercase;
    letter-spacing: 4px;
    display: flex;
    align-items: center;
    color: white;
}

.vertical-line {
    width: 1px;
    height: 100px;
    background: white;
    margin-top: 20px;
}

/* Content Area */
.about-content {
    max-width: 900px;
}

.intro-text {
    font-size: clamp(1.5rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 60px;
    letter-spacing: -1px;
    font-family: var(--inter);
}


.story-columns {
    column-count: 2; 
    column-gap: 60px;
    font-family: var(--inter);
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    text-align: justify;
}

.story-columns p {
    margin-bottom: 20px;
}

/* MOBILE  */
@media (max-width: 1024px) {
    .about-grid {
        grid-template-columns: 1fr;
    }
    
    .grid-label {
        writing-mode: horizontal-tb;
        flex-direction: row;
        margin-bottom: 20px;
    }
    
    .vertical-line {
        width: 50px;
        height: 1px;
        margin: 0 0 0 20px;
    }

    .story-columns {
        column-count: 1; 
    }
</style>
